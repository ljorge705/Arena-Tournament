	<string id="st_arena_s_round_5_reward">
		<text>11,000 RU + Армейская аптечка + Патроны</text>
	</string>
	<string id="st_arena_s_round_6_name">
		<text>Раунд 6: Легкая разведка наемников</text>
	</string>
