-- Complete original text, laid out as independent paragraphs.
blocks = {
    {kind="paragraph", text="This is not simply about making code public."},
    {kind="paragraph", text="It means allowing ideas to keep living, evolving, and becoming something different from what they were at the beginning."},
    {kind="paragraph", text="Code should not be a cage."},
    {kind="paragraph", text="Knowledge should not depend on someone else's permission."},
    {kind="paragraph", text="And above all, a developer should be free."},
    {kind="paragraph", text="Free to study."},
    {kind="paragraph", text="Free to modify."},
    {kind="paragraph", text="Free to criticize."},
    {kind="paragraph", text="Free to improve."},
    {kind="paragraph", text="Free to take a completely different path."},
    {kind="heading", text="Developers Are Free"},
    {kind="paragraph", text="A developer should not need someone's approval to have an idea."},
    {kind="paragraph", text="They should not be afraid to express a different technical opinion."},
    {kind="paragraph", text="They should not feel forced to follow a specific vision simply because someone else got there first."},
    {kind="paragraph", text="Technology has always grown through discussion and comparison."},
    {kind="paragraph", text="Through people who questioned what already existed."},
    {kind="paragraph", text="Through people who tried something new even when others thought there was no point in doing so."},
    {kind="paragraph", text="Freedom of thought creates ideas."},
    {kind="paragraph", text="Freedom of speech creates discussion."},
    {kind="paragraph", text="Discussion creates progress."},
    {kind="paragraph", text="And without freedom, a community slowly stops being a community."},
    {kind="heading", text="No One Owns Ideas"},
    {kind="paragraph", text="A project can have an author."},
    {kind="paragraph", text="Code can have a history."},
    {kind="paragraph", text="But once an idea is shared, it can become the starting point for hundreds of other ideas."},
    {kind="paragraph", text="Someone can read a function and rewrite it better."},
    {kind="paragraph", text="Someone can find a mistake that nobody noticed before."},
    {kind="paragraph", text="Someone can use part of a project to build something we cannot even imagine today."},
    {kind="paragraph", text="That is the value of open source."},
    {kind="paragraph", text="Not controlling what others will do."},
    {kind="paragraph", text="Giving them the freedom to do it."},
    {kind="heading", text="Creativity Always Wins"},
    {kind="paragraph", text="You can restrict a repository."},
    {kind="paragraph", text="You can shut down a project."},
    {kind="paragraph", text="You can tell someone that a certain idea should not be developed."},
    {kind="paragraph", text="But you cannot stop people from thinking."},
    {kind="paragraph", text="Creativity always finds a way."},
    {kind="paragraph", text="Every important project exists because, at some point, someone decided to ignore conventional thinking and try something different."},
    {kind="paragraph", text="Developers must have the freedom to experiment."},
    {kind="paragraph", text="To fail."},
    {kind="paragraph", text="To start again."},
    {kind="paragraph", text="To create forks."},
    {kind="paragraph", text="To rewrite parts of the code."},
    {kind="paragraph", text="To build something completely new."},
    {kind="paragraph", text="No community should ever be afraid of new ideas."},
    {kind="heading", text="Build. Break. Learn. Improve."},
    {kind="paragraph", text="This repository exists so the code can be studied."},
    {kind="paragraph", text="Read it."},
    {kind="paragraph", text="Analyze it."},
    {kind="paragraph", text="Modify it."},
    {kind="paragraph", text="Rewrite it."},
    {kind="paragraph", text="Find what does not work."},
    {kind="paragraph", text="Improve what can be improved."},
    {kind="paragraph", text="And if you think you can build something completely different, do it."},
    {kind="paragraph", text="Do not wait for someone's permission to be creative."},
    {kind="paragraph", text="Knowledge grows when it is shared."},
    {kind="paragraph", text="It dies when it is kept only to be controlled."},
    {kind="heading", text="Freedom of Speech, Freedom to Develop"},
    {kind="paragraph", text="Being free also means being free to disagree."},
    {kind="paragraph", text="A healthy community is not made of people who all think the same way."},
    {kind="paragraph", text="It is made of people who can discuss, criticize, and propose alternatives while maintaining mutual respect."},
    {kind="paragraph", text="No name should be more important than ideas."},
    {kind="paragraph", text="No team should be more important than the community."},
    {kind="paragraph", text="No opinion should be considered untouchable."},
    {kind="paragraph", text="Code can be discussed."},
    {kind="paragraph", text="Decisions can be criticized."},
    {kind="paragraph", text="Ideas can be replaced by better ideas."},
    {kind="paragraph", text="That is how progress happens."},
    {kind="heading", text="A New Chapter"},
    {kind="paragraph", text="Making YOUR CODE open source does not mean ending a story."},
    {kind="paragraph", text="It means stopping the attempt to decide where that story must end."},
    {kind="paragraph", text="From this moment on, the code can be studied, modified, and reinterpreted by anyone who has something to create."},
    {kind="paragraph", text="Maybe someone will make only a small change."},
    {kind="paragraph", text="Maybe someone will create a fork."},
    {kind="paragraph", text="Maybe someone will take a concept found here and build something completely different from it."},
    {kind="paragraph", text="And that is exactly the point."},
    {kind="paragraph", text="Developers are free."},
    {kind="paragraph", text="Ideas must be able to move."},
    {kind="paragraph", text="Knowledge must be able to be shared."},
    {kind="paragraph", text="Creativity should never have to ask for permission."},
    {kind="paragraph", text="Think freely."},
    {kind="paragraph", text="Speak freely."},
    {kind="paragraph", text="Code freely."},
    {kind="paragraph", text="Create without permission."},
}
