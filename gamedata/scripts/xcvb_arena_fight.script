-- Tournament & Spectator Arena Fight Controller
local squad_team_1_id
local squad_team_2_id
tournament_enemy_squad_id = nil
current_tournament_category = nil
current_tournament_round_id = nil
local current_tournament_is_practice = false
local tourn_ending = false
local tournament_fight_closed = false
local spec_fight_ending = false
local spectator_fight_closed = false
local next_spectator_hint = 0
local battle_royale_squad_ids = {}
local battle_royale_team_faction = {}
local battle_royale_ending = false
local battle_royale_closed = false
local battle_royale_bet_team = 0
local battle_royale_reward = 0
local battle_royale_submode = "factions"
local next_br_hint = 0
local next_br_status = 0
local battle_royale_announced_eliminations = {}
local battle_royale_last_status = ""
local battle_royale_initialized_npcs = {}
local is_endless_mode = false
local endless_wave = 1
local endless_reward = 0
local endless_enemy_type = "stalkers"
local endless_enemy_squad_ids = {}
local endless_ending = false
local endless_transitioning = false
local endless_fight_closed = false
local endless_difficulty = "medium"
local trigger_medic_rescue
local is_medic_rescuing = false
local last_selected_nvg_sec = "device_torch_nv_1"
local sync_device_timer = 0
local tournament_inventory_stored = false
local tournament_pending_result
local resume_endless_transition = false
local loaded_legacy_practice = false
local callback_epoch = 0
local engine_create_time_event = CreateTimeEvent
local function CreateTimeEvent(event, action, delay, callback)
    local epoch = callback_epoch
    return engine_create_time_event(event, action, delay, function(...)
        if epoch ~= callback_epoch then return true end
        return callback(...)
    end)
end

-- These values are local; other scripts must use accessors rather than reading globals.
function is_endless_active()
    return is_endless_mode and not endless_fight_closed
end

function reset_battle_royale_cache()
    battle_royale_initialized_npcs = {}
    xcvb_arena_utils.reset_battle_royale_relations()
end

local function cancel_player_combat_events()
    local events = {
        {"arena_spawn_loadout_e", "arena_spawn_loadout_a"},
        {"allow_tournament_aggro_e", "allow_tournament_aggro_a"},
        {"arena_torch_verify_e", "arena_torch_verify_a"},
        {"arena_spawn_endless_loadout_e", "arena_spawn_endless_loadout_a"},
        {"arena_spawn_endless_squad_e", "arena_spawn_endless_squad_a"},
        {"allow_endless_aggro_e", "allow_endless_aggro_a"},
        {"arena_endless_wave_warn_e", "arena_endless_wave_warn_a"},
        {"arena_endless_corpse_clean_e", "arena_endless_corpse_clean_a"},
        {"arena_endless_next_wave_e", "arena_endless_next_wave_a"},
        {"allow_endless_aggro_wave_e", "allow_endless_aggro_wave_a"},
        {"arena_endless_torch_verify_e", "arena_endless_torch_verify_a"},
    }
    for _, event in ipairs(events) do RemoveTimeEvent(event[1], event[2]) end
    if xcvb_arena_utils and xcvb_arena_utils.cancel_all_arena_events then
        pcall(xcvb_arena_utils.cancel_all_arena_events)
    end
end

local function return_actor_to_bar()
    if db.actor then
        local pos, lvid, gvid = xcvb_arena_utils.get_actor_bar_safe_pos()
        db.actor:set_actor_position(pos, lvid, gvid)
    end
    if game.only_allow_movekeys then pcall(game.only_allow_movekeys, false) end
    pcall(level.enable_input)
    pcall(level.show_indicators)
end

local function schedule_auto_open_arena_gui(delay)
    local cfg = xcvb_arena_mcm and xcvb_arena_mcm.get_config("auto_reopen_gui")
    if cfg ~= true and cfg ~= 1 and cfg ~= "true" then
        return
    end
    local d = delay or 1.2
    local uid = tostring(math.random(100000))
    CreateTimeEvent("xcvb_auto_open_gui_e", "open_gui_a_" .. uid, d, function()
        if db.actor and db.actor:alive() and xcvb_arena_gui and xcvb_arena_gui.open_gui then
            xcvb_arena_gui.open_gui()
        end
        return true
    end)
end

function sync_night_mode_device_from_actor()
    if not db.actor then return end
    if not (xcvb_arena_main and xcvb_arena_main.night_mode_active) then return end

    local slot10 = db.actor:item_in_slot(10)
    local slot10_sec = slot10 and slot10:section()

    if slot10_sec and string.find(slot10_sec, "^device_torch_nv_") then
        last_selected_nvg_sec = slot10_sec
    elseif xcvb_arena_main.night_mode_device and string.find(xcvb_arena_main.night_mode_device, "^device_torch_nv_") then
        last_selected_nvg_sec = xcvb_arena_main.night_mode_device
    end

    local torch_on = xcvb_arena_utils and xcvb_arena_utils.is_actor_flashlight_active and xcvb_arena_utils.is_actor_flashlight_active()
    local nvg_on = xcvb_arena_utils and xcvb_arena_utils.is_actor_nvg_active and xcvb_arena_utils.is_actor_nvg_active()

    if torch_on and not nvg_on then
        xcvb_arena_main.night_mode_device = "device_torch_dummy"
    elseif nvg_on and not torch_on then
        xcvb_arena_main.night_mode_device = (slot10_sec and string.find(slot10_sec, "^device_torch_nv_") and slot10_sec) or last_selected_nvg_sec or "device_torch_nv_1"
    elseif slot10_sec then
        if slot10_sec == "device_torch_dummy" and not nvg_on then
            xcvb_arena_main.night_mode_device = "device_torch_dummy"
        elseif string.find(slot10_sec, "^device_torch_nv_") and not torch_on then
            xcvb_arena_main.night_mode_device = slot10_sec
        end
    end
end

function is_battle_royale_npc_initialized(npc_id)
    return battle_royale_initialized_npcs[npc_id] == true
end

function mark_battle_royale_npc_initialized(npc_id)
    if npc_id then
        battle_royale_initialized_npcs[npc_id] = true
    end
end
local HI = has_alife_info
local gt = game.translate_string

local function is_spectator_mode()
    return HI("xcvb_arena_started") or HI("xcvb_battle_royale_started")
end

local function is_endless_enemy_squad(squad_id)
    if not endless_enemy_squad_ids then return false end
    for _, s_id in ipairs(endless_enemy_squad_ids) do
        if s_id == squad_id then
            return true
        end
    end
    return false
end

local function get_endless_total_enemies_alive(dying_squad_id)
    local total = 0
    if not endless_enemy_squad_ids then return 0 end
    for _, s_id in ipairs(endless_enemy_squad_ids) do
        local squad = alife_object(s_id)
        if squad then
            -- Endless creates one combatant per squad. The death callback may run
            -- before npc_count() is updated; exclude that squad explicitly.
            if s_id ~= dying_squad_id then
                for member in squad:squad_members() do
                    local npc = level.object_by_id(member.id)
                    if not npc or npc:alive() then total = total + 1 end
                end
            end
        end
    end
    return total
end

function heal_actor_completely()
    if not db.actor then return end
    pcall(function()
        db.actor.health = 1.0
        -- This setter heals wounds by a fraction; zero leaves them unchanged.
        db.actor.bleeding = 1.0
        db.actor.radiation = 0
        db.actor.psy_health = 1.0
        db.actor.power = 1.0
    end)
    if zzz_player_injuries and zzz_player_injuries.health and zzz_player_injuries.maxhp then
        pcall(function()
            local bhs_parts = {"head", "torso", "rightarm", "leftarm", "rightleg", "leftleg"}
            local sv = (utils_obj and utils_obj.save_var) or _G.save_var
            for _, part in ipairs(bhs_parts) do
                local max_v = (zzz_player_injuries.maxhp and zzz_player_injuries.maxhp[part]) or ((part == "head" or part == "torso") and 11 or 5)
                zzz_player_injuries.health[part] = max_v
                if zzz_player_injuries.timedhp then
                    zzz_player_injuries.timedhp[part] = 0
                end
                if sv and db.actor then
                    pcall(sv, db.actor, "health." .. part, max_v)
                    pcall(sv, db.actor, "timedhp." .. part, 0)
                end
            end
            if zzz_player_injuries.preview and zzz_player_injuries.preview.health then
                for _, part in ipairs(bhs_parts) do
                    local max_v = (zzz_player_injuries.maxhp and zzz_player_injuries.maxhp[part]) or ((part == "head" or part == "torso") and 11 or 5)
                    zzz_player_injuries.preview.health[part] = max_v
                    if zzz_player_injuries.preview.bonus then
                        zzz_player_injuries.preview.bonus[part] = 0
                    end
                end
            end
            zzz_player_injuries.myhealth = 1.0
        end)
    end
end

--------------------------------------------------------------------------------
-- TOURNAMENT COMBAT MODE (Player in the Arena)
--------------------------------------------------------------------------------
function start_tournament_fight(category, round_id, loadout_class, loadout_tier, loadout_ammo, forced_weapon_sec, forced_ammo_sec, scope_mode, forced_scope_sec, forced_mag_sec, forced_mag_count, forced_ammo_count)
    local round_data = xcvb_arena_main.get_round_data(category or "stalker", round_id)
    if not round_data or not db.actor then return false end
    local random_eq = xcvb_arena_mcm.get_config("random_equipment")
    if random_eq ~= false and not xcvb_arena_utils.store_actor_inventory() then return false end
    tournament_inventory_stored = random_eq ~= false
    callback_epoch = callback_epoch + 1
    tournament_pending_result = nil
    cancel_player_combat_events()
    tourn_ending = false
    endless_ending = false
    tournament_fight_closed = false
    endless_fight_closed = false
    is_endless_mode = false
    endless_transitioning = false
    spec_fight_ending = false
    spectator_fight_closed = false
    battle_royale_ending = false
    battle_royale_closed = false
    xcvb_arena_main.selected_modifier = "none"
    xcvb_arena_main.selected_modifier_team1 = "none"
    xcvb_arena_main.selected_modifier_team2 = "none"
    pcall(disable_info, "xcvb_endless_started")
    pcall(disable_info, "xcvb_arena_started")
    pcall(disable_info, "xcvb_battle_royale_started")
    
    if game.only_allow_movekeys then pcall(game.only_allow_movekeys, false) end
    pcall(level.enable_input)
    pcall(level.show_indicators)
    if xcvb_arena_main.night_mode_active then
        pcall(xcvb_arena_utils.enter_arena_night_mode)
        CreateTimeEvent("arena_torch_verify_e", "arena_torch_verify_a", 1.2, function()
            pcall(xcvb_arena_utils.ensure_actor_torch_active)
            return true
        end)
    end
    current_tournament_category = category or "stalker"
    current_tournament_round_id = round_id

    local is_comp = xcvb_arena_main.is_round_completed(current_tournament_category, round_id)
    local remain_sec = 0
    if is_comp then
        remain_sec = xcvb_arena_main.get_round_cooldown_remaining(current_tournament_category, round_id)
    end
    current_tournament_is_practice = (remain_sec > 0) or (is_comp and remain_sec < 0) or (xcvb_arena_main.practice_mode_active == true)

    tourn_saved_actor_reputation = db.actor:character_reputation()

    local ac_pos, ac_lvid, ac_gvid = xcvb_arena_utils.get_actor_tournament_pos()
    db.actor:set_actor_position(ac_pos, ac_lvid, ac_gvid)
    db.actor:set_actor_direction(0) 

    if random_eq ~= false then
        local tier = round_data.tier or math.ceil(round_id / 3)
        CreateTimeEvent("arena_spawn_loadout_e", "arena_spawn_loadout_a", 0.3, function()
            if tournament_fight_closed then return true end
            xcvb_arena_utils.equip_tournament_random_loadout(tier, loadout_class, loadout_tier, loadout_ammo, forced_weapon_sec, forced_ammo_sec, scope_mode, forced_scope_sec, forced_mag_sec, forced_mag_count, forced_ammo_count)
            return true
        end)
    end

    local enemy_squad = xcvb_arena_utils.spawn_tournament_squad(round_data)
    if not enemy_squad then
        printe("! xcvb arena: Failed to spawn tournament squad for %s round %s", current_tournament_category, round_id)
        cancel_player_combat_events()
        tournament_fight_closed = true
        pcall(xcvb_arena_utils.exit_arena_night_mode)
        return_actor_to_bar()
        if random_eq ~= false then
            xcvb_arena_utils.restore_actor_inventory()
        end
        tournament_inventory_stored = false
        tourn_saved_actor_reputation = nil
        current_tournament_category = nil
        current_tournament_round_id = nil
        return false
    end
    tournament_enemy_squad_id = enemy_squad.id

    CreateTimeEvent("allow_tournament_aggro_e", "allow_tournament_aggro_a", 1, function()
        if tournament_fight_closed then return true end
        give_info("xcvb_tournament_started")
        xcvb_arena_utils.setup_tournament_squad_aggro(tournament_enemy_squad_id)
        news_manager.send_tip(db.actor, gt("st_arena_fight_started"), 0, nil, 7000)
        return true
    end)
    return true
end

function on_tournament_victory(round_id)
    if tournament_fight_closed or tourn_ending or endless_ending then return end
    tourn_ending = true
    tournament_pending_result = true
    heal_actor_completely()
    news_manager.send_tip(db.actor, gt("st_arena_fight_won"), 0, nil, 8000)
    xcvb_arena_utils.arena_fade_in_out(2)
    
    local uid = tostring(math.random(100000))
    CreateTimeEvent("xcvb_arena_end_tourn_e", "tourn_a_" .. uid, 3.5, function()
        end_tournament_fight(true)
        return true
    end)
end

function end_tournament_fight(is_victory)
    if tournament_fight_closed then return end
    tournament_fight_closed = true
    callback_epoch = callback_epoch + 1
    tournament_pending_result = nil
    cancel_player_combat_events()
    tourn_ending = false
    endless_ending = false
    pcall(xcvb_arena_utils.exit_arena_night_mode)

    if db.actor then
        pcall(function() db.actor:activate_slot(0) end)
        for s = 1, 15 do
            local itm = db.actor:item_in_slot(s)
            if itm and db.actor.move_to_ruck then
                pcall(function() db.actor:move_to_ruck(itm) end)
            end
        end
        local bar_pos, bar_lvid, bar_gvid = xcvb_arena_utils.get_actor_bar_safe_pos()
        db.actor:set_actor_position(bar_pos, bar_lvid, bar_gvid)
        pcall(level.enable_input)
    end

    if game.only_allow_movekeys then pcall(game.only_allow_movekeys, false) end
    pcall(level.enable_input)
    pcall(level.show_indicators)

    if tournament_enemy_squad_id then
        xcvb_arena_utils.clean_tournament_squad(tournament_enemy_squad_id)
        tournament_enemy_squad_id = nil
    end
    xcvb_arena_utils.clean_arena_corpses()

    if tournament_inventory_stored then
        xcvb_arena_utils.restore_actor_inventory()
    end
    tournament_inventory_stored = false

    heal_actor_completely()
    CreateTimeEvent("xcvb_arena_heal_tourn_e", "xcvb_arena_heal_tourn_a", 0.5, function()
        heal_actor_completely()
        return true
    end)

    local cat = current_tournament_category or "stalker"
    local actor_alive = db.actor and db.actor:alive()
    is_victory = is_victory and actor_alive
    if is_victory and current_tournament_round_id then
        xcvb_arena_main.tournament_wins = xcvb_arena_main.tournament_wins + 1

        if current_tournament_is_practice then
            local remain_sec, remain_str = xcvb_arena_main.get_round_cooldown_remaining(cat, current_tournament_round_id)
            local tip_msg
            if remain_sec > 0 and remain_str and remain_str ~= "" then
                tip_msg = string.format(gt("st_arena_fight_won_practice"), remain_str)
            else
                tip_msg = gt("st_arena_fight_won_practice_simple")
            end
            news_manager.send_tip(db.actor, tip_msg, 0, nil, 10000)
        else
            local time_t = xcvb_arena_main.ctime_to_table(game.get_game_time())
            if cat == "mutant" then
                xcvb_arena_main.tournament_mutant_completed[current_tournament_round_id] = true
                xcvb_arena_main.tournament_mutant_completed_time[current_tournament_round_id] = time_t
                if current_tournament_round_id >= xcvb_arena_main.tournament_mutant_unlocked_round and current_tournament_round_id < 18 then
                    xcvb_arena_main.tournament_mutant_unlocked_round = current_tournament_round_id + 1
                    if current_tournament_round_id % 3 == 0 then
                        local new_tier = math.ceil((current_tournament_round_id + 1) / 3)
                        if xcvb_arena_main.tournament_mutant_tiers_t[new_tier] then
                            local tier_name = gt(xcvb_arena_main.tournament_mutant_tiers_t[new_tier].name)
                            local tier_msg = string.format(gt("st_arena_tier_unlocked"), tier_name)
                            news_manager.send_tip(db.actor, tier_msg, 0, nil, 12000)
                        end
                    end
                end
            else
                xcvb_arena_main.tournament_stalker_completed[current_tournament_round_id] = true
                xcvb_arena_main.tournament_stalker_completed_time[current_tournament_round_id] = time_t
                if current_tournament_round_id >= xcvb_arena_main.tournament_stalker_unlocked_round and current_tournament_round_id < 18 then
                    xcvb_arena_main.tournament_stalker_unlocked_round = current_tournament_round_id + 1
                    if current_tournament_round_id % 3 == 0 then
                        local new_tier = math.ceil((current_tournament_round_id + 1) / 3)
                        if xcvb_arena_main.tournament_stalker_tiers_t[new_tier] then
                            local tier_name = gt(xcvb_arena_main.tournament_stalker_tiers_t[new_tier].name)
                            local tier_msg = string.format(gt("st_arena_tier_unlocked"), tier_name)
                            news_manager.send_tip(db.actor, tier_msg, 0, nil, 12000)
                        end
                    end
                end
            end
            if current_tournament_round_id == 15 then
                news_manager.send_tip(db.actor, gt("st_arena_champion_crowned"), 0, nil, 15000)
            end
            local round_data = xcvb_arena_main.get_round_data(cat, current_tournament_round_id)
            xcvb_arena_utils.give_tournament_rewards(round_data)
        end
    else
        xcvb_arena_main.tournament_losses = xcvb_arena_main.tournament_losses + 1
    end
    current_tournament_is_practice = false

    if tourn_saved_actor_reputation and db.actor then
        local cur_rep = db.actor:character_reputation()
        if cur_rep < tourn_saved_actor_reputation then
            db.actor:change_character_reputation(tourn_saved_actor_reputation - cur_rep)
        end
        tourn_saved_actor_reputation = nil
    end

    disable_info("xcvb_tournament_started")
    tourn_saved_actor_reputation = nil
    tournament_enemy_squad_id = nil
    current_tournament_category = nil
    current_tournament_round_id = nil
    if not is_medic_rescuing then
        schedule_auto_open_arena_gui(1.2)
    end
    return true
end

--------------------------------------------------------------------------------
-- SPECTATOR MODE (Original Balcony Betting)
--------------------------------------------------------------------------------
function start_arena_fight(bout_idx)
    spec_fight_ending = false
    spectator_fight_closed = false
    local b_idx = bout_idx or xcvb_arena_main.selected_spec_bout or 1
    local main_t = xcvb_arena_main.arena_main_t[b_idx]
    if not main_t or not main_t.team1 or #main_t.team1 == 0 or not main_t.team2 or #main_t.team2 == 0 then return end
    
    if xcvb_arena_main.night_mode_active then
        pcall(xcvb_arena_utils.enter_arena_night_mode)
    end
    local ac_pos, ac_lvid, ac_gvid = xcvb_arena_utils.get_actor_arena_pos()
    db.actor:set_actor_position(ac_pos, ac_lvid, ac_gvid)
    local arena_center = vector():set(152.0, -20.0, 105.0)
    local look_dir = vector():sub(arena_center, ac_pos)
    db.actor:set_actor_direction(-look_dir:getH())
    CreateTimeEvent("arena_spec_cam_e", "arena_spec_cam_a", 0.1, function()
        if db.actor then
            local center = vector():set(152.0, -20.0, 105.0)
            local ldir = vector():sub(center, ac_pos)
            db.actor:set_actor_direction(-ldir:getH())
        end
        return true
    end)
    if db.actor then pcall(function() db.actor:activate_slot(0) end) end
    if game.only_allow_movekeys then pcall(game.only_allow_movekeys, true) end

    local type1 = string.find(main_t.team1[1], "sim_default") and "stalker" or "mutant"
    local sec1 = "arena_" .. type1 .. "_team_1"
    local pos1, lvid1, gvid1 = xcvb_arena_utils.get_team_pos(1)
    local squad1 = alife_create(sec1, pos1, lvid1, gvid1)
    if not squad1 then
        printe("! xcvb arena: Failed to spawn spectator team 1")
        return
    end
    squad_team_1_id = squad1.id

    local type2 = string.find(main_t.team2[1], "sim_default") and "stalker" or "mutant"
    local sec2 = "arena_" .. type2 .. "_team_2"
    local pos2, lvid2, gvid2 = xcvb_arena_utils.get_team_pos(2)
    local squad2 = alife_create(sec2, pos2, lvid2, gvid2)
    if not squad2 then
        printe("! xcvb arena: Failed to spawn spectator team 2")
        pcall(alife_release_id, squad_team_1_id)
        squad_team_1_id = nil
        return
    end
    squad_team_2_id = squad2.id

    squad1.scripted_target = squad2.id
    squad1.assigned_target_id = squad2.id
    squad1.rush_to_target = true

    squad2.scripted_target = squad1.id
    squad2.assigned_target_id = squad1.id
    squad2.rush_to_target = true

    local mult1 = main_t.mult1 or 1
    for m_idx = 1, mult1 do
        for i, sec in ipairs(main_t.team1) do
            local offset_pos = vector():set(pos1.x + math.random(-5, 5), pos1.y, pos1.z + math.random(-3, 3))
            squad1:add_squad_member(sec, offset_pos, lvid1, gvid1)
        end
    end
    squad1:set_squad_relation()
    squad1:refresh()
    for m in squad1:squad_members() do
        xcvb_arena_utils.arena_spawned_combatant_ids[m.id] = true
    end

    local mult2 = main_t.mult2 or 1
    for m_idx = 1, mult2 do
        for i, sec in ipairs(main_t.team2) do
            local offset_pos = vector():set(pos2.x + math.random(-5, 5), pos2.y, pos2.z + math.random(-3, 3))
            squad2:add_squad_member(sec, offset_pos, lvid2, gvid2)
        end
    end
    squad2:set_squad_relation()
    squad2:refresh()
    for m in squad2:squad_members() do
        xcvb_arena_utils.arena_spawned_combatant_ids[m.id] = true
    end

    next_spec_check = time_global() + 6000
    CreateTimeEvent("allow_relation_update_e", "allow_relation_update_a", 1, function()
        give_info("xcvb_arena_started")
        setup_teams()
        return true
    end)
    CreateTimeEvent("allow_spec_press_f_tip_e", "allow_spec_press_f_tip_a", 3.5, function()
        news_manager.send_tip(db.actor, gt("st_arena_spectator_press_f"), 0, nil, 15000)
        return true
    end)
end

function setup_teams()
    if not HI("xcvb_arena_started") then return end

    xcvb_arena_utils.set_out_restrictors(squad_team_1_id, squad_team_2_id)
    xcvb_arena_utils.set_teams_relation(squad_team_1_id, squad_team_2_id)

    local sq1 = squad_team_1_id and alife_object(squad_team_1_id)
    local sq2 = squad_team_2_id and alife_object(squad_team_2_id)
    if not (sq1 and sq2) then return end

    sq1.scripted_target = squad_team_2_id
    sq1.assigned_target_id = squad_team_2_id

    sq2.scripted_target = squad_team_1_id
    sq2.assigned_target_id = squad_team_1_id

    local sq1_is_stalker = string.find(sq1:section_name(), "stalker")
    local sq2_is_stalker = string.find(sq2:section_name(), "stalker")
    local is_stalker_vs_stalker = sq1_is_stalker and sq2_is_stalker
    local rush = not is_stalker_vs_stalker
    sq1.rush_to_target = rush
    sq2.rush_to_target = rush

    local function activate_npc(npc, dir_z, team_idx)
        if not (npc and npc:alive()) then return end
        pcall(function() npc:change_team(team_idx, team_idx, team_idx) end)
        pcall(function() npc:set_desired_direction(vector():set(0, 0, dir_z)) end)
        if IsMonster and IsMonster(npc) then
            pcall(function() npc:berserk() end)
            pcall(function() npc:set_custom_panic_threshold(0) end)
            if npc.skip_transfer_enemy then
                pcall(function() npc:skip_transfer_enemy(false) end)
            end
            if db.actor then
                pcall(function() npc:set_relation(game_object.neutral, db.actor) end)
                pcall(function() npc:force_set_goodwill(5000, db.actor) end)
            end
        elseif IsStalker and IsStalker(npc) then
            pcall(function() npc:set_mental_state(anim.danger) end)
            if npc.register_in_combat then
                pcall(function() npc:register_in_combat() end)
            end
            pcall(function() npc:set_custom_panic_threshold(0.05) end)
        end
        xcvb_arena_utils.apply_combat_modifier_inventory(npc, team_idx)
    end

    local all_loaded = true
    for m1 in sq1:squad_members() do
        local n1 = level.object_by_id(m1.id)
        if n1 then
            activate_npc(n1, -1, 1)
        else
            all_loaded = false
        end
    end
    for m2 in sq2:squad_members() do
        local n2 = level.object_by_id(m2.id)
        if n2 then
            activate_npc(n2, 1, 2)
        else
            all_loaded = false
        end
    end

    xcvb_arena_utils.force_mutant_aggro(squad_team_1_id, squad_team_2_id, true)
    xcvb_arena_utils.force_stalker_aggro(squad_team_1_id, squad_team_2_id, true)

    if not all_loaded then
        CreateTimeEvent("setup_teams_retry_e", "setup_teams_retry_a", 1, function()
            if HI("xcvb_arena_started") then
                setup_teams()
            end
            return true
        end)
    end
end

function end_arena_fight(winner_team)
    if spectator_fight_closed then return end
    spectator_fight_closed = true
    spec_fight_ending = false
    pcall(xcvb_arena_utils.exit_arena_night_mode)

    local bar_pos, bar_lvid, bar_gvid = xcvb_arena_utils.get_actor_bar_safe_pos()
    db.actor:set_actor_position(bar_pos, bar_lvid, bar_gvid)
    if game.only_allow_movekeys then pcall(game.only_allow_movekeys, false) end
    pcall(level.enable_input)
    pcall(level.show_indicators)
    
    local bet_team = xcvb_arena_main.team_bet
    local reward = xcvb_arena_main.cur_reward
    
    if bet_team == winner_team and reward > 0 then
        local str = string.format(gt("st_arena_your_reward"), reward)
        news_manager.send_tip(db.actor, str, 0, nil, 15000)
        db.actor:give_money(reward)
    end
    
    local function arena_safe_release_id(id)
        pcall(function()
            if safe_release_manager and safe_release_manager.release then
                safe_release_manager.release({id = id})
            else
                alife_release_id(id)
            end
        end)
    end
    
    local squad1 = alife_object(squad_team_1_id)
    if squad1 and string.find(squad1:section_name(), "arena_") then
        pcall(function()
            local member_ids = {}
            for member in squad1:squad_members() do
                member_ids[#member_ids + 1] = member.id
            end
            for _, member_id in ipairs(member_ids) do
                arena_safe_release_id(member_id)
            end
            arena_safe_release_id(squad_team_1_id)
        end)
    end
    
    local squad2 = alife_object(squad_team_2_id)
    if squad2 and string.find(squad2:section_name(), "arena_") then
        pcall(function()
            local member_ids = {}
            for member in squad2:squad_members() do
                member_ids[#member_ids + 1] = member.id
            end
            for _, member_id in ipairs(member_ids) do
                arena_safe_release_id(member_id)
            end
            arena_safe_release_id(squad_team_2_id)
        end)
    end
    
    xcvb_arena_utils.clean_arena_corpses()
    disable_info("xcvb_arena_started")
    xcvb_arena_main.cur_reward = 0
    xcvb_arena_main.team_bet = 0
    squad_team_1_id = nil
    squad_team_2_id = nil
    
    xcvb_arena_main.generate_spectator_fights()
    schedule_auto_open_arena_gui(1.2)
    return true
end

--------------------------------------------------------------------------------
-- BATALLA CAMPAL MULTIBANDO (BETA TESTING)
--------------------------------------------------------------------------------
function start_battle_royale_fight(br_data)
    if not br_data then return end
    if br_data.submode ~= "mutants" then
        local factions = {}
        for i = 1, (br_data.num_teams or 0) do
            local team = br_data.teams and br_data.teams[i]
            if team and team.faction then
                factions[#factions + 1] = team.faction
            end
        end
        if not xcvb_arena_utils.are_battle_royale_factions_hostile(factions) then
            news_manager.send_tip(db.actor, gt("st_arena_bc_invalid_factions"), 0, nil, 8000)
            return
        end
    end
    battle_royale_ending = false
    reset_battle_royale_cache()
    battle_royale_closed = false
    battle_royale_squad_ids = {}
    battle_royale_team_faction = {}
    battle_royale_submode = br_data.submode or "factions"
    next_br_hint = 0
    battle_royale_announced_eliminations = {}
    battle_royale_last_status = ""
    next_br_status = 0

    local num_teams = br_data.num_teams or 4
    battle_royale_bet_team = br_data.bet_team or 0
    battle_royale_reward = br_data.reward or 0

    if xcvb_arena_main.night_mode_active then
        pcall(xcvb_arena_utils.enter_arena_night_mode)
    end
    local ac_pos, ac_lvid, ac_gvid = xcvb_arena_utils.get_actor_arena_pos()
    db.actor:set_actor_position(ac_pos, ac_lvid, ac_gvid)
    local arena_center = vector():set(152.0, -20.0, 105.0)
    local look_dir = vector():sub(arena_center, ac_pos)
    db.actor:set_actor_direction(-look_dir:getH())
    CreateTimeEvent("arena_br_cam_e", "arena_br_cam_a", 0.1, function()
        if db.actor then
            local center = vector():set(152.0, -20.0, 105.0)
            local ldir = vector():sub(center, ac_pos)
            db.actor:set_actor_direction(-ldir:getH())
        end
        return true
    end)
    if db.actor then pcall(function() db.actor:activate_slot(0) end) end
    if game.only_allow_movekeys then pcall(game.only_allow_movekeys, true) end

    local is_mutants_mode = (battle_royale_submode == "mutants")

    for i = 1, num_teams do
        local t_info = br_data.teams and br_data.teams[i]
        local fac = (t_info and (t_info.mutant or t_info.faction)) or (is_mutants_mode and "snork" or "stalker")
        battle_royale_team_faction[i] = fac
        local mult = (t_info and t_info.mult) or 1
        if mult < 1 then mult = 1 end

        local is_mutant = is_mutants_mode or (fac == "mutant")
        local sec = is_mutant and ("arena_mutant_team_" .. i) or ("arena_stalker_team_" .. i)
        local pos, lvid, gvid = xcvb_arena_utils.get_battle_royale_pos(i, num_teams)

        local squad = alife_create(sec, pos, lvid, gvid)
        if squad then
            battle_royale_squad_ids[i] = squad.id

            local member_secs = t_info and t_info.members
            if not member_secs or #member_secs == 0 then
                if is_mutants_mode then
                    member_secs, _ = xcvb_arena_utils.get_squad_for_mutant(fac)
                else
                    member_secs, _ = xcvb_arena_utils.get_squad_for_faction(fac, 3)
                end
            end

            for m_idx = 1, mult do
                for _, sec_name in ipairs(member_secs) do
                    local offset_pos = vector():set(pos.x + math.random(-4, 4), pos.y, pos.z + math.random(-4, 4))
                    squad:add_squad_member(sec_name, offset_pos, lvid, gvid)
                end
            end

            squad:set_squad_relation()
            squad:refresh()
            for m in squad:squad_members() do
                xcvb_arena_utils.arena_spawned_combatant_ids[m.id] = true
            end
        end
    end

    CreateTimeEvent("allow_br_relation_update_e", "allow_br_relation_update_a", 1, function()
        give_info("xcvb_battle_royale_started")
        xcvb_arena_utils.setup_battle_royale_relations(battle_royale_squad_ids)
        local tip_key = is_mutants_mode and "st_arena_mvm_started_tip" or "st_arena_bc_started_tip"
        local tip_start = string.format(gt(tip_key), tostring(num_teams))
        news_manager.send_tip(db.actor, tip_start, 0, nil, 8000)
        return true
    end)
    CreateTimeEvent("allow_br_press_f_tip_e", "allow_br_press_f_tip_a", 3.5, function()
        news_manager.send_tip(db.actor, gt("st_arena_spectator_press_f"), 0, nil, 15000)
        return true
    end)
end

local function get_battle_royale_team_count(squad, dying_member_id)
    if not squad then return 0 end
    local count = 0
    for member in squad:squad_members() do
        local npc = level.object_by_id(member.id)
        if member.id ~= dying_member_id and (not npc or npc:alive()) then
            count = count + 1
        end
    end
    return count
end

local function get_battle_royale_alive_teams(dying_member_id)
    local alive_teams = {}
    for team_idx, squad_id in pairs(battle_royale_squad_ids) do
        local squad = squad_id and alife_object(squad_id)
        if squad then
            if get_battle_royale_team_count(squad, dying_member_id) > 0 then
                alive_teams[#alive_teams + 1] = team_idx
            end
        end
    end
    table.sort(alive_teams)
    return alive_teams
end

local function get_battle_royale_status()
    local status = {}
    for team_idx, squad_id in pairs(battle_royale_squad_ids) do
        local squad = squad_id and alife_object(squad_id)
        local count = get_battle_royale_team_count(squad)
        if count > 0 then
            local fac_key = battle_royale_team_faction[team_idx] or "stalker"
            local name = (battle_royale_submode == "mutants")
                and xcvb_arena_utils.get_mutant_name(fac_key)
                or xcvb_arena_utils.get_faction_name(fac_key)
            status[#status + 1] = name .. " " .. tostring(count)
        end
    end
    table.sort(status)
    return table.concat(status, ", ")
end

local function announce_battle_royale_elimination(team_idx, alive_count)
    if battle_royale_announced_eliminations[team_idx] then return end
    battle_royale_announced_eliminations[team_idx] = true
    local fac_key = battle_royale_team_faction[team_idx] or "stalker"
    local name = (battle_royale_submode == "mutants")
        and xcvb_arena_utils.get_mutant_name(fac_key)
        or xcvb_arena_utils.get_faction_name(fac_key)
    local msg = string.format(gt("st_arena_bc_team_eliminated"), name, alive_count)
    news_manager.send_tip(db.actor, msg, 0, nil, 7000)
end

function end_battle_royale(winner_team_idx)
    if battle_royale_closed then return end
    battle_royale_closed = true
    battle_royale_ending = false
    pcall(xcvb_arena_utils.exit_arena_night_mode)

    local bar_pos, bar_lvid, bar_gvid = xcvb_arena_utils.get_actor_bar_safe_pos()
    db.actor:set_actor_position(bar_pos, bar_lvid, bar_gvid)
    if game.only_allow_movekeys then pcall(game.only_allow_movekeys, false) end
    pcall(level.enable_input)
    pcall(level.show_indicators)

    local win_idx = tonumber(winner_team_idx) or 0
    if win_idx > 0 and win_idx == battle_royale_bet_team and battle_royale_reward > 0 then
        local rew_key = (battle_royale_submode == "mutants") and "st_arena_mvm_reward_tip" or "st_arena_bc_reward_tip"
        local str = string.format(gt(rew_key), battle_royale_reward)
        news_manager.send_tip(db.actor, str, 0, nil, 15000)
        db.actor:give_money(battle_royale_reward)
    end

    local function arena_safe_release_id(id)
        pcall(function()
            if safe_release_manager and safe_release_manager.release then
                safe_release_manager.release({id = id})
            else
                alife_release_id(id)
            end
        end)
    end

    for _, sq_id in pairs(battle_royale_squad_ids) do
        local squad = alife_object(sq_id)
        if squad and string.find(squad:section_name(), "arena_") then
            pcall(function()
                local member_ids = {}
                for member in squad:squad_members() do
                    member_ids[#member_ids + 1] = member.id
                end
                for _, member_id in ipairs(member_ids) do
                    arena_safe_release_id(member_id)
                end
                arena_safe_release_id(sq_id)
            end)
        end
    end

    xcvb_arena_utils.clean_arena_corpses()
    disable_info("xcvb_battle_royale_started")
    battle_royale_squad_ids = {}
    battle_royale_team_faction = {}
    battle_royale_announced_eliminations = {}
    next_br_status = 0
    battle_royale_last_status = ""
    battle_royale_initialized_npcs = {}
    battle_royale_bet_team = 0
    battle_royale_reward = 0
    schedule_auto_open_arena_gui(1.2)
    return true
end

--------------------------------------------------------------------------------
-- MODO INFINITO (BETA TESTING - Endless Survival Mode)
--------------------------------------------------------------------------------
function get_endless_enemy_squad_ids()
    return endless_enemy_squad_ids
end

function start_endless_fight(enemy_type, start_wave, difficulty, use_3dssg)
    if not db.actor or not xcvb_arena_utils.store_actor_inventory() then return false end
    callback_epoch = callback_epoch + 1
    cancel_player_combat_events()
    tourn_ending = false
    endless_ending = false

    tournament_fight_closed = false
    endless_fight_closed = false
    is_endless_mode = true
    endless_wave = math.max(1, start_wave or 1)
    endless_reward = 0
    endless_enemy_type = enemy_type or "stalkers"
    if endless_enemy_type == "random" then
        endless_enemy_type = "stalkers"
    end
    endless_difficulty = difficulty or (xcvb_arena_main and xcvb_arena_main.endless_difficulty) or "medium"
    if xcvb_arena_main then
        xcvb_arena_main.endless_3dssg = use_3dssg == true
    end
    endless_transitioning = false
    spec_fight_ending = false
    spectator_fight_closed = false
    battle_royale_ending = false
    battle_royale_closed = false

    pcall(disable_info, "xcvb_tournament_started")
    pcall(disable_info, "xcvb_arena_started")
    pcall(disable_info, "xcvb_battle_royale_started")

    if xcvb_arena_main then
        xcvb_arena_main.endless_difficulty = endless_difficulty
        xcvb_arena_main.endless_checkpoint_type = endless_enemy_type
        if endless_wave == 1 or difficulty ~= nil or endless_wave > (xcvb_arena_main.endless_checkpoint_wave or 1) then
            xcvb_arena_main.endless_checkpoint_wave = endless_wave
        end
    end

    if game.only_allow_movekeys then pcall(game.only_allow_movekeys, false) end
    pcall(level.enable_input)
    pcall(level.show_indicators)
    if xcvb_arena_main.night_mode_active then
        pcall(xcvb_arena_utils.enter_arena_night_mode)
        CreateTimeEvent("arena_torch_verify_e", "arena_torch_verify_a", 1.2, function()
            pcall(xcvb_arena_utils.ensure_actor_torch_active)
            return true
        end)
    end

    local ac_pos, ac_lvid, ac_gvid = xcvb_arena_utils.get_actor_tournament_pos()
    db.actor:set_actor_position(ac_pos, ac_lvid, ac_gvid)
    db.actor:set_actor_direction(0)

    CreateTimeEvent("arena_spawn_endless_loadout_e", "arena_spawn_endless_loadout_a", 0.3, function()
        if endless_ending or endless_fight_closed then return true end
        if xcvb_arena_endless and xcvb_arena_endless.equip_endless_loadout then
            xcvb_arena_endless.equip_endless_loadout(endless_wave, endless_difficulty, use_3dssg == true)
        else
            xcvb_arena_utils.equip_endless_random_loadout(endless_wave, endless_difficulty, use_3dssg == true)
        end
        return true
    end)

    give_info("xcvb_endless_started")

    endless_enemy_squad_ids = {}

    local msg_spawn = gt("st_arena_endless_enemies_spawning_3s")
    if not msg_spawn or msg_spawn == "" or msg_spawn == "st_arena_endless_enemies_spawning_3s" then
        msg_spawn = "Enemies will spawn in 3 sec"
    end
    news_manager.send_tip(db.actor, msg_spawn, 0, nil, 3000)

    CreateTimeEvent("arena_spawn_endless_squad_e", "arena_spawn_endless_squad_a", 3.0, function()
        if endless_ending or endless_fight_closed then return true end

        local squads = xcvb_arena_utils.spawn_endless_squad(endless_wave, endless_enemy_type, endless_difficulty)
        endless_enemy_squad_ids = {}
        if squads then
            if squads.id then
                table.insert(endless_enemy_squad_ids, squads.id)
            else
                for _, sq in ipairs(squads) do
                    if sq and sq.id then
                        table.insert(endless_enemy_squad_ids, sq.id)
                    end
                end
            end
        end

        if #endless_enemy_squad_ids == 0 then
            printe("! xcvb arena: Failed to spawn endless squad for wave %s", endless_wave)
            end_endless_fight(false, false)
            return true
        end

        local enemy_count = #endless_enemy_squad_ids
        local diff_str = gt("st_arena_endless_diff_" .. (endless_difficulty or "medium"))
        local tip = string.format(gt("st_arena_endless_wave_started"), endless_wave, enemy_count) .. " (" .. diff_str .. ")"
        news_manager.send_tip(db.actor, tip, 0, nil, 8000)

        local attempts = 0
        CreateTimeEvent("allow_endless_aggro_e", "allow_endless_aggro_a", 0.8, function()
            if endless_ending or endless_fight_closed then return true end
            attempts = attempts + 1
            local done = xcvb_arena_utils.setup_endless_squads_aggro(endless_enemy_squad_ids)
            if done or attempts >= 6 then
                if xcvb_arena_companions and xcvb_arena_companions.reassign_companion_aggro then
                    xcvb_arena_companions.reassign_companion_aggro(endless_enemy_squad_ids)
                end
                return true
            end
            ResetTimeEvent("allow_endless_aggro_e", "allow_endless_aggro_a", 0.4)
            return false
        end)
        return true
    end)
end

function advance_endless_wave(resume_pending)
    if endless_transitioning or endless_fight_closed or endless_ending or is_medic_rescuing then return end
    pcall(sync_night_mode_device_from_actor)
    endless_transitioning = true
    if db.actor then
        pcall(function() db.actor:activate_slot(0) end)
    end

    if not resume_pending then
        local mult = (xcvb_arena_mcm and xcvb_arena_mcm.get_config("endless_reward_mult")) or 1.0
        local wave_gain = 0
        if endless_difficulty == "easy" then
            wave_gain = math.floor(400 + (endless_wave * 400))
        elseif endless_difficulty == "hard" then
            wave_gain = math.floor(1000 + (endless_wave * 1000))
        else
            wave_gain = math.floor(700 + (endless_wave * 700))
        end
        wave_gain = math.floor(wave_gain * mult)
        endless_reward = endless_reward + wave_gain

        if endless_wave > (xcvb_arena_main.best_endless_wave or 0) then
            xcvb_arena_main.best_endless_wave = endless_wave
        end

        local clear_tip = string.format(gt("st_arena_endless_wave_cleared"), endless_wave, endless_reward)
        news_manager.send_tip(db.actor, clear_tip, 0, nil, 7000)

        heal_actor_completely()

        endless_wave = endless_wave + 1
        if xcvb_arena_main then
            if endless_wave > (xcvb_arena_main.endless_checkpoint_wave or 1) then
                xcvb_arena_main.endless_checkpoint_wave = endless_wave
            end
            xcvb_arena_main.endless_difficulty = endless_difficulty
        end
    end -- On load the wave reward and checkpoint have already been recorded.

    cont_fire_last_wpn_id = nil
    cont_fire_was_firing = false
    cont_fire_aim_trans = false
    cont_fire_last_zoomed = false
    cont_fire_retriggered = false

    CreateTimeEvent("arena_endless_wave_warn_e", "arena_endless_wave_warn_a", 1.0, function()
        if endless_ending or endless_fight_closed then return true end
        local msg_spawn = gt("st_arena_endless_enemies_spawning_3s")
        if not msg_spawn or msg_spawn == "" or msg_spawn == "st_arena_endless_enemies_spawning_3s" then
            msg_spawn = "Enemies will spawn in 3 sec"
        end
        news_manager.send_tip(db.actor, msg_spawn, 0, nil, 3000)
        return true
    end)

    CreateTimeEvent("arena_endless_corpse_clean_e", "arena_endless_corpse_clean_a", 3.5, function()
        if endless_ending or endless_fight_closed then return true end
        for _, id in ipairs(endless_enemy_squad_ids) do
            xcvb_arena_utils.clean_tournament_squad(id)
        end
        endless_enemy_squad_ids = {}
        xcvb_arena_utils.clean_arena_corpses()
        return true
    end)

    CreateTimeEvent("arena_endless_next_wave_e", "arena_endless_next_wave_a", 4.0, function()
        if endless_ending or endless_fight_closed then return true end

        if xcvb_arena_endless and xcvb_arena_endless.equip_endless_loadout then
            xcvb_arena_endless.equip_endless_loadout(endless_wave, endless_difficulty, xcvb_arena_main.endless_3dssg == true)
        else
            xcvb_arena_utils.equip_endless_random_loadout(endless_wave, endless_difficulty, xcvb_arena_main.endless_3dssg == true)
        end
        if xcvb_arena_main.night_mode_active then
            pcall(xcvb_arena_utils.ensure_actor_torch_active)
            CreateTimeEvent("arena_endless_torch_verify_e", "arena_endless_torch_verify_a", 0.8, function()
                pcall(xcvb_arena_utils.ensure_actor_torch_active)
                return true
            end)
        end
        heal_actor_completely()

        local next_squads = xcvb_arena_utils.spawn_endless_squad(endless_wave, endless_enemy_type, endless_difficulty)
        endless_enemy_squad_ids = {}
        if next_squads then
            if next_squads.id then
                table.insert(endless_enemy_squad_ids, next_squads.id)
            else
                for _, sq in ipairs(next_squads) do
                    if sq and sq.id then
                        table.insert(endless_enemy_squad_ids, sq.id)
                    end
                end
            end
        end

        if #endless_enemy_squad_ids == 0 then
            printe("! xcvb arena: Failed to spawn endless wave %s; cashing out cleared waves", endless_wave)
            end_endless_fight(false, true)
            return true
        end

        local attempts_w = 0
        CreateTimeEvent("allow_endless_aggro_wave_e", "allow_endless_aggro_wave_a", 0.8, function()
            if endless_ending or endless_fight_closed then return true end
            attempts_w = attempts_w + 1
            local done = xcvb_arena_utils.setup_endless_squads_aggro(endless_enemy_squad_ids)
            if xcvb_arena_companions and xcvb_arena_companions.reassign_companion_aggro then
                pcall(xcvb_arena_companions.reassign_companion_aggro, endless_enemy_squad_ids)
            end
            if db.actor and db.actor:active_slot() == 0 then
                for _, s in ipairs({2, 1}) do
                    if db.actor:item_in_slot(s) then
                        db.actor:activate_slot(s)
                        break
                    end
                end
            end
            if done or attempts_w >= 6 then
                return true
            end
            ResetTimeEvent("allow_endless_aggro_wave_e", "allow_endless_aggro_wave_a", 0.4)
            return false
        end)

        local enemy_count = #endless_enemy_squad_ids
        local diff_str = gt("st_arena_endless_diff_" .. (endless_difficulty or "medium"))
        local start_tip = string.format(gt("st_arena_endless_wave_started"), endless_wave, enemy_count) .. " (" .. diff_str .. ")"
        news_manager.send_tip(db.actor, start_tip, 0, nil, 7000)

        -- Reassign companion aggro to the new wave
        if xcvb_arena_companions and xcvb_arena_companions.cleanup_dead_companions then
            xcvb_arena_companions.cleanup_dead_companions()
        end
        if xcvb_arena_companions and xcvb_arena_companions.reassign_companion_aggro then
            CreateTimeEvent("xcvb_comp_wave_aggro_e", "xcvb_comp_wave_aggro_a", 2.0, function()
                if not endless_ending and not endless_fight_closed then
                    xcvb_arena_companions.reassign_companion_aggro(endless_enemy_squad_ids)
                end
                return true
            end)
        end
        endless_transitioning = false
        return true
    end)
end

function end_endless_fight(is_victory, voluntary_leave)
    if endless_fight_closed then return end
    endless_fight_closed = true
    callback_epoch = callback_epoch + 1
    cancel_player_combat_events()
    endless_ending = false
    tourn_ending = false
    endless_transitioning = false
    pcall(xcvb_arena_utils.exit_arena_night_mode)

    if db.actor then
        local bar_pos, bar_lvid, bar_gvid = xcvb_arena_utils.get_actor_bar_safe_pos()
        db.actor:set_actor_position(bar_pos, bar_lvid, bar_gvid)
        pcall(level.enable_input)
    end

    if game.only_allow_movekeys then pcall(game.only_allow_movekeys, false) end
    pcall(level.enable_input)
    pcall(level.show_indicators)

    if endless_enemy_squad_ids then
        for _, s_id in ipairs(endless_enemy_squad_ids) do
            xcvb_arena_utils.clean_tournament_squad(s_id)
        end
        endless_enemy_squad_ids = {}
    end
    xcvb_arena_utils.clean_arena_corpses()
    -- Clean up all hired companions when endless mode ends
    if xcvb_arena_companions and xcvb_arena_companions.cleanup_all_companions then
        pcall(xcvb_arena_companions.cleanup_all_companions)
    end
    if xcvb_arena_companions and xcvb_arena_companions.reset_arena_credits then
        xcvb_arena_companions.reset_arena_credits()
    end
    xcvb_arena_utils.restore_actor_inventory()

    heal_actor_completely()
    CreateTimeEvent("xcvb_arena_heal_endless_e", "xcvb_arena_heal_endless_a", 0.5, function()
        heal_actor_completely()
        return true
    end)

    local waves_cleared = voluntary_leave and (endless_wave - 1) or (is_victory and endless_wave or 0)
    local actor_alive = db.actor and db.actor:alive()
    if voluntary_leave and actor_alive then
        if endless_reward > 0 then
            db.actor:give_money(endless_reward)
            local exit_tip = string.format(gt("st_arena_endless_exit_tip"), waves_cleared, endless_reward)
            news_manager.send_tip(db.actor, exit_tip, 0, nil, 12000)
        end
    end

    if xcvb_arena_main then
        if endless_wave and endless_wave > (xcvb_arena_main.endless_checkpoint_wave or 1) then
            xcvb_arena_main.endless_checkpoint_wave = endless_wave
        end
        xcvb_arena_main.endless_difficulty = endless_difficulty
    end

    disable_info("xcvb_endless_started")
    is_endless_mode = false
    endless_enemy_squad_ids = {}
    endless_wave = 1
    endless_reward = 0
    if not is_medic_rescuing then
        schedule_auto_open_arena_gui(1.2)
    end
    return true
end

--------------------------------------------------------------------------------
-- ENGINE CALLBACKS
--------------------------------------------------------------------------------
local hit_timer = 0
local function is_npc_wounded(npc)
    if xcvb_arena_utils and xcvb_arena_utils.is_npc_wounded then
        return xcvb_arena_utils.is_npc_wounded(npc)
    end
    if not (npc and npc:alive()) then return false end
    if IsMonster and IsMonster(npc) then return false end
    if IsWounded and IsWounded(npc) then return true end
    local hp = npc.health or (npc.GetHealth and npc:GetHealth())
    return (hp and hp <= 0.15) or false
end

local function has_live_enemy(npc)
    local enemy = nil
    local is_alive = false
    pcall(function()
        enemy = npc:best_enemy()
        is_alive = enemy and enemy:alive() or false
    end)
    return is_alive
end

--------------------------------------------------------------------------------
-- CONTINUOUS FIRE (Hip-fire to ADS and ADS to Hip-fire)
--------------------------------------------------------------------------------
local cont_fire_last_wpn_id = nil
local cont_fire_was_firing = false
local cont_fire_aim_trans = false
local cont_fire_last_zoomed = false
local cont_fire_retriggered = false

local function is_weapon_auto_mode(wpn)
    if not wpn then return false end
    local ok, fm = pcall(function()
        if wpn.GetFireMode then return wpn:GetFireMode() end
        local c = wpn.cast_Weapon and wpn:cast_Weapon()
        if c and c.GetFireMode then return c:GetFireMode() end
        return nil
    end)
    if ok and fm then
        if fm == -1 or fm > 1 then
            return true
        elseif fm == 1 then
            return false
        end
    end
    local sec = wpn:section()
    local modes = ini_sys:r_string_ex(sec, "fire_modes")
    if modes then
        if string.find(modes, "-1") and not (string.find(modes, "1,") or string.find(modes, ", 1") or modes == "1") then
            return true
        end
    end
    return false
end

function actor_on_hud_animation_play(anm_table, item)
    if not anm_table or not anm_table.anm_name then return end
    local anm = anm_table.anm_name

    -- Bypass first-draw / inspection animations (anm_show_first, anm_inspect, anm_bore) on weapon reset/draw
    if string.find(anm, "first") or string.find(anm, "inspect") or (string.find(anm, "bore") and (HI("xcvb_tournament_started") or HI("xcvb_endless_started") or is_endless_mode)) then
        local is_empty = string.find(anm, "empty") or string.find(anm, "_0") or string.find(anm, "0_")
        local target_anm = nil

        if string.find(anm, "first") then
            local clean = string.gsub(anm, "_first", "")
            clean = string.gsub(clean, "first_", "")
            clean = string.gsub(clean, "first", "")
            target_anm = clean
        elseif string.find(anm, "inspect") then
            target_anm = is_empty and "anm_show_empty" or "anm_show"
        elseif string.find(anm, "bore") then
            target_anm = is_empty and "anm_idle_empty" or "anm_idle"
        end

        if target_anm and item and item.section and ini_sys then
            local sec = item:section()
            local hud_sec = ini_sys:r_string_ex(sec, "hud")
            if hud_sec and not ini_sys:line_exist(hud_sec, target_anm) then
                if string.find(anm, "bore") then
                    target_anm = (is_empty and ini_sys:line_exist(hud_sec, "anm_idle_empty")) and "anm_idle_empty" or "anm_idle"
                else
                    if is_empty and ini_sys:line_exist(hud_sec, "anm_show_empty") then
                        target_anm = "anm_show_empty"
                    elseif ini_sys:line_exist(hud_sec, "anm_show") then
                        target_anm = "anm_show"
                    elseif ini_sys:line_exist(hud_sec, "anm_idle") then
                        target_anm = "anm_idle"
                    end
                end
            end
        end

        if target_anm then
            anm_table.anm_name = target_anm
            anm = target_anm
        end
    end

    if string.find(anm, "aim_start") or string.find(anm, "aim_end") then
        local fire_dik = bind_to_dik(key_bindings.kWPN_FIRE)
        local lmb_held = key_state(fire_dik) ~= 0
        if lmb_held and cont_fire_was_firing then
            if string.find(anm, "aim_start") then
                anm_table.anm_name = string.find(anm, "empty") and "anm_idle_aim_empty" or "anm_idle_aim"
            else
                anm_table.anm_name = string.find(anm, "empty") and "anm_idle_empty" or "anm_idle"
            end
        end
    end
end

function actor_on_weapon_zoom_in(wpn)
    -- Weapon aim transitions are not scripted hand motions. Stopping a hand
    -- motion here can use the engine's inactive part (255) or cancel another mod.
    cont_fire_aim_trans = true
    local fire_dik = bind_to_dik(key_bindings.kWPN_FIRE)
    if key_state(fire_dik) ~= 0 and cont_fire_was_firing and wpn and IsWeapon(wpn) then
        level.release_action(fire_dik)
        level.press_action(fire_dik)
        pcall(function() wpn:switch_state(5) end)
    end
end

function actor_on_weapon_zoom_out(wpn)
    cont_fire_aim_trans = true
    local fire_dik = bind_to_dik(key_bindings.kWPN_FIRE)
    if key_state(fire_dik) ~= 0 and cont_fire_was_firing and wpn and IsWeapon(wpn) then
        level.release_action(fire_dik)
        level.press_action(fire_dik)
        pcall(function() wpn:switch_state(5) end)
    end
end

local function continuous_fire_on_update()
    if not db.actor or not db.actor:alive() then
        cont_fire_was_firing = false
        cont_fire_aim_trans = false
        cont_fire_retriggered = false
        return
    end

    -- Skip if UI / inventory / PDA is open
    if (actor_menu and actor_menu.last_mode ~= 0)
        or (pda and pda.dialog_closed == false)
        or (Check_UI and Check_UI())
        or db.actor:has_info("ui_pda") then
        cont_fire_was_firing = false
        cont_fire_aim_trans = false
        cont_fire_retriggered = false
        return
    end

    local fire_dik = bind_to_dik(key_bindings.kWPN_FIRE)
    local lmb_held = key_state(fire_dik) ~= 0

    if not lmb_held then
        cont_fire_was_firing = false
        cont_fire_aim_trans = false
        cont_fire_retriggered = false
        return
    end

    local wpn = db.actor:active_item()
    if not wpn or not IsWeapon(wpn) then
        cont_fire_was_firing = false
        cont_fire_aim_trans = false
        cont_fire_retriggered = false
        return
    end

    local wpn_id = wpn:id()
    if wpn_id ~= cont_fire_last_wpn_id then
        cont_fire_last_wpn_id = wpn_id
        cont_fire_was_firing = false
        cont_fire_aim_trans = false
        cont_fire_retriggered = false
    end

    local kind = ini_sys:r_string_ex(wpn:section(), "kind")
    if kind == "w_melee" or kind == "w_misc" then
        return
    end

    local state = wpn:get_state()
    local is_zoomed = (axr_main and axr_main.weapon_is_zoomed) or false

    if is_zoomed ~= cont_fire_last_zoomed then
        cont_fire_aim_trans = true
        cont_fire_last_zoomed = is_zoomed
    end

    if state == 5 then -- eFire
        cont_fire_was_firing = true
        cont_fire_retriggered = false
    end

    -- Seamlessly continue firing when weapon becomes idle during aim transitions
    if lmb_held and (state == 0 or state == 11 or state == 12) then
        local ammo = wpn:get_ammo_in_magazine()
        
-- Verificación segura de encasquillamiento (Soporta Vanilla + Arti's Jamming)
		local is_jammed = (wpn:get_state() == 7) -- 7 representa 'eMisfire' en Vanilla
		if rawget(_G, "arti_jamming") then
			if type(_G.arti_jamming.get_jammed) == "function" then
				local ok, res = pcall(_G.arti_jamming.get_jammed, wpn:id())
				if ok and res then is_jammed = true end
			elseif type(_G.arti_jamming.check_unjam) == "function" then
				local ok, res = pcall(_G.arti_jamming.check_unjam, wpn)
				if ok and res then is_jammed = true end
			end
		end
        
        local is_lowered = (game.actor_weapon_lowered and game.actor_weapon_lowered()) or false

        if ammo > 0 and not is_jammed and not is_lowered then
            local is_auto = is_weapon_auto_mode(wpn)
            if is_auto and cont_fire_was_firing then
                level.release_action(fire_dik)
                level.press_action(fire_dik)
                pcall(function() wpn:switch_state(5) end)
            elseif cont_fire_aim_trans and not cont_fire_retriggered then
                cont_fire_retriggered = true
                cont_fire_aim_trans = false
                level.release_action(fire_dik)
                level.press_action(fire_dik)
                pcall(function() wpn:switch_state(5) end)
            end
        else
            cont_fire_was_firing = false
            cont_fire_aim_trans = false
        end
    end
end

local ending_state_start = 0

function actor_on_update()
    if tourn_ending or endless_ending then
        local tg = time_global()
        if ending_state_start == 0 then
            ending_state_start = tg
        elseif tg - ending_state_start > 5000 then
            -- Failsafe timeout: never leave actor stuck in immortal ending state
            tourn_ending = false
            endless_ending = false
            ending_state_start = 0
        end

        if not HI("xcvb_tournament_started") and not HI("xcvb_endless_started") and not is_endless_mode then
            tourn_ending = false
            endless_ending = false
            ending_state_start = 0
        elseif tournament_fight_closed or endless_fight_closed or is_medic_rescuing then
            if db.actor then
                db.actor.health = 1.0
                db.actor.bleeding = 1.0
            end
            return
        else
            tourn_ending = false
            endless_ending = false
            ending_state_start = 0
        end
    else
        ending_state_start = 0
    end

    continuous_fire_on_update()

    local tg_cur = time_global()
    if tg_cur > sync_device_timer then
        sync_device_timer = tg_cur + 500
        if xcvb_arena_main and xcvb_arena_main.night_mode_active and (HI("xcvb_endless_started") or is_endless_mode or HI("xcvb_tournament_started")) then
            pcall(sync_night_mode_device_from_actor)
        end
    end

    if HI("xcvb_tournament_started") then
        local rescue_enabled = xcvb_arena_mcm.get_config("medic_rescue")
        if rescue_enabled ~= false and db.actor and db.actor:alive() then
            if db.actor.health <= 0.01 then
                trigger_medic_rescue()
            end
        end
        
        local tg = time_global()
        if tg > hit_timer then
            hit_timer = tg + (xcvb_arena_main.night_mode_active and 250 or 2000)
            if tournament_enemy_squad_id then
                local squad = alife_object(tournament_enemy_squad_id)
                if squad then
                    for m in squad:squad_members() do
                        local npc = level.object_by_id(m.id)
                        if npc and npc:alive() then
                            if is_npc_wounded(npc) then
                                pcall(function()
                                    if npc.bleeding and npc.bleeding < 0.3 then
                                        npc.bleeding = 0.5
                                    end
                                end)
                            elseif xcvb_arena_main.night_mode_active then
                                xcvb_arena_utils.apply_realistic_night_vision(npc)
                                xcvb_arena_utils.equip_and_enable_npc_torch(npc)
                            elseif not has_live_enemy(npc) then
                                xcvb_arena_utils.scr_hit(db.actor, npc)
                            end
                        end
                    end
                end
            end
        end
    end

    if HI("xcvb_endless_started") or is_endless_mode then
        local rescue_enabled = xcvb_arena_mcm.get_config("medic_rescue")
        if rescue_enabled ~= false and db.actor and db.actor:alive() then
            if db.actor.health <= 0.01 then
                trigger_medic_rescue()
            end
        end

        local tg = time_global()
        if tg > hit_timer then
            hit_timer = tg + (xcvb_arena_main.night_mode_active and 250 or 2000)
            if endless_enemy_squad_ids then
                for _, s_id in ipairs(endless_enemy_squad_ids) do
                    local squad = alife_object(s_id)
                    if squad then
                        squad.scripted_target = "actor"
                        squad.assigned_target_id = 0
                        local is_night = (xcvb_arena_main.night_mode_active == true)
                        squad.rush_to_target = not is_night
                        for m in squad:squad_members() do
                            local npc = level.object_by_id(m.id)
                            if npc and npc:alive() then
                                if is_npc_wounded(npc) then
                                    pcall(function()
                                        if npc.bleeding and npc.bleeding < 0.3 then
                                            npc.bleeding = 0.5
                                        end
                                    end)
                                elseif is_night then
                                    xcvb_arena_utils.apply_realistic_night_vision(npc)
                                    xcvb_arena_utils.equip_and_enable_npc_torch(npc)
                                else
                                    if not has_live_enemy(npc) then
                                        xcvb_arena_utils.scr_hit(db.actor, npc)
                                    end
                                    xcvb_arena_utils.set_bloodsucker_enemy(npc, db.actor)
                                    -- Wallhack removed: natural AI line-of-sight engagement only
                                    if IsStalker and IsStalker(npc) and npc.set_mental_state then
                                        pcall(function() npc:set_mental_state(anim.danger) end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if HI("xcvb_arena_started") then
        if not spec_fight_ending and not spectator_fight_closed then
            local tg = time_global()
            if next_spectator_hint == 0 then
                next_spectator_hint = tg + 25000
            elseif tg > next_spectator_hint then
                next_spectator_hint = tg + 25000
                news_manager.send_tip(db.actor, gt("st_arena_spectator_press_f"), 0, nil, 10000)
            end
        else
            next_spectator_hint = 0
        end

        local tg = time_global()
        if tg > hit_timer then
            hit_timer = tg + 2000
            xcvb_arena_utils.force_mutant_aggro(squad_team_1_id, squad_team_2_id)
            xcvb_arena_utils.force_stalker_aggro(squad_team_1_id, squad_team_2_id)
            
            local sq1 = squad_team_1_id and alife_object(squad_team_1_id)
            local sq2 = squad_team_2_id and alife_object(squad_team_2_id)
            
            local function maintain_aggro(sq)
                if not sq then return end
                for m in sq:squad_members() do
                    local n = level.object_by_id(m.id)
                    if n and n:alive() and not is_npc_wounded(n) then
                        if db.actor then
                            pcall(function() n:set_relation(game_object.neutral, db.actor) end)
                            pcall(function() n:force_set_goodwill(5000, db.actor) end)
                        end
                        if IsMonster and IsMonster(n) then
                            pcall(function() n:berserk() end)
                            pcall(function() n:set_custom_panic_threshold(0) end)
                        elseif IsStalker and IsStalker(n) then
                            pcall(function() n:set_mental_state(anim.danger) end)
                            pcall(function() n:set_custom_panic_threshold(0.05) end)
                        end
                    end
                end
            end
            maintain_aggro(sq1)
            maintain_aggro(sq2)
        end
    else
        next_spectator_hint = 0
    end
    
    if HI("xcvb_battle_royale_started") then
        if not battle_royale_ending and not battle_royale_closed then
            local tg = time_global()
            if next_br_hint == 0 then
                next_br_hint = tg + 25000
            elseif tg > next_br_hint then
                next_br_hint = tg + 25000
                news_manager.send_tip(db.actor, gt("st_arena_spectator_press_f"), 0, nil, 10000)
            end
        else
            next_br_hint = 0
        end

        local tg = time_global()
        if tg > hit_timer then
            hit_timer = tg + 2000
            xcvb_arena_utils.setup_battle_royale_relations(battle_royale_squad_ids)
            if next_br_status == 0 or tg > next_br_status then
                next_br_status = tg + 15000
                local status = get_battle_royale_status()
                if status ~= "" and status ~= battle_royale_last_status then
                    battle_royale_last_status = status
                    news_manager.send_tip(db.actor, string.format(gt("st_arena_bc_status"), status), 0, nil, 5000)
                end
            end
        end
    else
        next_br_hint = 0
        next_br_status = 0
        if next(battle_royale_initialized_npcs) then reset_battle_royale_cache() end
    end

    if HI("xcvb_tournament_started") and tourn_saved_actor_reputation then
        local cur_rep = db.actor:character_reputation()
        if cur_rep < tourn_saved_actor_reputation then
            db.actor:change_character_reputation(tourn_saved_actor_reputation - cur_rep)
        end
    end
end

function on_before_key_press(key, bind, dis, flags)
	local cur_bind = bind or dik_to_bind(key)
	if cur_bind == key_bindings.kWPN_ZOOM or dik_to_bind(key) == key_bindings.kWPN_ZOOM then
		local fire_dik = bind_to_dik(key_bindings.kWPN_FIRE)
		if key_state(fire_dik) ~= 0 then
			cont_fire_aim_trans = true
		end
	end

	local panic_key = (xcvb_arena_mcm and xcvb_arena_mcm.get_config("panic_key")) or DIK_keys.DIK_F

	if HI("xcvb_tournament_started") then
		if key == panic_key or (panic_key == DIK_keys.DIK_F and cur_bind == key_bindings.kUSE) then
			if not tourn_ending and not tournament_fight_closed then
				tourn_ending = true
				xcvb_arena_utils.arena_fade_in_out(1)
				local uid = tostring(math.random(100000))
				CreateTimeEvent("xcvb_arena_exit_tourn_f_e", "tourn_f_a_" .. uid, 1.5, function()
					end_tournament_fight(false)
					return true
				end)
			end
			flags.ret_value = false
			return
		end
		return
	end

	if HI("xcvb_endless_started") or is_endless_mode then
		if key == panic_key or (panic_key == DIK_keys.DIK_F and cur_bind == key_bindings.kUSE) then
			if not endless_ending and not endless_fight_closed then
				endless_ending = true
				xcvb_arena_utils.arena_fade_in_out(1)
                local uid = tostring(math.random(100000))
				CreateTimeEvent("xcvb_arena_exit_endless_f_e", "endless_a_" .. uid, 1.5, function()
					end_endless_fight(true, true)
					return true
				end)
			end
			flags.ret_value = false
			return
		end
		return
	end

	if not HI("xcvb_arena_started") and not HI("xcvb_battle_royale_started") then return end
	local bind = dik_to_bind(key)

	if key == panic_key or key == DIK_keys.DIK_F or bind == key_bindings.kUSE then
		if HI("xcvb_battle_royale_started") then
			if not battle_royale_ending and not battle_royale_closed then
				battle_royale_ending = true
				xcvb_arena_utils.arena_fade_in_out(1)
                local uid = tostring(math.random(100000))
				CreateTimeEvent("xcvb_arena_exit_br_f_e", "br_f_a_" .. uid, 1.5, function()
					end_battle_royale(0)
					return true
				end)
			end
		elseif not spec_fight_ending and not spectator_fight_closed then
			spec_fight_ending = true
			xcvb_arena_utils.arena_fade_in_out(1)
            local uid = tostring(math.random(100000))
			CreateTimeEvent("xcvb_arena_exit_f_e", "spec_f_a_" .. uid, 1.5, function()
				end_arena_fight(0)
				return true
			end)
		end
		flags.ret_value = false
		return
	end

	if bind == key_bindings.kFWD
	or bind == key_bindings.kL_STRAFE
	or bind == key_bindings.kR_STRAFE
	or bind == key_bindings.kBACK
	or bind == key_bindings.kACCEL
	or bind == key_bindings.kCROUCH
	or bind == key_bindings.kCONSOLE		-- console
	or bind == key_bindings.kQUIT then		-- esc
		return
	end
	flags.ret_value = false
end

function on_key_release(key)
	local cur_bind = dik_to_bind(key)
	if cur_bind == key_bindings.kWPN_ZOOM then
		local fire_dik = bind_to_dik(key_bindings.kWPN_FIRE)
		if key_state(fire_dik) ~= 0 then
			cont_fire_aim_trans = true
		end
	end
end

function on_enemy_eval(npc, enemy, flags)
    if not (npc and enemy and flags) then
        if flags then
            flags.override = true
            flags.result = false
        end
        return
    end

    local enemy_id = enemy:id()
    local npc_id = npc:id()

    if HI("xcvb_endless_started") or is_endless_mode then
        local is_npc_comp = xcvb_arena_companions and xcvb_arena_companions.is_companion and xcvb_arena_companions.is_companion(npc_id)
        local is_enemy_comp = xcvb_arena_companions and xcvb_arena_companions.is_companion and xcvb_arena_companions.is_companion(enemy_id)

        -- Companion evaluates Actor -> Not Enemy
        if is_npc_comp and enemy_id == 0 then
            flags.override = true
            flags.result = false
            return
        end
        -- Actor evaluates Companion -> Not Enemy
        if npc_id == 0 and is_enemy_comp then
            flags.override = true
            flags.result = false
            return
        end
        -- Companion evaluates Companion -> Not Enemy
        if is_npc_comp and is_enemy_comp then
            flags.override = true
            flags.result = false
            return
        end

        local is_npc_arena = xcvb_arena_utils and xcvb_arena_utils.arena_spawned_combatant_ids and xcvb_arena_utils.arena_spawned_combatant_ids[npc_id] and not is_npc_comp
        local is_enemy_arena = xcvb_arena_utils and xcvb_arena_utils.arena_spawned_combatant_ids and xcvb_arena_utils.arena_spawned_combatant_ids[enemy_id] and not is_enemy_comp

        -- Companion evaluates Arena Enemy -> Hostile
        if is_npc_comp and is_enemy_arena then
            flags.override = true
            flags.result = true
            return
        end
        -- Arena Enemy evaluates Companion -> Hostile
        if is_npc_arena and is_enemy_comp then
            flags.override = true
            flags.result = true
            return
        end
        -- Arena Enemy evaluates Actor -> Hostile
        if is_npc_arena and enemy_id == 0 then
            flags.override = true
            flags.result = true
            return
        end
        -- Arena Enemy evaluates another Arena Enemy -> Friendly
        if is_npc_arena and is_enemy_arena then
            flags.override = true
            flags.result = false
            return
        end
        return
    end

    if HI("xcvb_tournament_started") then
        local npc_squad = get_object_squad(npc)
        local enemy_squad = enemy and get_object_squad(enemy)
        local npc_is_tourn = npc_squad and string.find(npc_squad:section_name(), "arena_")
        local enemy_is_tourn = enemy_squad and string.find(enemy_squad:section_name(), "arena_")
        
        if npc_is_tourn and enemy_id == 0 then
            flags.override = true
            flags.result = true
            return
        end
        if npc_is_tourn and enemy_id ~= 0 then
            flags.override = true
            flags.result = false
            return
        end
        if (not npc_is_tourn) and enemy_is_tourn then
            flags.override = true
            flags.result = false
            return
        end
        return
    end

    if HI("xcvb_arena_started") or HI("xcvb_battle_royale_started") then
        if enemy_id == 0 then
            flags.override = true
            flags.result = false
            return
        end
        local npc_squad = get_object_squad(npc)
        local enemy_squad = get_object_squad(enemy)
        if not (npc_squad and enemy_squad) then return end
        
        local npc_squad_is_arena = string.find(npc_squad:section_name(), "arena_")
        local enemy_squad_is_arena = string.find(enemy_squad:section_name(), "arena_")
        
        if npc_squad_is_arena and enemy_squad_is_arena and npc_squad.id ~= enemy_squad.id then
            flags.override = true
            flags.result = true
            return
        end
        if npc_squad_is_arena and (not enemy_squad_is_arena) then
            flags.override = true
            flags.result = false
        end
        if (not npc_squad_is_arena) and enemy_squad_is_arena then
            flags.override = true
            flags.result = false
        end
    end
end

function npc_on_before_hit(npc, s_hit)
    if not (npc and s_hit) then return end

    -- Ignore artificial wake-up hits on wounded NPCs to prevent animation interrupt
    if s_hit.type == hit.wound and (s_hit.power or 0) < 0.01 and is_npc_wounded(npc) then
        s_hit.power = 0
        return
    end

    -- In active combat modes (Endless or Tournament), if player shoots a wounded enemy, ensure lethal damage
    if (HI("xcvb_endless_started") or is_endless_mode or HI("xcvb_tournament_started")) and is_npc_wounded(npc) then
        local draft_is_ac = s_hit.draftsman and s_hit.draftsman:id() == 0
        if draft_is_ac and (s_hit.power or 0) > 0.05 then
            s_hit.power = math.max(s_hit.power or 0, 10.0)
            return
        end
    end

    if HI("xcvb_arena_started") or HI("xcvb_battle_royale_started") then
        local squad = get_object_squad(npc)
        local arena_squad = squad and string.find(squad:section_name(), "arena_")
        local draft_is_ac = s_hit and s_hit.draftsman and s_hit.draftsman:id() == 0 and (s_hit.power or 0) > 0.05
        
        if arena_squad and draft_is_ac then
            news_manager.send_tip(db.actor, gt("st_arena_kicked_out"), 0, nil, 15000)
            xcvb_arena_utils.arena_fade_in_out()
            if HI("xcvb_battle_royale_started") then
                local uid = tostring(math.random(100000))
                CreateTimeEvent("xcvb_arena_end_br_e", "br_a_" .. uid, 2, function()
                    end_battle_royale(0)
                    return true
                end)
            else
                local uid = tostring(math.random(100000))
                CreateTimeEvent("xcvb_arena_end_fight_e", "fight_a_" .. uid, 2, function()
                    end_arena_fight(0)
                    return true
                end)
            end
        end
    end
end

function trigger_medic_rescue()
    if is_medic_rescuing then return true end
    if xcvb_arena_utils and xcvb_arena_utils.install_itms_manager_safeguard then
        pcall(xcvb_arena_utils.install_itms_manager_safeguard)
    end
    pcall(ResetTimeEvent, "cycle", "bolt_manager", 30)
    if tourn_ending or endless_ending then return false end
    if not db.actor then return false end
    local in_endless = is_endless_mode or HI("xcvb_endless_started")
    local in_tournament = HI("xcvb_tournament_started")
    if not in_endless and not in_tournament then return false end
    if in_endless and endless_fight_closed then return false end
    if not in_endless and tournament_fight_closed then return false end
    is_medic_rescuing = true
    cancel_player_combat_events()
    if in_endless then
        endless_ending = true
        tourn_ending = false
        if xcvb_arena_main and endless_wave and endless_wave > (xcvb_arena_main.endless_checkpoint_wave or 1) then
            xcvb_arena_main.endless_checkpoint_wave = endless_wave
        end
    else
        tourn_ending = true
        endless_ending = false
    end

    if db.actor then
        pcall(function() db.actor:activate_slot(0) end)
    end
    pcall(level.disable_input)
    pcall(level.hide_indicators_safe)

    heal_actor_completely()

    local target_squad_ids = {}
    if tournament_enemy_squad_id then
        table.insert(target_squad_ids, tournament_enemy_squad_id)
    end
    if endless_enemy_squad_ids then
        for _, s_id in ipairs(endless_enemy_squad_ids) do
            table.insert(target_squad_ids, s_id)
        end
    end
    for _, target_squad_id in ipairs(target_squad_ids) do
        local squad = alife_object(target_squad_id)
        if squad then
            for member in squad:squad_members() do
                local npc = level.object_by_id(member.id)
                if npc and npc:alive() then
                    pcall(function()
                        npc:set_relation(game_object.neutral, db.actor)
                        npc:force_set_goodwill(1000, db.actor)
                    end)
                end
            end
        end
    end

    pcall(function()
        local path = [[characters_voice\human\actor\die]] .. math.random(0, 3)
        local snd = xcvb_arena_utils.sound_if_exists(path)
        if snd then
            snd:play(db.actor, 0, sound_object.s2d)
        end
    end)

    pcall(function()
        level.add_cam_effector("camera_effects\\surge_02.anm", 987126, false, "")
    end)

    pcall(level.add_pp_effector, "actor_death.ppe", 987125, false)

    local uid = tostring(math.random(100000))
    CreateTimeEvent("xcvb_arena_fade_dark_e", "dark_a_" .. uid, 2.0, function()
        pcall(function()
            level.add_pp_effector("fade_in.ppe", 987123, false)
        end)
        return true
    end)

    CreateTimeEvent("xcvb_arena_rescue_e", "rescue_a_" .. uid, 3.5, function()
        pcall(level.remove_pp_effector, 987125)
        pcall(level.remove_cam_effector, 987126)

        pcall(function()
            if is_endless_mode or HI("xcvb_endless_started") then
                end_endless_fight(false, false)
            else
                end_tournament_fight(false)
            end
        end)
        tourn_ending = false
        endless_ending = false
        is_medic_rescuing = false
        schedule_auto_open_arena_gui(3.2)

        pcall(function()
            level.add_cam_effector("camera_effects\\wake_up.anm", 987128, false, "")
            level.add_pp_effector("fade_out.ppe", 987124, false)
        end)

        pcall(level.show_indicators)
        pcall(level.enable_input)
        if game.only_allow_movekeys then pcall(game.only_allow_movekeys, false) end

        local fee = (xcvb_arena_mcm and xcvb_arena_mcm.get_config("medic_rescue_fee")) or 2500
        if db.actor and fee > 0 then
            local to_take = math.min(db.actor:money(), fee)
            if to_take > 0 then
                db.actor:give_money(-to_take)
            end
        end
        local msg = string.format(gt("st_arena_medic_rescue"), fee)
        if db.actor then
            news_manager.send_tip(db.actor, msg, 0, nil, 12000)
        end
        return true
    end)
    return true
end

function actor_on_before_hit(s_hit, bone_id, flags)
    if is_spectator_mode() then
        if s_hit then s_hit.power = 0 end
        if flags then flags.ret_value = false end
        return
    end

    if is_medic_rescuing then
        if s_hit then s_hit.power = 0 end
        if flags then flags.ret_value = false end
        return
    end

    if HI("xcvb_tournament_started") or HI("xcvb_endless_started") or is_endless_mode then
        local rescue_enabled = xcvb_arena_mcm.get_config("medic_rescue")
        if rescue_enabled ~= false then
            local cur_health = db.actor and db.actor.health or 1.0
            -- Hit power is not final health loss: armor, bones and other mods
            -- still modify it. Let the engine apply it and rescue on death.
            if cur_health <= 0.01 and trigger_medic_rescue() then
                if s_hit then s_hit.power = 0 end
                if flags then flags.ret_value = false end
            end
        end
    end
end

function actor_on_before_death(whoID, flags)
    if is_spectator_mode() then
        if flags then flags.ret_value = false end
        if db.actor then db.actor.health = 1.0 end
        return
    end

    if HI("xcvb_tournament_started") or HI("xcvb_endless_started") or is_endless_mode then
        local rescue_enabled = xcvb_arena_mcm.get_config("medic_rescue")
        if rescue_enabled ~= false and trigger_medic_rescue() then
            if flags then flags.ret_value = false end
            if db.actor then db.actor.health = 1.0 end
        end
    end
end

function squad_on_npc_death(squad, se_obj, killer)
    if (HI("xcvb_endless_started") or is_endless_mode) and is_endless_enemy_squad(squad.id) then
        local remaining = get_endless_total_enemies_alive(squad.id)
        if remaining > 1 then
            local tip = string.format(gt("st_arena_enemies_remaining"), remaining)
            news_manager.send_tip(db.actor, tip, 0, nil, 4000)
        elseif remaining == 1 then
            news_manager.send_tip(db.actor, gt("st_arena_enemy_one_remaining"), 0, nil, 4000)
        elseif remaining <= 0 then
            advance_endless_wave()
        end
        return
    end

    if HI("xcvb_tournament_started") and tournament_enemy_squad_id and squad.id == tournament_enemy_squad_id then
        local remaining = squad:npc_count() - 1
        if remaining > 1 then
            local tip = string.format(gt("st_arena_enemies_remaining"), remaining)
            news_manager.send_tip(db.actor, tip, 0, nil, 4000)
        elseif remaining == 1 then
            news_manager.send_tip(db.actor, gt("st_arena_enemy_one_remaining"), 0, nil, 5000)
        elseif remaining <= 0 then
            on_tournament_victory(current_tournament_round_id)
        end
        return
    end

    if HI("xcvb_battle_royale_started") and not battle_royale_ending then
        local is_br = false
        for _, s_id in pairs(battle_royale_squad_ids) do
            if s_id == squad.id then
                is_br = true
                break
            end
        end
        if is_br then
            local dying_member_id = se_obj and se_obj.id
            local alive_teams = get_battle_royale_alive_teams(dying_member_id)

            if #alive_teams == 1 then
                battle_royale_ending = true
                local winner_idx = alive_teams[1]
                local fac_key = battle_royale_team_faction[winner_idx] or "stalker"
                local name = (battle_royale_submode == "mutants") and xcvb_arena_utils.get_mutant_name(fac_key) or xcvb_arena_utils.get_faction_name(fac_key)
                local tip_str_id = (battle_royale_submode == "mutants") and "st_arena_mvm_winner_tip" or "st_arena_bc_winner_tip"
                local tip_msg = string.format(gt(tip_str_id), name)
                news_manager.send_tip(db.actor, tip_msg, 0, nil, 10000)

                xcvb_arena_utils.arena_fade_in_out(2)
                local uid = tostring(math.random(100000))
                CreateTimeEvent("xcvb_arena_end_br_e", "br_a_" .. uid, 4, function()
                    end_battle_royale(winner_idx)
                    return true
                end)
            elseif #alive_teams == 0 then
                battle_royale_ending = true
                news_manager.send_tip(db.actor, gt("st_arena_bc_no_winner"), 0, nil, 10000)
                xcvb_arena_utils.arena_fade_in_out(2)
                local uid = tostring(math.random(100000))
                CreateTimeEvent("xcvb_arena_end_br_e", "br_a_" .. uid, 4, function()
                    end_battle_royale(0)
                    return true
                end)
            else
                local eliminated_team = nil
                for team_idx, s_id in pairs(battle_royale_squad_ids) do
                    if s_id == squad.id then
                        eliminated_team = team_idx
                        break
                    end
                end
                if eliminated_team then
                    announce_battle_royale_elimination(eliminated_team, #alive_teams)
                end
                local status = get_battle_royale_status()
                if status ~= "" then
                    battle_royale_last_status = status
                    news_manager.send_tip(db.actor, string.format(gt("st_arena_bc_status"), status), 0, nil, 6000)
                end
            end
            return
        end
    end

    if HI("xcvb_arena_started") and not spec_fight_ending then
        if squad_team_1_id and squad_team_1_id == squad.id then
            local remaining1 = squad:npc_count() - 1
            if remaining1 <= 0 then
                spec_fight_ending = true
                news_manager.send_tip(db.actor, gt("st_arena_team_2_won"), 0, nil, 10000)
                xcvb_arena_utils.arena_fade_in_out(2)
                local uid = tostring(math.random(100000))
                CreateTimeEvent("xcvb_arena_end_fight_e", "fight_a_" .. uid, 4, function()
                    end_arena_fight(2)
                    return true
                end)
            end
        elseif squad_team_2_id and squad_team_2_id == squad.id then
            local remaining2 = squad:npc_count() - 1
            if remaining2 <= 0 then
                spec_fight_ending = true
                news_manager.send_tip(db.actor, gt("st_arena_team_1_won"), 0, nil, 10000)
                xcvb_arena_utils.arena_fade_in_out(2)
                local uid = tostring(math.random(100000))
                CreateTimeEvent("xcvb_arena_end_fight_e", "fight_a_" .. uid, 4, function()
                    end_arena_fight(1)
                    return true
                end)
            end
        end
    end
end

function save_state(m_data)
    m_data.xcvb_arena_state_version = 2
    m_data.xcvb_tournament_is_practice = current_tournament_is_practice
    m_data.xcvb_tournament_inventory_stored = tournament_inventory_stored
    m_data.xcvb_tournament_pending_result = tournament_pending_result
    if tourn_ending and tournament_pending_result == nil then
        m_data.xcvb_tournament_pending_result = false
    end
    m_data.xcvb_arena_inventory_stored = xcvb_arena_utils.inventory_stored
    m_data.xcvb_arena_inventory_restore_pending = xcvb_arena_utils.inventory_restore_pending
    m_data.xcvb_arena_inventory_return_candidates = xcvb_arena_utils.inventory_return_candidates
    m_data.xcvb_arena_spawned_combatant_ids = xcvb_arena_utils.arena_spawned_combatant_ids
    m_data.xcvb_endless_transitioning = endless_transitioning
    m_data.xcvb_tourn_saved_actor_reputation = tourn_saved_actor_reputation
    m_data.xcvb_arena_squad_id_1 = squad_team_1_id
    m_data.xcvb_arena_squad_id_2 = squad_team_2_id
    m_data.xcvb_battle_royale_squad_ids = battle_royale_squad_ids
    m_data.xcvb_battle_royale_team_faction = battle_royale_team_faction
    m_data.xcvb_battle_royale_bet_team = battle_royale_bet_team
    m_data.xcvb_battle_royale_reward = battle_royale_reward
    m_data.xcvb_battle_royale_submode = battle_royale_submode
    m_data.xcvb_tournament_enemy_squad_id = tournament_enemy_squad_id
    m_data.xcvb_current_tournament_category = current_tournament_category
    m_data.xcvb_current_tournament_round_id = current_tournament_round_id
    m_data.xcvb_temporary_arena_item_ids = xcvb_arena_utils.temporary_arena_item_ids
    m_data.xcvb_arena_storage_box_id = xcvb_arena_utils.xcvb_arena_storage_box_id
    m_data.xcvb_saved_equipped_slots = xcvb_arena_utils.saved_equipped_slots
    m_data.xcvb_saved_belt_items = xcvb_arena_utils.saved_belt_items
    m_data.xcvb_saved_actor_item_ids = xcvb_arena_utils.saved_actor_item_ids
    m_data.xcvb_saved_active_slot = xcvb_arena_utils.saved_active_slot
    m_data.xcvb_is_endless_mode = is_endless_mode
    m_data.xcvb_endless_wave = endless_wave
    m_data.xcvb_endless_reward = endless_reward
    m_data.xcvb_endless_enemy_type = endless_enemy_type
    m_data.xcvb_fight_endless_difficulty = endless_difficulty
    m_data.xcvb_endless_enemy_squad_ids = endless_enemy_squad_ids
end

function load_state(m_data)
    callback_epoch = callback_epoch + 1
    xcvb_arena_utils.cancel_inventory_events()
    loaded_legacy_practice = m_data.xcvb_tournament_is_practice == nil
    cancel_player_combat_events()
    tournament_fight_closed = false
    endless_fight_closed = false
    spectator_fight_closed = false
    battle_royale_closed = false
    tourn_ending, endless_ending, endless_transitioning = false, false, false
    spec_fight_ending, battle_royale_ending, is_medic_rescuing = false, false, false
    next_spectator_hint, next_br_hint, next_br_status, sync_device_timer, hit_timer = 0, 0, 0, 0, 0
    reset_battle_royale_cache()
    battle_royale_announced_eliminations = {}
    battle_royale_last_status = ""
    tournament_pending_result = m_data.xcvb_tournament_pending_result
    current_tournament_is_practice = m_data.xcvb_tournament_is_practice == true
    resume_endless_transition = m_data.xcvb_endless_transitioning == true
    tourn_saved_actor_reputation = m_data.xcvb_tourn_saved_actor_reputation
    squad_team_1_id = m_data.xcvb_arena_squad_id_1
    squad_team_2_id = m_data.xcvb_arena_squad_id_2
    battle_royale_squad_ids = m_data.xcvb_battle_royale_squad_ids or {}
    battle_royale_team_faction = m_data.xcvb_battle_royale_team_faction or {}
    battle_royale_bet_team = m_data.xcvb_battle_royale_bet_team or 0
    battle_royale_reward = m_data.xcvb_battle_royale_reward or 0
    battle_royale_submode = m_data.xcvb_battle_royale_submode or "factions"
    tournament_enemy_squad_id = m_data.xcvb_tournament_enemy_squad_id
    current_tournament_category = m_data.xcvb_current_tournament_category or "stalker"
    current_tournament_round_id = m_data.xcvb_current_tournament_round_id
    xcvb_arena_utils.temporary_arena_item_ids = m_data.xcvb_temporary_arena_item_ids or {}
    xcvb_arena_utils.xcvb_arena_storage_box_id = m_data.xcvb_arena_storage_box_id or nil
    xcvb_arena_utils.saved_equipped_slots = m_data.xcvb_saved_equipped_slots or {}
    xcvb_arena_utils.saved_belt_items = m_data.xcvb_saved_belt_items or {}
    xcvb_arena_utils.saved_actor_item_ids = m_data.xcvb_saved_actor_item_ids or {}
    xcvb_arena_utils.saved_active_slot = m_data.xcvb_saved_active_slot or nil
    xcvb_arena_utils.arena_spawned_combatant_ids = m_data.xcvb_arena_spawned_combatant_ids or {}
    xcvb_arena_utils.inventory_stored = m_data.xcvb_arena_inventory_stored == true
    xcvb_arena_utils.inventory_restore_pending = m_data.xcvb_arena_inventory_restore_pending == true
    xcvb_arena_utils.inventory_return_candidates = m_data.xcvb_arena_inventory_return_candidates
    if m_data.xcvb_arena_inventory_stored == nil then
        xcvb_arena_utils.inventory_stored = next(xcvb_arena_utils.saved_actor_item_ids) ~= nil
    end
    tournament_inventory_stored = m_data.xcvb_tournament_inventory_stored == true
        or (current_tournament_round_id ~= nil and xcvb_arena_utils.inventory_stored)
    is_endless_mode = m_data.xcvb_is_endless_mode or false
    endless_wave = m_data.xcvb_endless_wave or 1
    endless_reward = m_data.xcvb_endless_reward or 0
    endless_enemy_type = m_data.xcvb_endless_enemy_type or "stalkers"
    if endless_enemy_type == "random" then endless_enemy_type = "stalkers" end
    endless_difficulty = m_data.xcvb_fight_endless_difficulty or m_data.xcvb_endless_difficulty or "medium"
    endless_enemy_squad_ids = m_data.xcvb_endless_enemy_squad_ids or {}
    if m_data.xcvb_endless_enemy_squad_id and #endless_enemy_squad_ids == 0 then
        table.insert(endless_enemy_squad_ids, m_data.xcvb_endless_enemy_squad_id)
    end
end

function actor_on_first_update()
    tourn_ending = false
    endless_ending = false
    setup_teams()
    xcvb_arena_utils.init_arena_box()
    if xcvb_arena_utils.inventory_restore_pending then
        xcvb_arena_utils.restore_actor_equipped_slots()
    end
    -- Migrate old saves and rebuild the ownership registry from their saved squads.
    local squads = {tournament_enemy_squad_id or false, squad_team_1_id or false, squad_team_2_id or false}
    for _, id in pairs(endless_enemy_squad_ids) do squads[#squads + 1] = id end
    for _, id in pairs(battle_royale_squad_ids) do squads[#squads + 1] = id end
    for _, id in ipairs(squads) do
        local sq = id and alife_object(id)
        if sq then
            for member in sq:squad_members() do
                xcvb_arena_utils.arena_spawned_combatant_ids[member.id] = true
            end
        end
    end
    if current_tournament_round_id then
        give_info("xcvb_tournament_started")
        -- Old saves did not record whether this particular fight was practice.
        if loaded_legacy_practice then
            local remaining = xcvb_arena_main.get_round_cooldown_remaining(current_tournament_category, current_tournament_round_id)
            current_tournament_is_practice = xcvb_arena_main.practice_mode_active == true or remaining ~= 0
        end
        if tournament_pending_result ~= nil then
            end_tournament_fight(tournament_pending_result)
        elseif not (tournament_enemy_squad_id and alife_object(tournament_enemy_squad_id)) then
            end_tournament_fight(false)
        else
            local sq = alife_object(tournament_enemy_squad_id)
            if sq:npc_count() <= 0 then on_tournament_victory(current_tournament_round_id) end
        end
    end
    if is_endless_mode or HI("xcvb_endless_started") then
        if resume_endless_transition or #endless_enemy_squad_ids == 0 then
            resume_endless_transition = false
            advance_endless_wave(true)
        elseif get_endless_total_enemies_alive() <= 0 then
            advance_endless_wave()
        end
    elseif xcvb_arena_utils.inventory_stored and not HI("xcvb_tournament_started") then
        xcvb_arena_utils.restore_actor_inventory()
    end
    if not HI("xcvb_tournament_started") and not HI("xcvb_endless_started") and not is_endless_mode then
        if game.only_allow_movekeys then pcall(game.only_allow_movekeys, false) end
        pcall(level.enable_input)
        pcall(level.show_indicators)
    end
    if HI("xcvb_tournament_started") and tournament_enemy_squad_id then
        xcvb_arena_utils.setup_tournament_squad_aggro(tournament_enemy_squad_id)
    end
    if HI("xcvb_endless_started") and endless_enemy_squad_ids and #endless_enemy_squad_ids > 0 then
        xcvb_arena_utils.setup_endless_squads_aggro(endless_enemy_squad_ids)
    end
    if HI("xcvb_arena_started") and not spec_fight_ending and not spectator_fight_closed then
        news_manager.send_tip(db.actor, gt("st_arena_spectator_press_f"), 0, nil, 12000)
    end
    if HI("xcvb_battle_royale_started") and not battle_royale_ending and not battle_royale_closed then
        xcvb_arena_utils.setup_battle_royale_relations(battle_royale_squad_ids)
        news_manager.send_tip(db.actor, gt("st_arena_spectator_press_f"), 0, nil, 12000)
    end
end

function on_game_start()
    if xcvb_arena_utils and xcvb_arena_utils.install_item_parts_safeguard then
        pcall(xcvb_arena_utils.install_item_parts_safeguard)
    end
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
    RegisterScriptCallback("on_enemy_eval", on_enemy_eval)
    RegisterScriptCallback("squad_on_npc_death", squad_on_npc_death)
    RegisterScriptCallback("npc_on_before_hit", npc_on_before_hit)
    RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
    RegisterScriptCallback("on_before_key_press", on_before_key_press)
    RegisterScriptCallback("on_key_release", on_key_release)
    RegisterScriptCallback("actor_on_weapon_zoom_in", actor_on_weapon_zoom_in)
    RegisterScriptCallback("actor_on_weapon_zoom_out", actor_on_weapon_zoom_out)
    RegisterScriptCallback("actor_on_hud_animation_play", actor_on_hud_animation_play)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
