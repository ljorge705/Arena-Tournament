-- MCM (Mod Configuration Menu) Settings for Arena Tournament
local defaults = {
	["random_equipment"] = true,
	["economy_mode"] = "tokens",
	["token_reward_mult"] = 1.0,
	["shop_price_mult"] = 1.0,
	["daily_cashout_limit"] = 15000,
	["rank_gating"] = true,
	["reward_mult"] = 1.0,
	["endless_reward_mult"] = 1.0,
	["endless_restricted_reward_mult"] = 0.8,
	["endless_map_swap_interval"] = 2,
	["give_items"] = true,
	["medic_rescue"] = true,
	["medic_rescue_fee"] = 2500,
	["allow_replay"] = "7d",
	["special_ammo_support"] = true,
	["rental_fee_mult"] = 1.0,
	["auto_reopen_gui"] = false,
	["panic_key"] = DIK_keys.DIK_F,
	["night_vision_base_dist"] = 24,
	["night_vision_mult"] = 1.0,
	["night_elite_nvg"] = true,
	["arena_light_mult"] = 2.8,
	["forest_light_mult"] = 1.4,
}

function get_config(key)
	local val
	if ui_mcm then
		pcall(function()
			val = ui_mcm.get("xcvb_arena/" .. key)
		end)
	end
	if val ~= nil then
		return val
	end
	if key == "economy_mode" and xcvb_arena_env and xcvb_arena_env.get_recommended_economy_mode then
		return xcvb_arena_env.get_recommended_economy_mode()
	end
	return defaults[key]
end

function on_mcm_load()
	local op = {
		id = "xcvb_arena",
		sh = true,
		gr = {
			{ id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_xcvb_arena_title", size = {512, 50}, spacing = 20 },

			-- Tournament & Economy Settings
			{ id = "economy_mode", type = "list", val = 0, def = "tokens", no_str = true,
				content = {
					{ "tokens", "ui_mcm_xcvb_arena_econ_tokens" },
					{ "classic", "ui_mcm_xcvb_arena_econ_classic" },
				}
			},
			{ id = "token_reward_mult", type = "track", val = 2, min = 0.5, max = 3.0, step = 0.1, def = 1.0 },
			{ id = "shop_price_mult", type = "track", val = 2, min = 0.5, max = 3.0, step = 0.1, def = 1.0 },
			{ id = "daily_cashout_limit", type = "track", val = 2, min = 0, max = 50000, step = 1000, def = 15000 },
			{ id = "rank_gating", type = "check", val = 1, def = true },
			{ id = "random_equipment", type = "check", val = 1, def = true },
			{ id = "reward_mult", type = "track", val = 2, min = 0.5, max = 3.0, step = 0.1, def = 1.0 },
			{ id = "give_items", type = "check", val = 1, def = true },
			{ id = "medic_rescue", type = "check", val = 1, def = true },
			{ id = "medic_rescue_fee", type = "track", val = 2, min = 0, max = 10000, step = 500, def = 2500 },
			{ id = "allow_replay", type = "list", val = 0, def = "7d", no_str = true,
				content = {
					{ "7d", "ui_mcm_xcvb_arena_replay_7d" },
					{ "3d", "ui_mcm_xcvb_arena_replay_3d" },
					{ "1d", "ui_mcm_xcvb_arena_replay_1d" },
					{ "instant", "ui_mcm_xcvb_arena_replay_instant" },
					{ "disabled", "ui_mcm_xcvb_arena_replay_disabled" },
				}
			},
			{ id = "special_ammo_support", type = "check", val = 1, def = true },
			{ id = "rental_fee_mult", type = "track", val = 2, min = 0.0, max = 3.0, step = 0.1, def = 1.0 },
			{ id = "auto_reopen_gui", type = "check", val = 1, def = false },

			{ id = "line", type = "line" },

			-- Endless Mode & Controls Settings
			{ id = "panic_key", type = "key_bind", val = 2, def = DIK_keys.DIK_F },
			{ id = "endless_reward_mult", type = "track", val = 2, min = 0.5, max = 3.0, step = 0.1, def = 1.0 },
			{ id = "endless_restricted_reward_mult", type = "track", val = 2, min = 0.1, max = 1.0, step = 0.05, def = 0.8 },
			{ id = "endless_map_swap_interval", type = "track", val = 2, min = 0, max = 20, step = 1, def = 2 },

			{ id = "line", type = "line" },

			-- Night Mode Settings
			{ id = "night_vision_base_dist", type = "track", val = 2, min = 15, max = 45, step = 1, def = 24 },
			{ id = "night_vision_mult", type = "track", val = 2, min = 0.5, max = 2.0, step = 0.05, def = 1.0 },
			{ id = "night_elite_nvg", type = "check", val = 1, def = true },

			{ id = "line", type = "line" },

			-- Lighting & Visual Settings
			{ id = "arena_light_mult", type = "track", val = 2, min = 1.0, max = 4.5, step = 0.1, def = 2.8 },
			{ id = "forest_light_mult", type = "track", val = 2, min = 0.8, max = 3.0, step = 0.1, def = 1.4 },
		}
