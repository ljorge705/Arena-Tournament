 {x=239.000000,y=-16.399235,z=121.427612},
 {x=253.500000,y=-16.399235,z=80.500000},
 {x=200.500000,y=-16.399235,z=99.500000},
 {x=230.000000,y=-16.399235,z=107.475662},
 {x=200.500000,y=-16.399235,z=80.500000},
 {x=214.536316,y=-16.399235,z=98.489403},
 {x=219.045471,y=-16.399235,z=110.629051},
 {x=203.915329,y=-16.399235,z=114.500000},
 {x=206.449661,y=-16.399235,z=98.524414},
