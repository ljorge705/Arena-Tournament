-- Fixed ceiling sources; keep references alive and limit shadowed lights near the actor.
local sources={
 {x=254.000000,y=-16.399235,z=110.500000},
 {x=239.000000,y=-16.399235,z=110.473961},
 {x=230.500000,y=-16.399235,z=93.494331},
