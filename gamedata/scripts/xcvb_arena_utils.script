local ini_rel = ini_file("creatures\\game_relations.ltx")
temporary_arena_item_ids = {}
arena_spawned_combatant_ids = {}
xcvb_arena_storage_box_id = nil
saved_equipped_slots = {}
saved_belt_items = {}
saved_actor_item_ids = {}
saved_active_slot = nil
local excluded_ammo_keywords = {
    "acid", "shock", "burn", "lightn", "grav", "chaos", "reaper", "flinch", 
    "varma", "volcano", "dragon", "explos", "ratshot", "hunter", "sucker", 
    "tri-shot", "trishot", "linked", "frag", "plus", "+", "graze", "ambush", 
    "vmax", "v-max", "soul", "flechette", "napalm", "shrapnel", "barricada", 
    "barrikada", "shatter", "38k", "quad", "bad", "verybad", "federal"
}

local function is_excluded_special_ammo(sec)
    if not sec then return true end
    local low = string.lower(sec)
    for _, kw in ipairs(excluded_ammo_keywords) do
        if string.find(low, kw, 1, true) then
            return true
        end
    end
    if string.find(low, "+", 1, true) then
        return true
    end
    return false
end

function is_artigrok_active()
    local enabled_in_mcm = xcvb_arena_mcm.get_config("special_ammo_support")
    if enabled_in_mcm == false then return false end
    
    if rawget(_G, "ballistics_utils") ~= nil or rawget(_G, "arti_ammo_utils") ~= nil or rawget(_G, "cxv_artigrok_bo") ~= nil or rawget(_G, "cxv_ammo_stats_tbl") ~= nil then
        return true
    end
    
    local ok, res = pcall(function()
        local f = ini_file("ammo\\importer.ltx")
        return f and f:section_exist("ammo_5.45x39_fmj_bad")
    end)
    if ok and res then return true end
    
    return false
end

function get_weapon_ammo(weapon_sec, ammo_type)
    if not weapon_sec then return nil end
    local ammo_class_str = ini_sys:r_string_ex(weapon_sec, "ammo_class")
    if not ammo_class_str then return nil end
    
    local ammo_list = str_explode(ammo_class_str, ",")
    local at = ammo_type or "auto"
    
    -- Special handling for ArtiGrok Ballistics
    if at == "special" and is_artigrok_active() then
        local special_candidates = {}
        for _, a_sec in ipairs(ammo_list) do
            local clean_sec = trim(a_sec)
            if ini_sys:section_exist(clean_sec) then
                local low = string.lower(clean_sec)
                if string.find(low, "bad", 1, true)
                or string.find(low, "devastator", 1, true)
                or string.find(low, "star", 1, true)
                or string.find(low, "mono", 1, true)
                or string.find(low, "+", 1, true)
                or string.find(low, "special", 1, true) then
                    table.insert(special_candidates, clean_sec)
                end
            end
        end
        if #special_candidates > 0 then
            return special_candidates[math.random(#special_candidates)]
        end
        -- Fallback if this specific weapon has no special ammo
        at = "ap"
    end
    
    local valid_ammos = {}
    for _, a_sec in ipairs(ammo_list) do
        local clean_sec = trim(a_sec)
        if ini_sys:section_exist(clean_sec) and not is_excluded_special_ammo(clean_sec) then
            table.insert(valid_ammos, clean_sec)
        end
    end
    
    -- If all ammos were excluded by filter, fall back to first non-special section
    if #valid_ammos == 0 then
        for _, a_sec in ipairs(ammo_list) do
            local clean_sec = trim(a_sec)
            if ini_sys:section_exist(clean_sec) and not is_excluded_special_ammo(clean_sec) then
                table.insert(valid_ammos, clean_sec)
            end
        end
    end
    
    if #valid_ammos == 0 then
        local clean_sec = trim(ammo_list[1])
        if ini_sys:section_exist(clean_sec) then
            table.insert(valid_ammos, clean_sec)
        else
            return nil
        end
    end
    
    if at == "auto" or at == "special" then
        return valid_ammos[1]
    end
    
    local patterns = {}
    if at == "ap" then
        patterns = { "_ap", "7h14", "dart", "_ps", "ap_slug", "sp10" }
    elseif at == "hp" then
        patterns = { "_hp", "_pmm", "_pbp", "_hydro", "_ep", "zhekan", "slug", "sp12", "ss195" }
    elseif at == "fmj" then
        patterns = { "_fmj", "_buck", "pab9", "7h1", "7.62x25_p", "sp11", "ss190" }
    end
    
    for _, pat in ipairs(patterns) do
        for _, a_sec in ipairs(valid_ammos) do
            if string.find(string.lower(a_sec), pat, 1, true) and not is_excluded_special_ammo(a_sec) then
                return a_sec
            end
        end
    end
    
    -- Fallback for requested type
    if (at == "ap" or at == "hp") and #valid_ammos > 1 then
        for i = 2, #valid_ammos do
            if not is_excluded_special_ammo(valid_ammos[i]) then
                return valid_ammos[i]
            end
        end
    end
    
    return valid_ammos[1]
end

function get_item_name(sec)
    if not sec then return "" end
    if ui_item and ui_item.get_sec_name then
        local name = ui_item.get_sec_name(sec)
        if name and name ~= "" then return name end
    end
    local inv_name = ini_sys:r_string_ex(sec, "inv_name")
    if inv_name and game and game.translate_string then
        local trans = game.translate_string(inv_name)
        if trans and trans ~= "" and trans ~= inv_name then
            return trans
        end
    end
    return sec
end

function get_item_short_name(sec)
    if not sec then return "" end
    local inv_short = ini_sys:r_string_ex(sec, "inv_name_short")
    if inv_short and game and game.translate_string then
        local trans = game.translate_string(inv_short)
        if trans and trans ~= "" and trans ~= inv_short then
            return trans
        end
    end
    return get_item_name(sec)
end

function get_weapon_special_ammos(weapon_sec)
    if not weapon_sec then return {} end
    local ammo_class_str = ini_sys:r_string_ex(weapon_sec, "ammo_class")
    if not ammo_class_str then return {} end
    
    local special_list = {}
    local seen = {}
    local ammo_list = str_explode(ammo_class_str, ",")
    for _, a_sec in ipairs(ammo_list) do
        local clean_sec = trim(a_sec)
        if ini_sys:section_exist(clean_sec) and not seen[clean_sec] then
            local low_sec = string.lower(clean_sec)
            -- Exclude old, verybad, damaged variants
            local is_old = string.find(low_sec, "verybad", 1, true) or string.find(low_sec, "_old", 1, true)
            if not is_old then
                local full_name = get_item_name(clean_sec) or ""
                local short_name = get_item_short_name(clean_sec) or ""
                local low_name = string.lower(full_name .. " " .. short_name)
                
                local name_is_old = string.find(low_name, "old ", 1, true)
                    or string.find(low_name, "damaged ", 1, true)
                    or string.find(low_name, "viejo", 1, true)
                    or string.find(low_name, "dañado", 1, true)
                    or string.find(low_name, "старый", 1, true)
                    or string.find(low_name, "поврежден", 1, true)
                    
                if not name_is_old then
                    local is_spec = false
                    
                    -- Check if it contains "+" in section or display name
                    if string.find(clean_sec, "+", 1, true)
                    or string.find(full_name, "+", 1, true)
                    or string.find(short_name, "+", 1, true) then
                        is_spec = true
                    end
                    
                    -- Check special keywords
                    if not is_spec then
                        local spec_kws = {
                            "flechette", "dragon", "devastator", "star", "grav",
                            "shock", "acid", "cor", "varma", "cluster", "firebomb",
                            "chaos", "mono", "special"
                        }
                        for _, kw in ipairs(spec_kws) do
                            if string.find(low_sec, kw, 1, true) or string.find(low_name, kw, 1, true) then
                                is_spec = true
                                break
                            end
                        end
                    end
                    
                    -- In ArtiGrok, modified _bad sections that aren't verybad
                    if not is_spec and is_artigrok_active() and string.find(low_sec, "_bad", 1, true) then
                        local inv_name = ini_sys:r_string_ex(clean_sec, "inv_name") or ""
                        if string.find(inv_name, "ammo_new_", 1, true) then
                            is_spec = true
                        end
                    end
                    
                    if is_spec then
                        seen[clean_sec] = true
                        table.insert(special_list, clean_sec)
                    end
                end
            end
        end
    end
    return special_list
end

function get_new_period()
    local hrs = level.get_time_hours()
    for i, t in ipairs(xcvb_arena_main.arena_main_t) do
        if hrs >= t.min and hrs < t.max then
            return i
        end
    end
end

function spawn_board()
    local pos = vector():set(149.2, 1.40, 70.81)
    local lvid = 40590
    local gvid = 1684
    if level and level.name and level.name() == "l05_bar" and level.vertex_id then
        local v = level.vertex_id(pos)
        if v and v < 2^32 - 1 then
            lvid = v
        end
    end
    local se_obj = alife_create("xcvb_arena_board", pos, lvid, gvid)
    if not se_obj then return end
    
    local data = utils_stpk.get_physic_data(se_obj)
    data.custom_data = [[
[collide]
ignore_static
ignore_small_objects

[logic]
cfg = scripts\arena_board_logic.ltx
]]
    utils_stpk.set_physic_data(data, se_obj)
    se_obj.angle = vector():set(0, -2.06, 0)
    return se_obj
end

function spawn_balcony()
    local pos = vector():set(140.1, -13.01, 102.2)
    local lvid = 40551
    local gvid = 1710
    if level and level.name and level.name() == "l05_bar" and level.vertex_id then
        local v = level.vertex_id(pos)
        if v and v < 2^32 - 1 then
            lvid = v
        end
    end
    local se_obj = alife_create("xcvb_arena_balcony", pos, lvid, gvid)
    if not se_obj then return end
    
    local data = utils_stpk.get_physic_data(se_obj)
    data.custom_data = [[
[collide]
ignore_static
ignore_small_objects
]]
    utils_stpk.set_physic_data(data, se_obj)
    se_obj.angle = vector():set(0, -1.5708, 0)
    return se_obj
end

function check_and_spawn_board()
    local sim = alife()
    if not sim then return end
    
    local board_found = false
    local balcony_found = false
    
    for i = 1, 65534 do
        local se = sim:object(i)
        if se then
            local sec = se:section_name()
            if sec == "xcvb_arena_board" then
                board_found = true
            elseif sec == "xcvb_arena_balcony" then
                balcony_found = true
            end
            if board_found and balcony_found then
                break
            end
        end
    end
    
    if not board_found then
        spawn_board()
    end
    if not balcony_found then
        spawn_balcony()
    end
end

function handle_removed_teams()
    for i, t in ipairs(xcvb_arena_main.arena_main_t) do
        if #t.team1 > 0 then
            local remove_teams = false
            for j, sec in ipairs(t.team1) do
                if string.find(sec, "zombied") then
                    remove_teams = true
                    break
                end
            end
            for j, sec in ipairs(t.team2) do
                if string.find(sec, "zombied") then
                    remove_teams = true
                    break
                end
            end
            if remove_teams then
                iempty_table(xcvb_arena_main.arena_main_t[i].team1)
                iempty_table(xcvb_arena_main.arena_main_t[i].team2)
                iempty_table(xcvb_arena_main.arena_main_t[i].pwrs)
            end
        end
    end
end

