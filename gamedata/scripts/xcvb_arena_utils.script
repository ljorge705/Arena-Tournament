local last_spawned_weapon_sec = nil

local function pick_valid_section(list, exclude_sec)
    if not list then return nil end
    local valid = {}
    for _, sec in ipairs(list) do
        if ini_sys:section_exist(sec) then
            table.insert(valid, sec)
        end
    end
    if #valid == 0 then return nil end
    
    math.randomseed(os.time() + (time_global() or 0) + #valid)
    
    if exclude_sec and #valid > 1 then
        local filtered = {}
        for _, sec in ipairs(valid) do
            if sec ~= exclude_sec then
                table.insert(filtered, sec)
            end
        end
        if #filtered > 0 then
            valid = filtered
        end
    end
    
    return valid[math.random(#valid)]
end

function get_available_weapons(effective_tier, loadout_class)
    local t = effective_tier or 1
    local t_data = tournament_loadouts_t[t] or tournament_loadouts_t[1]
    if not t_data then return {} end
    
    local wpn_list = t_data.weapons
    if loadout_class == "pistol" and t_data.pistols then
        wpn_list = t_data.pistols
    elseif loadout_class == "shotgun" and t_data.shotguns then
        wpn_list = t_data.shotguns
    elseif loadout_class == "rifle" and t_data.rifles then
        wpn_list = t_data.rifles
    elseif loadout_class == "smg" and t_data.smgs then
        wpn_list = t_data.smgs
    elseif loadout_class == "sniper" and t_data.snipers then
        wpn_list = t_data.snipers
    end
    
    local valid = {}
    if wpn_list then
        for _, sec in ipairs(wpn_list) do
            if ini_sys:section_exist(sec) then
                table.insert(valid, sec)
            end
        end
    end
    return valid
end

function get_loadout_effective_ammo_sec(weapon_sec, ammo_type, special_sec, tier)
    if ammo_type == "special" and special_sec and ini_sys:section_exist(special_sec) then
        return special_sec
    end
    if weapon_sec and ini_sys:section_exist(weapon_sec) then
        return get_weapon_ammo(weapon_sec, ammo_type)
    end
    local t = tier or 1
    if t < 1 then t = 1 end
    if t > 5 then t = 5 end
    local t_data = tournament_loadouts_t and (tournament_loadouts_t[t] or tournament_loadouts_t[1])
    local cand_wpn = t_data and t_data.weapons and t_data.weapons[1]
    if cand_wpn and ini_sys:section_exist(cand_wpn) then
        return get_weapon_ammo(cand_wpn, ammo_type)
    end
    return "ammo_5.45x39_fmj"
end

function get_weapon_scopes(weapon_sec)
    if not weapon_sec or not ini_sys:section_exist(weapon_sec) then return {} end
    local parent = ini_sys:r_string_ex(weapon_sec, "parent_section") or weapon_sec
    local scope_text = ini_sys:r_string_ex(parent, "scopes") or ini_sys:r_string_ex(weapon_sec, "scopes")
    if not scope_text then return {} end
    local result = {}
    for _, scope in ipairs(str_explode(scope_text, ",")) do
        local clean_scope = trim(scope)
        local child = parent .. "_" .. clean_scope
        local is_upgrade_kit = ini_sys:section_exist(clean_scope)
            and ini_sys:r_bool_ex(clean_scope, "weapon_kit", false)
        local is_scope = IsItem and IsItem("scope", clean_scope)
        if clean_scope ~= "" and (is_scope or is_upgrade_kit) and ini_sys:section_exist(child) then
            table.insert(result, clean_scope)
        end
    end
    return result
end

local function attach_arena_scope(weapon, requested_scope)
    if not (weapon and IsWeapon(nil, weapon:clsid()) and not (IsKnife and IsKnife(nil, weapon:clsid()))) then return end
    local parent = ini_sys:r_string_ex(weapon:section(), "parent_section") or weapon:section()
    if weapon:section() ~= parent then return end
    local scopes = get_weapon_scopes(parent)
    if #scopes == 0 then return end
    local scope_sec = requested_scope
    local requested_is_valid = false
    for _, candidate in ipairs(scopes) do
        if candidate == scope_sec then
            requested_is_valid = true
            break
        end
    end
    if not requested_is_valid then
        scope_sec = scopes[math.random(#scopes)]
    end
    local child_section = parent .. "_" .. scope_sec
    local scope_obj = alife_create(scope_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
    if not scope_obj then return end
    temporary_arena_item_ids[scope_obj.id] = true
    local weapon_id = weapon:id()
    local restore_slot = nil
    local was_active = false
    for _, slot in ipairs({ 1, 2, 3 }) do
        local slot_item = db.actor:item_in_slot(slot)
        if slot_item and slot_item:id() == weapon_id then
            restore_slot = slot
            was_active = db.actor:active_slot() == slot
            break
        end
    end

    local attach_attempts = 0
    CreateTimeEvent("arena_3dssg_attach", "scope_attach_" .. tostring(scope_obj.id), 0.1, function()
        attach_attempts = attach_attempts + 1
        if not db.actor or not item_weapon or not item_weapon.attach_scope then return true end
        local scope_item = nil
        local source_weapon = nil
        db.actor:iterate_inventory(function(_, item)
            if not scope_item and item and item:section() == scope_sec then
                scope_item = item
            end
            if not source_weapon and item and item:id() == weapon_id then
                source_weapon = item
            end
        end, db.actor)
        if scope_item and source_weapon then
            local ok = pcall(item_weapon.attach_scope, scope_item, source_weapon)
            if ok then
                local restore_attempts = 0
                CreateTimeEvent("arena_3dssg_restore", "scope_restore_" .. tostring(weapon_id), 0.15, function()
                    restore_attempts = restore_attempts + 1
                    if not db.actor then return true end
                    local attached_weapon = nil
                    db.actor:iterate_inventory(function(_, item)
                        if item and IsWeapon(nil, item:clsid()) then
                            if item:section() == child_section or item:id() == weapon_id then
                                attached_weapon = item
                                return true
                            end
                        end
                    end, db.actor)
                    if not attached_weapon then
                        db.actor:iterate_inventory(function(_, item)
                            if item and IsWeapon(nil, item:clsid()) and (not saved_actor_item_ids or not saved_actor_item_ids[item:id()]) then
                                attached_weapon = item
                                return true
                            end
                        end, db.actor)
                    end
                    if attached_weapon then
                        temporary_arena_item_ids[attached_weapon:id()] = true
                        pcall(function() db.actor:move_to_slot(attached_weapon, restore_slot or 2) end)
                        if was_active then
                            pcall(function() db.actor:activate_slot(restore_slot or 2) end)
                        end
                        return true
                    end
                    return restore_attempts >= 10
                end)
                return true
            end
        end
        return attach_attempts >= 10
    end)
    if se_save_var and (ini_sys:r_float_ex(scope_sec, "s3ds_image_type") or 0) > 1 then
        CreateTimeEvent("arena_3dssg_battery", "scope_battery_" .. tostring(scope_obj.id), 0.1, function()
            db.actor:iterate_inventory(function(_, item)
                local item_section = item and item:section()
                if item_section and string.find(item_section, "^" .. parent .. "_", 1) then
                    se_save_var(item:id(), nil, "3dss_thermal_battery", {
                        version = 2,
                        main = { section = scope_sec, charge = 1.0 },
                    })
                    return true
                end
            end, db.actor)
            return true
        end)
    end
end

function get_tier_preview_gear(effective_tier)
    local t = effective_tier or 1
    local t_data = tournament_loadouts_t[t] or tournament_loadouts_t[1]
    local outfit = t_data and t_data.outfits and t_data.outfits[1]
    local helmet = t_data and t_data.helmets and t_data.helmets[1]
    return outfit, helmet
end

function init_arena_box()
    if inventory_stored then return end
    if get_story_object("bar_arena_inventory_box") then return end
    if xcvb_arena_storage_box_id and alife_object(xcvb_arena_storage_box_id) then return end
    local pos = vector():set(151.9, -5.0, 68.6)
    local se = alife_create("inventory_box", pos, 40590, 1684)
    if se then
        xcvb_arena_storage_box_id = se.id
    end
end

local function get_or_create_arena_box()
    local box = get_story_object("bar_arena_inventory_box")
    if box then return box end
    
    local sim = alife()
    if sim then
        local se = sim:object("bar_arena_inventory_box")
        if se then
            local b = level.object_by_id(se.id)
            if b then return b end
        end
    end
    
    if xcvb_arena_storage_box_id then
        local b = level.object_by_id(xcvb_arena_storage_box_id)
        if b then return b end
        if inventory_stored or alife_object(xcvb_arena_storage_box_id) then return nil end
    end

    if inventory_stored then return nil end
    
    local pos = vector():set(151.9, -5.0, 68.6)
    local se = alife_create("inventory_box", pos, 40590, 1684)
    if se then
        xcvb_arena_storage_box_id = se.id
        return level.object_by_id(se.id)
    end
    return nil
end

function store_actor_inventory()
    if inventory_stored or inventory_restore_pending or not db.actor then return false end
    inventory_return_candidates = nil
    RemoveTimeEvent("arena_restore_equip_e1", "arena_restore_equip_a1")
    RemoveTimeEvent("arena_restore_equip_e2", "arena_restore_equip_a2")
    RemoveTimeEvent("arena_restore_equip_e3", "arena_restore_equip_a3")
    RemoveTimeEvent("arena_restore_equip_e4", "arena_restore_equip_a4")

    pcall(function() db.actor:activate_slot(0) end)
    for s = 1, 15 do
        local slot_itm = db.actor:item_in_slot(s)
        if slot_itm and db.actor.move_to_ruck then
            pcall(function() db.actor:move_to_ruck(slot_itm) end)
        end
    end

    local box = get_or_create_arena_box()
    if not box then
        printe("! xcvb arena: Could not find or create inventory storage box")
        return false
    end
    
    saved_equipped_slots = {}
    saved_belt_items = {}
    saved_actor_item_ids = {}
    saved_active_slot = db.actor and db.actor:active_slot()

    -- 1. Record original equipped item slots (0 to 15)
    for slot = 0, 15 do
        local itm = db.actor:item_in_slot(slot)
        if itm then
            saved_equipped_slots[itm:id()] = slot
        end
    end

    -- 2. Record items currently on belt
    if db.actor and db.actor.is_on_belt then
        db.actor:iterate_inventory(function(owner, item)
            if item and db.actor:is_on_belt(item) then
                saved_belt_items[item:id()] = true
            end
        end, db.actor)
    end

    -- 3. Gather items to store (excluding PDA, torch, bolt, quest items)
    local items_to_store = {}
    db.actor:iterate_inventory(function(owner, item)
        if not item then return end
        local sec = item:section()
        if sec == "device_pda" or string.find(sec, "device_torch") or sec == "bolt" or (IsItem and IsItem("quest", sec)) then
            return
        end
        saved_actor_item_ids[item:id()] = true
        table.insert(items_to_store, item)
    end, db.actor)
    
    -- 4. Move items to ruck first, then transfer to the arena storage box
    inventory_stored = true
    local ok, err = pcall(function()
        for _, item in ipairs(items_to_store) do
            if db.actor.move_to_ruck then db.actor:move_to_ruck(item) end
            db.actor:transfer_item(item, box)
        end
    end)
    if not ok then
        printe("! xcvb arena: Inventory transfer failed: %s", tostring(err))
        restore_actor_inventory()
        return false
    end
    return true
end

local function fill_arena_magazine(mag_id, mag_sec, ammo_sec)
    if not (mag_id and mag_sec and ammo_sec) then return end
    
    local cap = SYS_GetParam(2, mag_sec, "max_mag_size") or 30
    
    if mags_patches and mags_patches.fill_mag then
        mags_patches.fill_mag(mag_id, mag_sec, cap, ammo_sec)
    elseif magazine_binder then
        local mag_data = magazine_binder.get_mag_loaded and magazine_binder.get_mag_loaded(mag_id)
        if not mag_data and magazine_binder.create_mag_data then
            mag_data = magazine_binder.create_mag_data(mag_id, mag_sec)
        end
        if mag_data then
            mag_data.loaded = mag_data.loaded or {}
            for j = 1, cap do
                table.insert(mag_data.loaded, ammo_sec)
            end
            if magazine_binder.set_data then
                magazine_binder.set_data(mag_id, mag_data)
            end
        end
    end
    
    if magazine_binder then
        if magazine_binder.update_loadout_slots then pcall(magazine_binder.update_loadout_slots) end
        if magazine_binder.carried_mags then
            local m_data = (magazine_binder.get_mag_data and magazine_binder.get_mag_data(mag_id)) or (magazine_binder.get_data and magazine_binder.get_data(mag_id))
            if not m_data then
                local loaded_ammo = {}
                for j = 1, cap do table.insert(loaded_ammo, ammo_sec) end
                m_data = { section = mag_sec, loaded = loaded_ammo }
                magazine_binder.carried_mags[mag_id] = m_data
            end
        end
    end
end

local function spawn_and_fill_mags(wpn_sec, ammo_sec, count, wpn_id, chosen_mag_sec)
    if not (wpn_sec and ammo_sec) then return ammo_sec end
    if not (magazine_binder and magazine_binder.is_supported_weapon and magazine_binder.is_supported_weapon(wpn_sec)) then
        return ammo_sec
    end
    
    local mag_sec = chosen_mag_sec
    if not (mag_sec and ini_sys:section_exist(mag_sec)) then
        if magazine_binder.weapon_default_magazine then
            mag_sec = magazine_binder.weapon_default_magazine(wpn_sec)
        end
        if (not mag_sec) and magazine_binder.get_mags_for_weapon then
            local mags = magazine_binder.get_mags_for_weapon(wpn_sec)
            if mags and #mags > 0 then mag_sec = mags[1] end
        end
    end
    
    if not (mag_sec and ini_sys:section_exist(mag_sec)) then return ammo_sec end
    
    local mag_ammo_str = ini_sys:r_string_ex(mag_sec, "ammo_class")
    if mag_ammo_str then
        local found = false
        local mag_ammos = str_explode(mag_ammo_str, ",")
        for _, a in ipairs(mag_ammos) do
            local clean_a = trim(a)
            if clean_a == ammo_sec then
                found = true
                break
            end
        end
        if not found and #mag_ammos > 0 then
            for _, a in ipairs(mag_ammos) do
                local clean_a = trim(a)
                if not is_excluded_special_ammo(clean_a) then
                    ammo_sec = clean_a
                    found = true
                    break
                end
            end
            if not found then
                ammo_sec = trim(mag_ammos[1])
            end
        end
    end
    
    local cap = SYS_GetParam(2, mag_sec, "max_mag_size") or 30
    
    if wpn_id then
        CreateTimeEvent("arena_mags_e", "precharge_gun_" .. wpn_id, 0.4, function()
            if magazine_binder and magazine_binder.set_data then
                local loaded_rounds = {}
                for r = 1, cap do table.insert(loaded_rounds, ammo_sec) end
                magazine_binder.set_data(wpn_id, { section = mag_sec, loaded = loaded_rounds })
            end
            local w_obj = level.object_by_id(wpn_id)
            if w_obj then
                w_obj:set_ammo_elapsed(cap)
                if magazines and magazines.prep_weapon then
                    pcall(magazines.prep_weapon, w_obj)
                elseif magazine_binder and magazine_binder.prep_weapon then
                    pcall(magazine_binder.prep_weapon, w_obj)
                end
            end
            return true
        end)
    end
    
    local num_mags = count or 3
    for i = 1, num_mags do
        local se_mag = alife_create(mag_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se_mag then
            temporary_arena_item_ids[se_mag.id] = true
            if se_save_var then se_save_var(se_mag.id, se_mag:name(), "unpatched", true) end
            local m_id = se_mag.id
            local m_sec = mag_sec
            local a_sec = ammo_sec
            CreateTimeEvent("arena_mags_e", "fill_mag_" .. m_id, 0.6, function()
                fill_arena_magazine(m_id, m_sec, a_sec)
                return true
            end)
        end
    end
    
    return ammo_sec 
end

local function is_helmet_item(item)
    if not item then return false end
    local sec = item:section()
    if item.is_helmet and item:is_helmet() then return true end
    if IsItem and IsItem("helmet", sec) then return true end
    if SYS_GetParam(0, sec, "kind") == "o_helmet" then return true end
    if string.find(sec, "^helm_") then return true end
    return false
end

local function is_outfit_item(item)
    if not item then return false end
    local sec = item:section()
    if item.is_outfit and item:is_outfit() then return true end
    if IsItem and IsItem("outfit", sec) then return true end
    local kind = SYS_GetParam(0, sec, "kind")
    if kind == "o_light" or kind == "o_medium" or kind == "o_heavy" or kind == "o_sci" then return true end
    if string.find(sec, "_outfit") or string.find(sec, "_exo_") then return true end
    return false
end

local function power_up_exoskeleton(spawned_outfit_id, outfit_sec)
    if not outfit_sec then return end
    
    local is_an_exo = false
    if item_exo_device and item_exo_device.is_exo then
        local dummy = { section = function() return outfit_sec end }
        is_an_exo = item_exo_device.is_exo(dummy)
    end
    if not is_an_exo then
        is_an_exo = string.find(outfit_sec, "exo") ~= nil or string.find(outfit_sec, "nosorog") ~= nil
    end
    
    if not is_an_exo then return end
    
    local psu_candidates = { "exo_power_supply_military", "exo_power_supply_proto", "exo_power_supply_tank", "exo_power_supply_sprint", "exo_power_supply" }
    local psu_sec = nil
    for _, sec in ipairs(psu_candidates) do
        if ini_sys:section_exist(sec) then
            psu_sec = sec
            break
        end
    end
    
    local spawned_psu_id = nil
    if psu_sec then
        local se_psu = alife_create(psu_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se_psu then
            temporary_arena_item_ids[se_psu.id] = true
            spawned_psu_id = se_psu.id
        end
    end
    
    if ini_sys:section_exist("batteries_exo") then
        for i = 1, 2 do
            local se_batt = alife_create("batteries_exo", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
            if se_batt then temporary_arena_item_ids[se_batt.id] = true end
        end
    end
    
    CreateTimeEvent("arena_exo_power_e", "arena_exo_power_a", 0.4, function()
        if spawned_psu_id then
            local psu_obj = level.object_by_id(spawned_psu_id)
            if psu_obj then
                psu_obj:set_condition(1.0)
                if db.actor.move_to_slot then
                    db.actor:move_to_slot(psu_obj, 13)
                end
            end
        end
        
        db.actor:iterate_inventory(function(_, itm)
            if itm and itm:section() == "batteries_exo" and temporary_arena_item_ids[itm:id()] then
                itm:set_condition(1.0)
            end
        end, db.actor)
        
        if item_exo_device then
            if spawned_psu_id and item_exo_device.exo_device_cond then
                item_exo_device.exo_device_cond[spawned_psu_id] = 1.0
            end
            
            local o_id = spawned_outfit_id
            if not o_id then
                local cur_suit = db.actor:item_in_slot(7)
                o_id = cur_suit and cur_suit:id()
            end
            if o_id and item_exo_device.set_data then
                local exo_data = (item_exo_device.get_data and item_exo_device.get_data(o_id)) or {}
                exo_data.power = 300
                if psu_sec then
                    exo_data.supply = { name = psu_sec, drain = 0.7, max = 300 }
                end
                item_exo_device.set_data(o_id, exo_data)
            end
            
            if item_exo_device.reset_speed then pcall(item_exo_device.reset_speed) end
            if speed and speed.remove_speed then pcall(speed.remove_speed, "exo_speed") end
        end
        return true
    end)
end

function equip_tournament_random_loadout(round_tier, loadout_class, forced_tier, chosen_ammo_type, forced_weapon_sec, forced_ammo_sec, scope_mode, forced_scope_sec, forced_mag_sec, forced_mag_count, forced_ammo_count)
    local effective_tier = (forced_tier and tonumber(forced_tier) and tonumber(forced_tier) > 0) and tonumber(forced_tier) or round_tier
    local t_data = tournament_loadouts_t[effective_tier] or tournament_loadouts_t[1]
    
    local spawned_outfit_id = nil
    local spawned_helm_id = nil
    local spawned_wpn_id = nil
    
    local outfit_sec = pick_valid_section(t_data.outfits)
    if outfit_sec then
        local se = alife_create(outfit_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then
            temporary_arena_item_ids[se.id] = true
            spawned_outfit_id = se.id
            power_up_exoskeleton(se.id, outfit_sec)
        end
    end
    
    local helm_sec = pick_valid_section(t_data.helmets)
    if helm_sec then
        local se = alife_create(helm_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then
            temporary_arena_item_ids[se.id] = true
            spawned_helm_id = se.id
        end
    end
    
    local wpn_list = t_data.weapons
    if loadout_class == "pistol" and t_data.pistols then
        wpn_list = t_data.pistols
    elseif loadout_class == "shotgun" and t_data.shotguns then
        wpn_list = t_data.shotguns
    elseif loadout_class == "rifle" and t_data.rifles then
        wpn_list = t_data.rifles
    elseif loadout_class == "smg" and t_data.smgs then
        wpn_list = t_data.smgs
    elseif loadout_class == "sniper" and t_data.snipers then
        wpn_list = t_data.snipers
    end
    
    local wpn_sec = nil
    if forced_weapon_sec and ini_sys:section_exist(forced_weapon_sec) then
        wpn_sec = forced_weapon_sec
    else
        wpn_sec = pick_valid_section(wpn_list, last_spawned_weapon_sec) or pick_valid_section(t_data.weapons, last_spawned_weapon_sec)
    end
    if wpn_sec then
        last_spawned_weapon_sec = wpn_sec
        local se = alife_create(wpn_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then
            temporary_arena_item_ids[se.id] = true
            spawned_wpn_id = se.id
            
            local is_free_loadout = (loadout_class == "random" or not forced_weapon_sec)
                and (not forced_tier or tonumber(forced_tier) == 0)
                and (not chosen_ammo_type or chosen_ammo_type == "auto")
                and (not forced_ammo_sec)

            local ammo_sec = nil
            if forced_ammo_sec and ini_sys:section_exist(forced_ammo_sec) then
                ammo_sec = forced_ammo_sec
            elseif is_free_loadout or (not chosen_ammo_type or chosen_ammo_type == "auto") then
                ammo_sec = get_weapon_basic_ammo(wpn_sec)
            else
                ammo_sec = get_weapon_ammo(wpn_sec, chosen_ammo_type)
            end
            
            if ammo_sec then
                local m_cnt = tonumber(forced_mag_count)
                if not m_cnt or m_cnt < 1 or forced_mag_count == "auto" or is_free_loadout then
                    m_cnt = math.random(1, 3)
                end
                
                local actual_mag_sec = forced_mag_sec
                if is_free_loadout or not actual_mag_sec or not ini_sys:section_exist(actual_mag_sec) then
                    actual_mag_sec = get_weapon_basic_mag(wpn_sec)
                end
                
                ammo_sec = spawn_and_fill_mags(wpn_sec, ammo_sec, m_cnt, spawned_wpn_id, actual_mag_sec) or ammo_sec
                
                local count = tonumber(forced_ammo_count)
                if not count or count < 1 or forced_ammo_count == "auto" or is_free_loadout then
                    count = math.random(1, 3)
                end
                
                for i = 1, count do
                    local se_ammo = alife_create(ammo_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
                    if se_ammo then temporary_arena_item_ids[se_ammo.id] = true end
                end
            end
        end
    end
    local knife_sec = t_data.knife or "wpn_knife"
    if ini_sys:section_exist(knife_sec) then
        local se = alife_create(knife_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then temporary_arena_item_ids[se.id] = true end
    end
    
    if t_data.meds then
        for _, med_sec in ipairs(t_data.meds) do
            if ini_sys:section_exist(med_sec) then
                local se = alife_create(med_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
                if se then temporary_arena_item_ids[se.id] = true end
            end
        end
    end
    
    if t_data.grenades then
        for _, gr_sec in ipairs(t_data.grenades) do
            if ini_sys:section_exist(gr_sec) then
                local se = alife_create(gr_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
                if se then temporary_arena_item_ids[se.id] = true end
            end
        end
    end

    CreateTimeEvent("arena_equip_e1", "arena_equip_outfit_wpn", 0.3, function()
        local outfit_obj = spawned_outfit_id and level.object_by_id(spawned_outfit_id)
        if not outfit_obj then
            db.actor:iterate_inventory(function(_, itm)
                if is_outfit_item(itm) and temporary_arena_item_ids[itm:id()] then
                    outfit_obj = itm
                    return true
                end
            end, db.actor)
        end
        if outfit_obj then
            db.actor:move_to_slot(outfit_obj, 7)
        end
        
        local target_slot = (loadout_class == "pistol") and 1 or 2
        local wpn_obj = spawned_wpn_id and level.object_by_id(spawned_wpn_id)
        if not wpn_obj then
            db.actor:iterate_inventory(function(_, itm)
                if temporary_arena_item_ids[itm:id()] and IsWeapon(nil, itm:clsid()) and not (IsKnife and IsKnife(nil, itm:clsid())) then
                    wpn_obj = itm
                    return true
                end
            end, db.actor)
        end
        if wpn_obj then
            if ini_sys:line_exist(wpn_obj:section(), "slot") then
                local s = ini_sys:r_s32(wpn_obj:section(), "slot")
                if s == 1 or s == 2 then
                    target_slot = s
                end
            end
            db.actor:move_to_slot(wpn_obj, target_slot)
        end
        
        if spawned_pistol_id then
            local p_obj = level.object_by_id(spawned_pistol_id)
            if p_obj and not (IsKnife and IsKnife(nil, p_obj:clsid())) then
                db.actor:move_to_slot(p_obj, 1)
            end
        end

        db.actor:iterate_inventory(function(_, itm)
            if temporary_arena_item_ids[itm:id()] and IsKnife and IsKnife(nil, itm:clsid()) then
                db.actor:move_to_slot(itm, 0)
            end
        end, db.actor)
        
        return true
    end)

    if scope_mode and scope_mode ~= "off" then
        CreateTimeEvent("arena_equip_3dssg", "arena_equip_3dssg", 1.1, function()
            if not db.actor then return true end
            db.actor:iterate_inventory(function(_, itm)
                if temporary_arena_item_ids[itm:id()] and IsWeapon(nil, itm:clsid()) and not (IsKnife and IsKnife(nil, itm:clsid())) then
                    attach_arena_scope(itm, scope_mode == "custom" and forced_scope_sec or nil)
                end
            end, db.actor)
            return true
        end)
    end
    
    local tourn_target_slot = (loadout_class == "pistol") and 1 or 2
    CreateTimeEvent("arena_equip_draw_e1", "arena_equip_draw_a1", 0.6, function()
        if not db.actor then return true end
        local in_slot = db.actor:item_in_slot(tourn_target_slot)
        if not in_slot then
            local other_slot = (tourn_target_slot == 2) and 1 or 2
            if db.actor:item_in_slot(other_slot) then
                tourn_target_slot = other_slot
            end
        end
        db.actor:activate_slot(tourn_target_slot)
        return true
    end)
    CreateTimeEvent("arena_equip_draw_e2", "arena_equip_draw_a2", 1.0, function()
        if not db.actor then return true end
        if db.actor:active_slot() ~= tourn_target_slot then
            local in_slot = db.actor:item_in_slot(tourn_target_slot)
            if not in_slot then
                local other_slot = (tourn_target_slot == 2) and 1 or 2
                if db.actor:item_in_slot(other_slot) then
                    tourn_target_slot = other_slot
                end
            end
            db.actor:activate_slot(tourn_target_slot)
        end
        return true
    end)
    
    CreateTimeEvent("arena_equip_e2", "arena_equip_helmet", 0.5, function()
        local helm_obj = spawned_helm_id and level.object_by_id(spawned_helm_id)
        if not helm_obj then
            db.actor:iterate_inventory(function(_, itm)
                if is_helmet_item(itm) and temporary_arena_item_ids[itm:id()] then
                    helm_obj = itm
                    return true
                end
            end, db.actor)
        end
        if helm_obj then
            db.actor:move_to_slot(helm_obj, 12)
        end
        return true
    end)
    
    CreateTimeEvent("arena_equip_e3", "arena_equip_verify", 0.8, function()
        if not db.actor:item_in_slot(12) then
            local helm_obj = spawned_helm_id and level.object_by_id(spawned_helm_id)
            if not helm_obj then
                db.actor:iterate_inventory(function(_, itm)
                    if is_helmet_item(itm) and temporary_arena_item_ids[itm:id()] then
                        helm_obj = itm
                        return true
                    end
                end, db.actor)
            end
            if helm_obj then db.actor:move_to_slot(helm_obj, 12) end
        end
        return true
    end)
end

function cancel_inventory_events()
    local equip_events = {
        {"arena_inventory_retry_e", "arena_inventory_retry_a"},
        {"arena_restore_equip_e1", "arena_restore_equip_a1"},
        {"arena_restore_equip_e2", "arena_restore_equip_a2"},
        {"arena_restore_equip_e3", "arena_restore_equip_a3"},
        {"arena_restore_equip_e4", "arena_restore_equip_a4"},
        {"arena_equip_e1", "arena_equip_outfit_wpn"},
        {"arena_equip_e2", "arena_equip_helmet"},
        {"arena_equip_e3", "arena_equip_verify"},
        {"arena_equip_draw_e1", "arena_equip_draw_a1"},
        {"arena_equip_draw_e2", "arena_equip_draw_a2"},
        {"arena_equip_3dssg", "arena_equip_3dssg"},
        {"arena_equip_endless_e1", "arena_equip_endless_a1"},
        {"arena_equip_endless_e2", "arena_equip_endless_a2"},
        {"arena_equip_endless_draw_e1", "arena_equip_endless_draw_a1"},
        {"arena_equip_endless_draw_e2", "arena_equip_endless_draw_a2"},
        {"arena_equip_endless_3dssg", "arena_equip_endless_3dssg"},
    }
    for _, event in ipairs(equip_events) do RemoveTimeEvent(event[1], event[2]) end
end

function restore_actor_inventory(is_retry)
    if not inventory_stored or not db.actor then return false end
    pcall(function() db.actor:activate_slot(0) end)
    for s = 1, 15 do
        local slot_itm = db.actor:item_in_slot(s)
        if slot_itm and db.actor.move_to_ruck then
            pcall(function() db.actor:move_to_ruck(slot_itm) end)
        end
    end
    -- Never destroy rental gear or contraband before the original items are accessible.
    local box = get_or_create_arena_box()
    if not box then
        printe("! xcvb arena: Inventory restoration deferred: storage box is offline")
        if not inventory_return_candidates then
            inventory_return_candidates = {}
            db.actor:iterate_inventory(function(_, item)
                if item then inventory_return_candidates[item:id()] = true end
            end, db.actor)
        end
        if not is_retry then
            local attempts = 0
            CreateTimeEvent("arena_inventory_retry_e", "arena_inventory_retry_a", 0.5, function()
                attempts = attempts + 1
                if not inventory_stored then return true end
                return restore_actor_inventory(true) or attempts >= 20
            end)
        end
        return false
    end
    cancel_inventory_events()
    pcall(turn_off_actor_nightvision)
    for item_id, _ in pairs(temporary_arena_item_ids) do
        local se_item = alife_object(item_id)
        if se_item then
            if safe_release_manager and safe_release_manager.release then
                safe_release_manager.release({id = item_id})
            else
                alife_release(se_item)
            end
        end
    end
    temporary_arena_item_ids = {}

    local contraband_to_delete = {}
    db.actor:iterate_inventory(function(owner, item)
        if not item then return end
        -- Rewards acquired after a deferred return are not arena contraband.
        if inventory_return_candidates and not inventory_return_candidates[item:id()] then return end
        local sec = item:section()
        if sec == "device_pda" or string.find(sec, "device_torch") or sec == "bolt" or (IsItem and IsItem("quest", sec)) then
            return
        end
        if saved_actor_item_ids and saved_actor_item_ids[item:id()] then
            return
        end
        table.insert(contraband_to_delete, item:id())
    end, db.actor)

    for _, id in ipairs(contraband_to_delete) do
        local obj = level.object_by_id(id)
        if obj and db.actor and db.actor.move_to_ruck then
            pcall(function() db.actor:move_to_ruck(obj) end)
        end
        local se_item = alife_object(id)
        if se_item then
            if safe_release_manager and safe_release_manager.release then
                safe_release_manager.release({id = id})
            else
                alife_release(se_item)
            end
        end
    end

    if item_exo_device and item_exo_device.reset_speed then pcall(item_exo_device.reset_speed) end
    if speed and speed.remove_speed then pcall(speed.remove_speed, "exo_speed") end
    
    if box then
        local items_to_restore = {}
        box:iterate_inventory_box(function(b_obj, item)
            if item then table.insert(items_to_restore, item) end
        end, box)
        
        for _, item in ipairs(items_to_restore) do
            box:transfer_item(item, db.actor)
        end
    end
    inventory_stored = false
    inventory_return_candidates = nil
    restore_actor_equipped_slots()
    return true
end

function restore_actor_equipped_slots()
    inventory_restore_pending = true
    -- Stage 1 (0.4s): Outfit (slot 7) and Backpack (slot 13)
    CreateTimeEvent("arena_restore_equip_e1", "arena_restore_equip_a1", 0.4, function()
        if not db.actor then return true end
        for id, slot in pairs(saved_equipped_slots) do
            if slot == 7 or slot == 13 then
                local itm = level.object_by_id(id)
                if itm then
                    pcall(function() db.actor:move_to_slot(itm, slot) end)
                end
            end
        end
        return true
    end)

    -- Stage 2 (0.8s): Helmet (12), Patch (14), Devices (9, 10, 5, 11, 8, 4), and Belt items
    CreateTimeEvent("arena_restore_equip_e2", "arena_restore_equip_a2", 0.8, function()
        if not db.actor then return true end
        for id, slot in pairs(saved_equipped_slots) do
            if slot == 12 or slot == 14 or slot == 10 or slot == 9 or slot == 5 or slot == 11 or slot == 8 or slot == 4 then
                local itm = level.object_by_id(id)
                if itm then
                    pcall(function() db.actor:move_to_slot(itm, slot) end)
                end
            end
        end
        
        if db.actor.move_to_belt then
            for id, _ in pairs(saved_belt_items) do
                local itm = level.object_by_id(id)
                if itm then
                    pcall(function() db.actor:move_to_belt(itm) end)
                end
            end
        end
        return true
    end)

    -- Stage 3 (1.2s): Weapons (Knife 0, Pistol 1, Primary 2, Secondary 3) and activate active slot
    CreateTimeEvent("arena_restore_equip_e3", "arena_restore_equip_a3", 1.2, function()
        if not db.actor then return true end
        for id, slot in pairs(saved_equipped_slots) do
            if slot == 0 or slot == 1 or slot == 2 or slot == 3 or slot == 6 then
                local itm = level.object_by_id(id)
                if itm then
                    pcall(function() db.actor:move_to_slot(itm, slot) end)
                end
            end
        end
        
        local slot_to_act = saved_active_slot
        if (not slot_to_act) or (slot_to_act == 0 and not db.actor:item_in_slot(0)) then
            if db.actor:item_in_slot(2) then slot_to_act = 2
            elseif db.actor:item_in_slot(3) then slot_to_act = 3
            elseif db.actor:item_in_slot(1) then slot_to_act = 1
            elseif db.actor:item_in_slot(0) then slot_to_act = 0
            end
        end
        if slot_to_act then
            pcall(function() db.actor:activate_slot(slot_to_act) end)
        end
        return true
    end)

    -- Stage 4 (1.6s): Verification check and notification
    CreateTimeEvent("arena_restore_equip_e4", "arena_restore_equip_a4", 1.6, function()
        if not db.actor then return true end
        for id, slot in pairs(saved_equipped_slots) do
            if not db.actor:item_in_slot(slot) then
                local itm = level.object_by_id(id)
                if itm then
                    pcall(function() db.actor:move_to_slot(itm, slot) end)
                end
            end
        end

        if saved_active_slot and db.actor:active_slot() ~= saved_active_slot then
            pcall(function() db.actor:activate_slot(saved_active_slot) end)
        elseif db.actor:active_slot() == 0 and not db.actor:item_in_slot(0) then
            if db.actor:item_in_slot(2) then pcall(function() db.actor:activate_slot(2) end)
            elseif db.actor:item_in_slot(3) then pcall(function() db.actor:activate_slot(3) end)
            elseif db.actor:item_in_slot(1) then pcall(function() db.actor:activate_slot(1) end)
            end
        end

        saved_equipped_slots = {}
        saved_belt_items = {}
        saved_actor_item_ids = {}
        saved_active_slot = nil
        inventory_restore_pending = false

        news_manager.send_tip(db.actor, game.translate_string("st_arena_gear_restored"), 0, nil, 8000)
        return true
    end)
    return true
end

function set_teams_relation(squad_id1, squad_id2)
    local squad1 = squad_id1 and alife_object(squad_id1)
    local squad2 = squad_id2 and alife_object(squad_id2)
    if not (squad1 and squad1.commander_id and squad2 and squad2.commander_id) then return end
    
    -- Set squad-level relation
    pcall(function() squad1:set_relation(squad2, "enemy") end)
    pcall(function() squad2:set_relation(squad1, "enemy") end)
    
    -- Force individual goodwill, relations, team separation, and combat memory
    for m1 in squad1:squad_members() do
        local npc1 = level.object_by_id(m1.id)
        if npc1 and npc1:alive() then
            pcall(function() npc1:change_team(1, 1, 1) end)
            for m2 in squad2:squad_members() do
                local npc2 = level.object_by_id(m2.id)
                if npc2 and npc2:alive() then
                    pcall(function() npc2:change_team(2, 2, 2) end)
                    -- stalker <-> stalker
                    if IsStalker and IsStalker(npc1) and IsStalker(npc2) then
                        pcall(function() npc1:force_set_goodwill(-9999, npc2) end)
                        pcall(function() npc2:force_set_goodwill(-9999, npc1) end)
                        pcall(function() npc1:set_relation(game_object.enemy, npc2) end)
                        pcall(function() npc2:set_relation(game_object.enemy, npc1) end)
                        if npc1.make_enemy_visible then
                            pcall(function() npc1:make_enemy_visible(npc2) end)
                        end
                        if npc2.make_enemy_visible then
                            pcall(function() npc2:make_enemy_visible(npc1) end)
                        end
                        if npc1.register_in_combat then
                            pcall(function() npc1:register_in_combat() end)
                        end
                        if npc2.register_in_combat then
                            pcall(function() npc2:register_in_combat() end)
                        end
                    end
                    -- stalker vs monster
                    if IsStalker and IsStalker(npc1) and IsMonster and IsMonster(npc2) then
                        pcall(function() npc1:force_set_goodwill(-9999, npc2) end)
                        pcall(function() npc1:set_relation(game_object.enemy, npc2) end)
                        pcall(function() npc2:set_relation(game_object.enemy, npc1) end)
                        if npc1.make_enemy_visible then
                            pcall(function() npc1:make_enemy_visible(npc2) end)
                        end
                        if npc1.register_in_combat then
                            pcall(function() npc1:register_in_combat() end)
                        end
                        pcall(function() npc2:berserk() end)
                        pcall(function() npc2:set_custom_panic_threshold(0) end)
                        set_bloodsucker_enemy(npc2, npc1)
                    end
                    if IsStalker and IsStalker(npc2) and IsMonster and IsMonster(npc1) then
                        pcall(function() npc2:force_set_goodwill(-9999, npc1) end)
                        pcall(function() npc2:set_relation(game_object.enemy, npc1) end)
                        pcall(function() npc1:set_relation(game_object.enemy, npc2) end)
                        if npc2.make_enemy_visible then
                            pcall(function() npc2:make_enemy_visible(npc1) end)
                        end
                        if npc2.register_in_combat then
                            pcall(function() npc2:register_in_combat() end)
                        end
                        pcall(function() npc1:berserk() end)
                        pcall(function() npc1:set_custom_panic_threshold(0) end)
                        set_bloodsucker_enemy(npc1, npc2)
                    end
                    -- Mutant <-> mutant
                    if IsMonster and IsMonster(npc1) and IsMonster and IsMonster(npc2) then
                        pcall(function() npc1:set_relation(game_object.enemy, npc2) end)
                        pcall(function() npc2:set_relation(game_object.enemy, npc1) end)
                        pcall(function() npc1:force_set_goodwill(-9999, npc2) end)
                        pcall(function() npc2:force_set_goodwill(-9999, npc1) end)
                        if npc1.make_enemy_visible then
                            pcall(function() npc1:make_enemy_visible(npc2) end)
                        end
                        if npc2.make_enemy_visible then
                            pcall(function() npc2:make_enemy_visible(npc1) end)
                        end
                        if npc1.register_in_combat then
                            pcall(function() npc1:register_in_combat() end)
                        end
                        if npc2.register_in_combat then
                            pcall(function() npc2:register_in_combat() end)
                        end
                        pcall(function() npc1:berserk() end)
                        pcall(function() npc2:berserk() end)
                        pcall(function() npc1:set_custom_panic_threshold(0) end)
                        pcall(function() npc2:set_custom_panic_threshold(0) end)
                        if npc1.skip_transfer_enemy then
                            pcall(function() npc1:skip_transfer_enemy(false) end)
                        end
                        if npc2.skip_transfer_enemy then
                            pcall(function() npc2:skip_transfer_enemy(false) end)
                        end
                        set_bloodsucker_enemy(npc1, npc2)
                        set_bloodsucker_enemy(npc2, npc1)
                        if db.actor then
                            pcall(function() npc1:set_relation(game_object.neutral, db.actor) end)
                            pcall(function() npc1:force_set_goodwill(5000, db.actor) end)
                            pcall(function() npc2:set_relation(game_object.neutral, db.actor) end)
                            pcall(function() npc2:force_set_goodwill(5000, db.actor) end)
                        end
                    end
                end
            end
        end
    end
end

function set_out_restrictors(squad_id1, squad_id2)
    local squad1 = squad_id1 and alife_object(squad_id1)
    local squad2 = squad_id2 and alife_object(squad_id2)
    if not (squad1 and squad1.commander_id and squad2 and squad2.commander_id) then return end
    
    for m1 in squad1:squad_members() do
        local npc1 = level.object_by_id(m1.id)
        if npc1 and npc1:alive() then
            pcall(function() npc1:add_restrictions("bar_arena_restrictor", "") end)
        end
    end
    for m2 in squad2:squad_members() do
        local npc2 = level.object_by_id(m2.id)
        if npc2 and npc2:alive() then
            pcall(function() npc2:add_restrictions("bar_arena_restrictor", "") end)
        end
    end
end

function hit_npcs(squad_id1, squad_id2, force_wake)
    local squad1 = squad_id1 and alife_object(squad_id1)
    local squad2 = squad_id2 and alife_object(squad_id2)
    if not (squad1 and squad1.commander_id and squad2 and squad2.commander_id) then return end

    local function has_live_enemy(npc)
        local enemy = nil
        local is_alive = false
        pcall(function()
            enemy = npc:best_enemy()
            is_alive = enemy and enemy:alive() or false
        end)
        return is_alive
    end

    local function get_nearest_target(npc, enemy_squad)
        local nearest_target = nil
        local nearest_distance = nil

        for member in enemy_squad:squad_members() do
            local candidate = level.object_by_id(member.id)
            if candidate and candidate:alive() then
                if not nearest_target then
                    nearest_target = candidate
                end

                local distance = nil
                pcall(function()
                    distance = npc:position():distance_to(candidate:position())
                end)
                if distance and (not nearest_distance or distance < nearest_distance) then
                    nearest_target = candidate
                    nearest_distance = distance
                end
            end
        end

        return nearest_target
    end

    local function wake_up_squad(sq_a, sq_b)
        for m_a in sq_a:squad_members() do
            local npc_a = level.object_by_id(m_a.id)
            if npc_a and npc_a:alive() and not is_npc_wounded(npc_a) and (force_wake or not has_live_enemy(npc_a)) then
                local target = get_nearest_target(npc_a, sq_b)
                if target and not is_npc_wounded(target) then
                    xcvb_arena_utils.scr_hit(target, npc_a)
                end
            end
        end
    end

    wake_up_squad(squad1, squad2)
    wake_up_squad(squad2, squad1)
end

function force_mutant_aggro(squad_id1, squad_id2, initial_wake)
    local squad1 = squad_id1 and alife_object(squad_id1)
    local squad2 = squad_id2 and alife_object(squad_id2)
    if not (squad1 and squad1.commander_id and squad2 and squad2.commander_id) then return end

    local function has_live_enemy_in_squad(mutant, enemy_squad)
        local enemy = nil
        local is_alive = false
        pcall(function()
            enemy = mutant:best_enemy()
            if enemy and enemy:alive() and enemy:id() ~= 0 then
                if enemy_squad then
                    for member in enemy_squad:squad_members() do
                        if member.id == enemy:id() then
                            is_alive = true
                            break
                        end
                    end
                else
                    is_alive = true
                end
            end
        end)
        return is_alive
    end

    local function get_nearest_target(mutant, enemy_squad)
        local nearest = nil
        local nearest_distance = nil
        for member in enemy_squad:squad_members() do
            local candidate = level.object_by_id(member.id)
            if candidate and candidate:alive() then
                local distance = nil
                pcall(function()
                    distance = mutant:position():distance_to(candidate:position())
                end)
                if not nearest or (distance and (not nearest_distance or distance < nearest_distance)) then
                    nearest = candidate
                    nearest_distance = distance
                end
            end
        end
        return nearest
    end

    local function update_mutant(mutant, enemy_squad, team_idx)
        if not (mutant and mutant:alive() and IsMonster and IsMonster(mutant)) then return end

        pcall(function() mutant:change_team(team_idx, team_idx, team_idx) end)
        pcall(function() mutant:berserk() end)
        pcall(function() mutant:set_custom_panic_threshold(0) end)
        if mutant.skip_transfer_enemy then
            pcall(function() mutant:skip_transfer_enemy(false) end)
        end
        if db.actor then
            pcall(function() mutant:set_relation(game_object.neutral, db.actor) end)
            pcall(function() mutant:force_set_goodwill(5000, db.actor) end)
        end

        if has_live_enemy_in_squad(mutant, enemy_squad) and not initial_wake then
            return
        end

        local target = get_nearest_target(mutant, enemy_squad)
        if target then
            pcall(function() mutant:set_relation(game_object.enemy, target) end)
            pcall(function() target:set_relation(game_object.enemy, mutant) end)
            pcall(function() mutant:force_set_goodwill(-9999, target) end)
            pcall(function() target:force_set_goodwill(-9999, mutant) end)
            if mutant.make_enemy_visible then
                pcall(function() mutant:make_enemy_visible(target) end)
            end
            if target.make_enemy_visible then
                pcall(function() target:make_enemy_visible(mutant) end)
            end
            set_bloodsucker_enemy(mutant, target)
            set_bloodsucker_enemy(target, mutant)
            xcvb_arena_utils.scr_hit(target, mutant, initial_wake and 0.05 or 0.01)
            xcvb_arena_utils.scr_hit(mutant, target, initial_wake and 0.05 or 0.01)
        end
    end

    for member1 in squad1:squad_members() do
        local mutant1 = level.object_by_id(member1.id)
        if mutant1 and mutant1:alive() and IsMonster and IsMonster(mutant1) then
            update_mutant(mutant1, squad2, 1)
        end
    end

    for member2 in squad2:squad_members() do
        local mutant2 = level.object_by_id(member2.id)
        if mutant2 and mutant2:alive() and IsMonster and IsMonster(mutant2) then
            update_mutant(mutant2, squad1, 2)
        end
    end
end

function force_stalker_aggro(squad_id1, squad_id2, initial_wake)
    local squad1 = squad_id1 and alife_object(squad_id1)
    local squad2 = squad_id2 and alife_object(squad_id2)
    if not (squad1 and squad1.commander_id and squad2 and squad2.commander_id) then return end
    if not (string.find(squad1:section_name(), "stalker") and string.find(squad2:section_name(), "stalker")) then return end

    local function get_distance(first, second)
        local distance = nil
        pcall(function()
            distance = first:position():distance_to(second:position())
        end)
        return distance
    end

    local function get_nearest_stalker(stalker, enemy_squad)
        local nearest = nil
        local nearest_distance = nil
        for member in enemy_squad:squad_members() do
            local candidate = level.object_by_id(member.id)
            if candidate and candidate:alive() and not is_npc_wounded(candidate) and IsStalker and IsStalker(candidate) then
                local distance = get_distance(stalker, candidate)
                if not nearest or (distance and (not nearest_distance or distance < nearest_distance)) then
                    nearest = candidate
                    nearest_distance = distance
                end
            end
        end
        return nearest, nearest_distance
    end

    local function update_stalker(stalker, enemy_squad, team_idx)
        if not (stalker and stalker:alive() and IsStalker and IsStalker(stalker)) then return end
        if is_npc_wounded(stalker) then return end

        pcall(function() stalker:change_team(team_idx, team_idx, team_idx) end)
        pcall(function() stalker:set_mental_state(anim.danger) end)

        pcall(function() stalker:set_custom_panic_threshold(0.05) end)

        local current_enemy = nil
        pcall(function()
            current_enemy = stalker:best_enemy()
        end)

        local target, target_distance = get_nearest_stalker(stalker, enemy_squad)
        if not target then return end
        local current_distance = current_enemy and current_enemy:alive() and get_distance(stalker, current_enemy) or nil
        local current_is_valid = current_enemy and current_enemy:alive() and current_enemy:id() ~= stalker:id()
        local target_changed = not current_is_valid

        -- Do not interrupt aiming every update. Switch only when the current
        -- target is gone or another enemy is clearly closer.
        if current_is_valid and current_enemy:id() ~= target:id() then
            target_changed = target_distance and current_distance and target_distance < current_distance * 0.65
            if not target_changed then
                target = current_enemy
            end
        end

        if not target_changed and not initial_wake then
            return
        end

        if stalker.make_enemy_visible then
            pcall(function() stalker:make_enemy_visible(target) end)
        end
        pcall(function() stalker:force_set_goodwill(-9999, target) end)
        pcall(function() stalker:set_relation(game_object.enemy, target) end)
        if target_changed and stalker.register_in_combat then
            pcall(function() stalker:register_in_combat() end)
        end
        if target_changed then
            pcall(function() stalker:set_sight(look.fire_point, target:position()) end)
        end

        if initial_wake or target_changed then
            xcvb_arena_utils.scr_hit(target, stalker, initial_wake and 0.01 or 0.001)
        end
    end

    for member1 in squad1:squad_members() do
        local stalker1 = level.object_by_id(member1.id)
        if stalker1 and stalker1:alive() and not is_npc_wounded(stalker1) and IsStalker and IsStalker(stalker1) then
            update_stalker(stalker1, squad2, 1)
        end
    end

    for member2 in squad2:squad_members() do
        local stalker2 = level.object_by_id(member2.id)
        if stalker2 and stalker2:alive() and not is_npc_wounded(stalker2) and IsStalker and IsStalker(stalker2) then
            update_stalker(stalker2, squad1, 2)
        end
    end
end

function is_npc_wounded(npc)
    if not (npc and npc:alive()) then return false end
    -- Anomaly's IsStalker includes script_actor/actor as well as human NPCs.
    local npc_id = npc:id()
    if npc_id == 0 or (db and db.actor and npc_id == db.actor:id()) then return false end
    -- Wounded AI queries do not support the actor or mutants, even though
    -- their Lua objects expose the same method names.
    if not (IsStalker and IsStalker(npc)) then return false end
    local wounded = false
    pcall(function()
        if IsWounded and IsWounded(npc) then
            wounded = true
            return
        end
        if xr_wounded then
            if xr_wounded.is_wounded and xr_wounded.is_wounded(npc) then
                wounded = true
                return
            end
            if xr_wounded.is_heavy_wounded and xr_wounded.is_heavy_wounded(npc:id()) then
                wounded = true
                return
            end
            if xr_wounded.is_psy_wounded and xr_wounded.is_psy_wounded(npc:id()) then
                wounded = true
                return
            end
        end
        if npc.critically_wounded and npc:critically_wounded() then
            wounded = true
            return
        end
        local hp = npc.health or (npc.GetHealth and npc:GetHealth())
        if hp and hp <= 0.15 then
            wounded = true
            return
        end
    end)
    return wounded
end

function scr_hit(npc, who, power)
    if not (npc and who) then return end
    if is_npc_wounded(who) or is_npc_wounded(npc) then return end
    local h = hit()
    -- hit.wound despierta la IA
    h.type = hit.wound
    h.power = power or 0.001
    h.impulse = 0
    local dir = vector():set(0, 0, 1)
    pcall(function()
        dir = vector():sub(who:position(), npc:position()):normalize()
    end)
    h.direction = dir
    h.draftsman = npc
    who:hit(h)
end

local orig_get_script_target = sim_squad_scripted.sim_squad_scripted.get_script_target
function sim_squad_scripted.sim_squad_scripted.get_script_target(self)
    if self.scripted_target then
        if self.scripted_target == "actor" or self.scripted_target == 0 then
            return 0
        end
        local new_id = tonumber(self.scripted_target)
        if new_id then return new_id end
    end
    
    local sec = self:section_name()
    if sec and string.find(sec, "arena_") then
        return self.id
    end
    
    if orig_get_script_target then
        return orig_get_script_target(self)
    end
end

--------------------------------------------------------------------------------
-- BATALLA CAMPAL (MULTIBANDO) HELPERS
--------------------------------------------------------------------------------

function get_safe_arena_lvid(pos, fallback_lvid)
    local def_lvid = fallback_lvid or 40551
    if level and level.vertex_id then
        local ok, v = pcall(level.vertex_id, pos)
        if ok and v and v > 0 and v < 4294967295 then
            return v
        end
    end
    return def_lvid
end

function get_battle_royale_pos(team_idx, total_teams)
    local pos
    if total_teams == 3 then
        if team_idx == 1 then
            pos = vector():set(151.2, -20.0543, 126.0)
        elseif team_idx == 2 then
            pos = vector():set(144.0, -20.0598, 88.0)
        else
            pos = vector():set(160.0, -20.0598, 88.0)
        end
    else
        if team_idx == 1 then
            pos = vector():set(144.0, -20.0543, 122.0)
        elseif team_idx == 2 then
            pos = vector():set(160.0, -20.0543, 122.0)
        elseif team_idx == 3 then
            pos = vector():set(144.0, -20.0598, 88.0)
        else
            pos = vector():set(160.0, -20.0598, 88.0)
        end
    end
    local lvid = (team_idx <= 2) and 40551 or 40761
    local gvid = (team_idx <= 2) and 1796 or 1684
    lvid = get_safe_arena_lvid(pos, lvid)
    return pos, lvid, gvid
end

