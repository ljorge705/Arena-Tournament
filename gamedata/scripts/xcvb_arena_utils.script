local function pick_valid_mutant_sec(sec_list, fallback_sec)
    if sec_list then
        for _, s in ipairs(sec_list) do
            if ini_sys and ini_sys:section_exist(s) then
                return s
            end
        end
    end
    if fallback_sec and ini_sys and ini_sys:section_exist(fallback_sec) then
        return fallback_sec
    end
    return (sec_list and sec_list[1]) or fallback_sec or "snork_normal"
end

function get_squad_for_mutant(mut_key)
    local key = mut_key or "snork"
    local def = mutant_species_defs[key]
    if not def then
        def = mutant_species_defs["snork"]
        key = "snork"
    end

    local secs = {}
    local pwr = def.power or 6
    local base_cnt = def.base_count or 3

    for i = 1, base_cnt do
        local rand_sec = def.sections[math.random(1, #def.sections)]
        local chosen = pick_valid_mutant_sec({ rand_sec }, def.sections[1])
        secs[#secs + 1] = chosen
    end

    if def.support_sections and def.support_count then
        for i = 1, def.support_count do
            local rand_sec = def.support_sections[math.random(1, #def.support_sections)]
            local chosen = pick_valid_mutant_sec({ rand_sec }, def.support_sections[1])
            secs[#secs + 1] = chosen
        end
    end

    return secs, pwr, key
end

function get_squad_for_faction(fac_key, amount)
    local amt = amount or 3
    if mutant_species_defs[fac_key] then
        return get_squad_for_mutant(fac_key)
    end
    if fac_key == "mutant" then
        local t, p = get_mutant_team(amt)
        if not t or #t == 0 then
            t = { "snork_normal", "snork_normal", "boar_normal" }
            p = 10
        end
        return t, p, "mutant"
    end
    
    local k = fac_key or "stalker"
    if k == "duty" then k = "dolg" end
    if k == "military" then k = "army" end
    
    local ranks = stalkers_t[k] or stalkers_t["stalker"]
    local ret_ar = {}
    local pwr = 0
    for i = 1, amt do
        local rank_val = ranks[math.random(1, #ranks)]
        local sec_fac = k
        if k == "army" then sec_fac = "military" elseif k == "dolg" then sec_fac = "duty" end
        local sec = "sim_default_" .. sec_fac .. "_" .. rank_val
        ret_ar[#ret_ar + 1] = sec
        pwr = pwr + (stalkers_power_t[rank_val] or 3)
    end
    return ret_ar, pwr, k
end

function update_battle_royale_targets(squads)
    local target_squad_by_id = {}
    for squad_id, _ in pairs(squads) do
        local squad = alife_object(squad_id)
        if squad then
            for member in squad:squad_members() do
                target_squad_by_id[member.id] = squad_id
            end
        end
    end

    for own_squad_id, _ in pairs(squads) do
        local own_squad = alife_object(own_squad_id)
        if own_squad then
            for member in own_squad:squad_members() do
                local npc = level.object_by_id(member.id)
                if npc and npc:alive() and not is_npc_wounded(npc) then
                    local enemy = nil
                    pcall(function() enemy = npc:best_enemy() end)
                    local enemy_squad_id = enemy and target_squad_by_id[enemy:id()]
                    if enemy and (not enemy:alive() or not enemy_squad_id or enemy_squad_id == own_squad_id) then
                        if npc.clear_enemy then
                            pcall(function() npc:clear_enemy() end)
                        end
                    end
                end
            end
        end
    end
end

function ensure_npc_combat_loadout(npc)
    if not (npc and IsStalker and IsStalker(npc)) then return end
    local weapons = {}
    npc:iterate_inventory(function(owner, item)
        if item and IsWeapon and IsWeapon(nil, item:clsid()) then
            table.insert(weapons, item)
        end
    end, npc)
    if #weapons == 0 then return end

    for _, wpn in ipairs(weapons) do
        local sec = wpn:section()
        local mag_size = (ini_sys:r_u32(sec, "ammo_mag_size")) or 30
        pcall(function()
            if wpn:get_ammo_in_magazine() < mag_size then
                wpn:set_ammo_elapsed(mag_size)
            end
        end)
        local ammo_sec = get_weapon_ammo(sec, "auto")
        if ammo_sec and ini_sys:section_exist(ammo_sec) then
            if magazine_binder and magazine_binder.is_supported_weapon and magazine_binder.is_supported_weapon(sec) then
                pcall(spawn_and_fill_mags, sec, ammo_sec, 3, wpn:id())
            end
            for _ = 1, 8 do
                alife_create_item(ammo_sec, npc)
            end
        end
    end
end

function ensure_battle_royale_ammo(npc)
    ensure_npc_combat_loadout(npc)
end

function protect_battle_royale_spectator(npc)
    if not (npc and db.actor) then return end
    pcall(function() npc:set_relation(game_object.neutral, db.actor) end)
    pcall(function() npc:force_set_goodwill(5000, db.actor) end)
    if IsStalker and IsStalker(npc) then
        if npc.clear_enemy then
            pcall(function() npc:clear_enemy() end)
        end
    end
end

local br_relation_members = {}
local br_relation_squads = {}
local br_relation_refresh_at = 0

function reset_battle_royale_relations()
    br_relation_members, br_relation_squads = {}, {}
    br_relation_refresh_at = 0
end

function setup_battle_royale_relations(squad_ids)
    if not squad_ids then return end
    local squads = {}
    local squad_lookup = {}
    local alive_indices = {}
    local members = {}
    
    -- Filtrar solo escuadrones con combatientes vivos. npc_count() puede
    -- conservar miembros muertos durante varios frames tras el callback.
    for idx, sq_id in pairs(squad_ids) do
        local sq = sq_id and alife_object(sq_id)
        local live_count = 0
        if sq then
            for member in sq:squad_members() do
                local npc = level.object_by_id(member.id)
                if not npc or npc:alive() then
                    live_count = live_count + 1
                    if npc then members[member.id] = npc end
                end
            end
        end
        if sq and live_count > 0 then
            squads[idx] = sq
            squad_lookup[sq.id] = true
            table.insert(alive_indices, idx)
        end
    end
    
    local total_alive = #alive_indices
    if total_alive == 0 then return end

    local now = time_global()
    local changed = now >= br_relation_refresh_at
    for id, _ in pairs(members) do
        if not br_relation_members[id] then changed = true end
    end
    for id in pairs(br_relation_members) do
        if not members[id] then changed = true end
    end
    for idx, sq in pairs(squads) do
        if br_relation_squads[idx] ~= sq.id then changed = true end
    end
    for idx in pairs(br_relation_squads) do
        if not squads[idx] then changed = true end
    end

    update_battle_royale_targets(squad_lookup)
    if not changed then return end

    local new_mem_set = {}
    for id in pairs(members) do new_mem_set[id] = true end
    local new_sq_set = {}
    for idx, sq in pairs(squads) do new_sq_set[idx] = sq.id end
    br_relation_members, br_relation_squads = new_mem_set, new_sq_set
    br_relation_refresh_at = now + 15000
    table.sort(alive_indices)
    
    -- Reconectar el ciclo de agresión ignorando equipos muertos
    for i, idx in ipairs(alive_indices) do
        local sq = squads[idx]
        local next_i = (i % total_alive) + 1
        local next_idx = alive_indices[next_i]
        local next_target = squads[next_idx]
        
        if next_target and next_target.id ~= sq.id then
            sq.scripted_target = next_target.id
            sq.assigned_target_id = next_target.id
        end
        -- Keep the squad inside the arena and moving toward the current enemy team.
        -- Individual NPCs still select their own visible targets and cover.
        sq.rush_to_target = true
    end

    for _, i in ipairs(alive_indices) do
        local sq_i = squads[i]
        for _, j in ipairs(alive_indices) do
            if i ~= j then
                local sq_j = squads[j]
                pcall(function() sq_i:set_relation(sq_j, "enemy") end)
            end
        end
    end
    
    -- Se optimiza sacando la actualización fuera del loop anidado

    for _, i in ipairs(alive_indices) do
        local sq_i = squads[i]
        for m_i in sq_i:squad_members() do
            local npc_i = level.object_by_id(m_i.id)
            if npc_i and npc_i:alive() then
                local needs_initialization = not xcvb_arena_fight
                    or not xcvb_arena_fight.is_battle_royale_npc_initialized
                    or not xcvb_arena_fight.is_battle_royale_npc_initialized(npc_i:id())
                if needs_initialization then
                    pcall(function() npc_i:change_team(i, i, i) end)
                    pcall(function() npc_i:add_restrictions("bar_arena_restrictor", "") end)
                end
                if db.actor then
                    protect_battle_royale_spectator(npc_i)
                end
                -- Keep combat state active continuously (especially when 2 teams remain)
                if IsMonster and IsMonster(npc_i) then
                    pcall(function() npc_i:berserk() end)
                    pcall(function() npc_i:set_custom_panic_threshold(0) end)
                elseif IsStalker and IsStalker(npc_i) then
                    pcall(function() npc_i:set_mental_state(anim.danger) end)
                    pcall(function() npc_i:set_custom_panic_threshold(0.05) end)
                    ensure_npc_combat_loadout(npc_i)
                    if npc_i.register_in_combat then
                        pcall(function() npc_i:register_in_combat() end)
                    end
                end
                if needs_initialization and xcvb_arena_fight and xcvb_arena_fight.mark_battle_royale_npc_initialized then
                    xcvb_arena_fight.mark_battle_royale_npc_initialized(npc_i:id())
                end
                for _, j in ipairs(alive_indices) do
                    if i ~= j then
                        local sq_j = squads[j]
                        for m_j in sq_j:squad_members() do
                            local npc_j = level.object_by_id(m_j.id)
                            if npc_j and npc_j:alive() then
                                pcall(function() npc_i:force_set_goodwill(-9999, npc_j) end)
                                pcall(function() npc_i:set_relation(game_object.enemy, npc_j) end)
                            end
                        end
                    end
                end
            end
        end
    end
end

