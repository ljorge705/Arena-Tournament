local endless_mutant_sections_by_tier = {
    [1] = { "tushkano_normal", "dog_weak_red", "dog_normal_white", "flesh_weak", "cat_weak" },
    [2] = { "dog_strong_black", "pseudodog_normal", "boar_normal", "snork_weak", "flesh_normal" },
    [3] = { "snork_normal", "bloodsucker_normal", "psysucker_weak", "boar_strong", "fracture_normal" },
    [4] = { "bloodsucker_strong", "burer_normal", "psysucker_normal", "snork_strong", "chimera_weak" },
    [5] = { "chimera_normal", "gigant_normal", "burer_strong", "bloodsucker_strong" },
}

local endless_enemy_factions = { "bandit", "renegade", "killer", "army", "dolg", "freedom", "zombied" }

local endless_forbidden_factions = {
    ["monolith"] = true,
    ["greh"] = true,
    ["sin"] = true,
    ["isg"] = true,
}

local endless_north_spawn_zones = {
    -- North Center Gate & Approach
    { pos = vector():set(151.2, -20.0543, 128.0), fallback_lvid = 40551, gvid = 1796 }, -- North Center Gate
    { pos = vector():set(151.2, -20.0543, 126.0), fallback_lvid = 40551, gvid = 1796 }, -- North Center Approach
    { pos = vector():set(148.0, -20.0543, 126.5), fallback_lvid = 40551, gvid = 1796 }, -- North West Gate
    { pos = vector():set(154.5, -20.0543, 126.5), fallback_lvid = 40551, gvid = 1796 }, -- North East Gate
    -- North Flanks & Corners
    { pos = vector():set(145.5, -20.0543, 123.0), fallback_lvid = 40551, gvid = 1796 }, -- North West Flank
    { pos = vector():set(158.5, -20.0543, 123.0), fallback_lvid = 40551, gvid = 1796 }, -- North East Flank
    { pos = vector():set(144.0, -20.0543, 122.0), fallback_lvid = 40551, gvid = 1796 }, -- North West Corner
    { pos = vector():set(160.0, -20.0543, 122.0), fallback_lvid = 40551, gvid = 1796 }, -- North East Corner
}

local endless_south_spawn_zones = {
    -- South Center Gate & Approach
    { pos = vector():set(152.6, -20.0598, 81.5), fallback_lvid = 40761, gvid = 1684 }, -- South Center Gate
    { pos = vector():set(152.6, -20.0598, 84.0), fallback_lvid = 40761, gvid = 1684 }, -- South Center Approach
    { pos = vector():set(149.0, -20.0598, 83.5), fallback_lvid = 40761, gvid = 1684 }, -- South West Gate
    { pos = vector():set(156.0, -20.0598, 83.5), fallback_lvid = 40761, gvid = 1684 }, -- South East Gate
    -- South Flanks & Corners
    { pos = vector():set(145.5, -20.0598, 87.0), fallback_lvid = 40761, gvid = 1684 }, -- South West Flank
    { pos = vector():set(158.5, -20.0598, 87.0), fallback_lvid = 40761, gvid = 1684 }, -- South East Flank
    { pos = vector():set(144.0, -20.0598, 88.0), fallback_lvid = 40761, gvid = 1684 }, -- South West Corner
    { pos = vector():set(160.0, -20.0598, 88.0), fallback_lvid = 40761, gvid = 1684 }, -- South East Corner
}

local function get_safe_endless_spawn_positions(num_enemies)
    local n_req = math.max(1, num_enemies or 1)
    local actor_pos = nil
    if db.actor and db.actor:alive() then
        pcall(function() actor_pos = db.actor:position() end)
    end
    if not actor_pos then
        actor_pos = vector():set(152.6, -20.0598, 81.2)
    end

    -- Centro de la arena en Z es ~105.0. Portón norte ~128.0, portón sur ~81.2.
    -- Determinamos si el jugador está más cerca del sur o del norte para spawnear en el lado opuesto (más lejano)
    local dist_to_north = math.abs(126.0 - actor_pos.z)
    local dist_to_south = math.abs(actor_pos.z - 83.5)

    local primary_zones = (dist_to_north >= dist_to_south) and endless_north_spawn_zones or endless_south_spawn_zones
    local backup_zones  = (dist_to_north >= dist_to_south) and endless_south_spawn_zones or endless_north_spawn_zones

    local MIN_SAFE_DIST = 18.0 -- Distancia mínima absoluta en metros respecto al jugador

    local function evaluate_pool(pool)
        local candidates = {}
        for _, z in ipairs(pool) do
            local d = 0
            pcall(function() d = actor_pos:distance_to(z.pos) end)
            table.insert(candidates, { zone = z, dist = d })
        end
        table.sort(candidates, function(a, b) return a.dist > b.dist end)
        return candidates
    end

    local prim_eval = evaluate_pool(primary_zones)
    local safe_zones = {}

    for _, c in ipairs(prim_eval) do
        if c.dist >= MIN_SAFE_DIST then
            table.insert(safe_zones, c.zone)
        end
    end

    -- Si la piscina primaria no tiene suficientes puntos sobre la distancia mínima, comprobar el respaldo
    if #safe_zones < n_req then
        local back_eval = evaluate_pool(backup_zones)
        for _, c in ipairs(back_eval) do
            if c.dist >= MIN_SAFE_DIST then
                table.insert(safe_zones, c.zone)
            end
        end
    end

    -- Respaldo de seguridad: si por algún motivo no hay zonas que cumplan la cota, usar las más lejanas de la primaria
    if #safe_zones == 0 then
        for _, c in ipairs(prim_eval) do
            table.insert(safe_zones, c.zone)
        end
    end

    -- Barajar las zonas seguras para distribuir enemigos entre distintos portones y flancos
    for i = #safe_zones, 2, -1 do
        local j = math.random(i)
        safe_zones[i], safe_zones[j] = safe_zones[j], safe_zones[i]
    end

    local positions = {}
    for i = 1, n_req do
        local zone = safe_zones[((i - 1) % #safe_zones) + 1]
        local ox = (math.random() * 1.0) - 0.5
        local oz = (math.random() * 1.0) - 0.5
        local p = vector():set(zone.pos.x + ox, zone.pos.y, zone.pos.z + oz)
        local lvid = get_safe_arena_lvid(p, zone.fallback_lvid)
        local gvid = zone.gvid
        table.insert(positions, { pos = p, lvid = lvid, gvid = gvid })
    end

    return positions
end

function get_random_endless_spawn_pos(prefer_idx)
    local positions = get_safe_endless_spawn_positions(1)
    if positions and positions[1] then
        return positions[1].pos, positions[1].lvid, positions[1].gvid
    end
    local p = vector():set(151.2, -20.0543, 128.0)
    return p, 40551, 1796
end

function spawn_endless_squad(wave, enemy_type, difficulty)

    local cur_wave = wave or 1
    local e_type = enemy_type or "stalkers"
    if e_type == "random" then
        e_type = "stalkers"
    end
    local diff = difficulty or (xcvb_arena_main and xcvb_arena_main.endless_difficulty) or "medium"
    
    local tier = 1
    local num_enemies = cur_wave

    if diff == "easy" then
        -- Facil: Progression is gentler, fewer enemies
        if cur_wave >= 13 then
            tier = 5
        elseif cur_wave >= 10 then
            tier = 4
        elseif cur_wave >= 7 then
            tier = 3
        elseif cur_wave >= 4 then
            tier = 2
        else
            tier = 1
        end
        num_enemies = math.min(4, math.max(1, math.ceil(cur_wave * 0.6)))
    elseif diff == "hard" then
        -- Dificil: Faster tier progression, more enemies (up to 8)
        if cur_wave >= 6 then
            tier = 5
        elseif cur_wave >= 4 then
            tier = 4
        elseif cur_wave >= 2 then
            tier = 3
        else
            tier = 2
        end
        num_enemies = math.min(8, cur_wave + 1)
    else -- "medium" (Intermedio)
        -- Intermedio: Standard progression
        if cur_wave >= 9 then
            tier = 5
        elseif cur_wave >= 7 then
            tier = 4
        elseif cur_wave >= 5 then
            tier = 3
        elseif cur_wave >= 3 then
            tier = 2
        else
            tier = 1
        end
        num_enemies = math.min(6, cur_wave)
    end
    
    local a_fac = get_actor_faction()
    local rank = math.max(0, math.min(4, tier - 1))
    if diff == "easy" then
        rank = math.max(0, math.min(2, tier - 1))
    elseif diff == "hard" then
        rank = math.max(1, math.min(4, tier))
    end
    
    local spawn_points = get_safe_endless_spawn_positions(num_enemies)

    local wave_fac = nil
    if e_type == "stalkers" then
        local fac_candidates = {}
        for _, f in ipairs(endless_enemy_factions) do
            if is_enemy_to_actor(f, a_fac) and not endless_forbidden_factions[f] then
                table.insert(fac_candidates, f)
            end
        end
        wave_fac = (#fac_candidates > 0) and fac_candidates[math.random(#fac_candidates)] or "bandit"
    end

    local spawned_squads = {}

    for i = 1, num_enemies do
        local sec = nil
        local choose_mutant = (e_type == "mutants") or (e_type == "chaos" and (math.random(1, 2) == 1))
        
        if choose_mutant then
            local m_list = endless_mutant_sections_by_tier[tier] or endless_mutant_sections_by_tier[1]
            sec = pick_valid_section(m_list)
        else
            local chosen_fac = wave_fac
            if not chosen_fac then
                local fac_candidates = {}
                for _, f in ipairs(endless_enemy_factions) do
                    if is_enemy_to_actor(f, a_fac) and not endless_forbidden_factions[f] then
                        table.insert(fac_candidates, f)
                    end
                end
                chosen_fac = (#fac_candidates > 0) and fac_candidates[math.random(#fac_candidates)] or "bandit"
            end
            local cand_sec = "sim_default_" .. chosen_fac .. "_" .. rank
            if chosen_fac == "army" and ini_sys:section_exist("sim_default_military_" .. rank) then
                cand_sec = "sim_default_military_" .. rank
            elseif chosen_fac == "dolg" and ini_sys:section_exist("sim_default_duty_" .. rank) then
                cand_sec = "sim_default_duty_" .. rank
            end
            if ini_sys:section_exist(cand_sec) then
                sec = cand_sec
            else
                sec = "sim_default_bandit_" .. rank
            end
        end
        
        if sec and ini_sys:section_exist(sec) then
            local sp = spawn_points[i] or spawn_points[1]
            local m_pos, m_lvid, m_gvid = sp.pos, sp.lvid, sp.gvid
            
            local is_m = choose_mutant or (sec and not string.find(sec, "^sim_default_"))
            local squad_sec = is_m and "arena_tournament_mutant_squad" or "arena_tournament_enemy_squad"
            
            -- Cada combatiente se crea en su propio escuadron independiente para que no corran a reagruparse hacia un lado
            local sq = alife_create(squad_sec, m_pos, m_lvid, m_gvid)
            if sq then
                sq.scripted_target = "actor"
                sq.assigned_target_id = 0
                sq.rush_to_target = not (xcvb_arena_main.night_mode_active == true)
                sq:add_squad_member(sec, m_pos, m_lvid, m_gvid)
                sq:set_squad_relation()
                sq:refresh()
                for m in sq:squad_members() do
                    arena_spawned_combatant_ids[m.id] = true
                end
                table.insert(spawned_squads, sq)
            end
        end
    end
    
    return spawned_squads
end

function equip_endless_random_loadout(wave, difficulty, use_3dssg)
    local cur_wave = wave or 1
    local diff = difficulty or (xcvb_arena_main and xcvb_arena_main.endless_difficulty) or "medium"
    
    if db.actor then
        pcall(function() db.actor:activate_slot(0) end)
        for s = 1, 15 do
            local slot_itm = db.actor:item_in_slot(s)
            if slot_itm and db.actor.move_to_ruck then
                pcall(function() db.actor:move_to_ruck(slot_itm) end)
            end
        end
        db.actor:iterate_inventory(function(owner, item)
            if not item then return end
            if IsWeapon(nil, item:clsid()) then
                pcall(function() item:set_ammo_elapsed(0) end)
                if magazine_binder and magazine_binder.set_data then
                    pcall(magazine_binder.set_data, item:id(), nil)
                end
            end
        end, db.actor)
    end

    -- 2. Release all previously recorded temporary arena items (except night device if night mode is active)
    local kept_temp_items = {}
    for item_id, _ in pairs(temporary_arena_item_ids) do
        local se_item = alife_object(item_id)
        if se_item then
            local sec = se_item:section_name()
            if xcvb_arena_main.night_mode_active and sec and string.find(sec, "^device_torch") then
                kept_temp_items[item_id] = true
            else
                if safe_release_manager and safe_release_manager.release then
                    safe_release_manager.release({ id = item_id })
                else
                    alife_release(se_item)
                end
            end
        end
    end
    temporary_arena_item_ids = kept_temp_items

    -- 3. Sweep actor inventory and purge all remaining arena items (loose ammo, magazines, weapons, outfits, helmets, meds, loot)
    if db.actor then
        local leftover_arena_items = {}
        db.actor:iterate_inventory(function(owner, item)
            if not item then return end
            local sec = item:section()
            -- Never touch essential actor items or quest items
            if sec == "device_pda" or string.find(sec, "device_torch") or sec == "bolt" or (IsItem and IsItem("quest", sec)) then
                return
            end
            -- Never touch original actor items stored in the arena box
            if saved_actor_item_ids and saved_actor_item_ids[item:id()] then
                return
            end
            table.insert(leftover_arena_items, item:id())
        end, db.actor)

        for _, id in ipairs(leftover_arena_items) do
            local se_item = alife_object(id)
            if se_item then
                if safe_release_manager and safe_release_manager.release then
                    safe_release_manager.release({ id = id })
                else
                    alife_release(se_item)
                end
            end
        end
    end
    
    local tier = 1
    if diff == "easy" then
        if cur_wave >= 6 then
            tier = 5
        elseif cur_wave >= 4 then
            tier = 4
        elseif cur_wave >= 3 then
            tier = 3
        elseif cur_wave >= 2 then
            tier = 2
        end
    else
        if cur_wave >= 8 then
            tier = 5
        elseif cur_wave >= 6 then
            tier = 4
        elseif cur_wave >= 4 then
            tier = 3
        elseif cur_wave >= 2 then
            tier = 2
        end
    end
    
    local t_data = tournament_loadouts_t[tier] or tournament_loadouts_t[1]
    
    local spawned_outfit_id = nil
    local spawned_helm_id = nil
    local outfit_sec = pick_valid_section(t_data.outfits)
    if outfit_sec then
        local se = alife_create(outfit_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then
            temporary_arena_item_ids[se.id] = true
            spawned_outfit_id = se.id
            power_up_exoskeleton(se.id, outfit_sec)
        end
    end
    
    local helm_sec = pick_valid_section(t_data.helmets)
    if helm_sec then
        local se = alife_create(helm_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then
            temporary_arena_item_ids[se.id] = true
            spawned_helm_id = se.id
        end
    end
    
    local classes = { "shotgun", "rifle", "smg", "sniper" }
    if tier == 1 then table.insert(classes, "pistol") end
    local chosen_cls = classes[math.random(#classes)]
    
    local wpn_list = t_data.weapons
    if chosen_cls == "pistol" and t_data.pistols then
        wpn_list = t_data.pistols
    elseif chosen_cls == "shotgun" and t_data.shotguns then
        wpn_list = t_data.shotguns
    elseif chosen_cls == "rifle" and t_data.rifles then
        wpn_list = t_data.rifles
    elseif chosen_cls == "smg" and t_data.smgs then
        wpn_list = t_data.smgs
    elseif chosen_cls == "sniper" and t_data.snipers then
        wpn_list = t_data.snipers
    end
    
    local spawned_wpn_id = nil
    local wpn_sec = pick_valid_section(wpn_list, last_spawned_weapon_sec) or pick_valid_section(t_data.weapons, last_spawned_weapon_sec)
    if wpn_sec then
        last_spawned_weapon_sec = wpn_sec
        local se = alife_create(wpn_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then
            temporary_arena_item_ids[se.id] = true
            spawned_wpn_id = se.id
            
            local ammo_types = { "fmj", "ap", "hp" }
            local chosen_ammo = ammo_types[math.random(#ammo_types)]
            if xcvb_arena_main and xcvb_arena_main.endless_artigrok_ammo then
                if is_artigrok_active() then
                    chosen_ammo = "special"
                end
            end
            local ammo_sec = get_weapon_ammo(wpn_sec, chosen_ammo)
            if ammo_sec then
                ammo_sec = spawn_and_fill_mags(wpn_sec, ammo_sec, 4, spawned_wpn_id) or ammo_sec
                local count = (t_data.ammo_count or 5) + 1
                for i = 1, count do
                    local se_ammo = alife_create(ammo_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
                    if se_ammo then temporary_arena_item_ids[se_ammo.id] = true end
                end
            end
        end
    end
    
    local knife_sec = t_data.knife or "wpn_knife"
    if ini_sys:section_exist(knife_sec) then
        local se = alife_create(knife_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then temporary_arena_item_ids[se.id] = true end
    end
    
    if t_data.meds then
        for _, med_sec in ipairs(t_data.meds) do
            if ini_sys:section_exist(med_sec) then
                local se = alife_create(med_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
                if se then temporary_arena_item_ids[se.id] = true end
            end
        end
        if diff == "easy" then
            local bonus_med = "medkit"
            if ini_sys:section_exist(bonus_med) then
                local se = alife_create(bonus_med, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
                if se then temporary_arena_item_ids[se.id] = true end
            end
        end
    end
    
    if xcvb_arena_fight and xcvb_arena_fight.heal_actor_completely then
        xcvb_arena_fight.heal_actor_completely()
    else
        if db.actor then
            db.actor.health = 1.0
            db.actor.bleeding = 1.0
            db.actor.radiation = 0
            db.actor.psy_health = 1.0
            db.actor.power = 1.0
        end
        if zzz_player_injuries and zzz_player_injuries.health and zzz_player_injuries.maxhp then
            pcall(function()
                local bhs_parts = {"head", "torso", "rightarm", "leftarm", "rightleg", "leftleg"}
                local sv = (utils_obj and utils_obj.save_var) or _G.save_var
                for _, part in ipairs(bhs_parts) do
                    local max_v = (zzz_player_injuries.maxhp and zzz_player_injuries.maxhp[part]) or ((part == "head" or part == "torso") and 11 or 5)
                    zzz_player_injuries.health[part] = max_v
                    if zzz_player_injuries.timedhp then zzz_player_injuries.timedhp[part] = 0 end
                    if sv and db.actor then
                        pcall(sv, db.actor, "health." .. part, max_v)
                        pcall(sv, db.actor, "timedhp." .. part, 0)
                    end
                end
                zzz_player_injuries.myhealth = 1.0
            end)
        end
    end
    
    local endless_target_slot = (chosen_cls == "pistol") and 1 or 2

    CreateTimeEvent("arena_equip_endless_e1", "arena_equip_endless_a1", 0.3, function()
        local outfit_obj = spawned_outfit_id and level.object_by_id(spawned_outfit_id)
        if not outfit_obj then
            db.actor:iterate_inventory(function(_, itm)
                if is_outfit_item(itm) and temporary_arena_item_ids[itm:id()] then
                    outfit_obj = itm
                    return true
                end
            end, db.actor)
        end
        if outfit_obj then
            db.actor:move_to_slot(outfit_obj, 7)
        end
        
        local wpn_obj = spawned_wpn_id and level.object_by_id(spawned_wpn_id)
        if not wpn_obj then
            db.actor:iterate_inventory(function(_, itm)
                if temporary_arena_item_ids[itm:id()] and IsWeapon(nil, itm:clsid()) and not (IsKnife and IsKnife(nil, itm:clsid())) then
                    wpn_obj = itm
                    return true
                end
            end, db.actor)
        end
        if wpn_obj then
            if ini_sys:line_exist(wpn_obj:section(), "slot") then
                local s = ini_sys:r_s32(wpn_obj:section(), "slot")
                if s == 1 or s == 2 then
                    endless_target_slot = s
                end
            end
            db.actor:move_to_slot(wpn_obj, endless_target_slot)
        end

        -- Secondary sweep: Purge any stray ammo or magazines that do NOT match the current weapon
        if db.actor and wpn_sec then
            local valid_ammo_types = {}
            local raw_ammos = ini_sys:r_string_ex(wpn_sec, "ammo_class") or ""
            for _, a in ipairs(str_explode(raw_ammos, ",")) do
                valid_ammo_types[trim(a)] = true
            end
            local valid_mags = {}
            if magazine_binder and magazine_binder.get_mags_for_weapon then
                local mags = magazine_binder.get_mags_for_weapon(wpn_sec)
                if mags then
                    for _, m in ipairs(mags) do valid_mags[m] = true end
                end
            end
            if magazine_binder and magazine_binder.weapon_default_magazine then
                local def_m = magazine_binder.weapon_default_magazine(wpn_sec)
                if def_m then valid_mags[def_m] = true end
            end

            local stray_items = {}
            db.actor:iterate_inventory(function(_, itm)
                if not itm then return end
                local sec = itm:section()
                if sec == "device_pda" or string.find(sec, "device_torch") or sec == "bolt" or (IsItem and IsItem("quest", sec)) then
                    return
                end
                if saved_actor_item_ids and saved_actor_item_ids[itm:id()] then
                    return
                end
                local cls = itm:clsid()
                local is_ammo = (IsItem and IsItem("ammo", sec))
                    or (itm.is_ammo and itm:is_ammo())
                    or (cls == clsid.wpn_ammo or cls == clsid.wpn_ammo_s or cls == clsid.wpn_ammo_m209 or cls == clsid.wpn_ammo_vog25 or cls == clsid.wpn_ammo_og7b)
                    or string.find(sec, "^ammo_")
                local is_mag = string.find(sec, "^mag_")
                    or (SYS_GetParam and SYS_GetParam(0, sec, "kind") == "w_mag")
                    or (magazine_binder and magazine_binder.is_magazine and magazine_binder.is_magazine(sec))
                
                if (is_ammo and not valid_ammo_types[sec]) or (is_mag and not valid_mags[sec]) then
                    table.insert(stray_items, itm:id())
                end
            end, db.actor)

            for _, s_id in ipairs(stray_items) do
                local se = alife_object(s_id)
                if se then
                    if safe_release_manager and safe_release_manager.release then
                        safe_release_manager.release({ id = s_id })
                    else
                        alife_release(se)
                    end
                end
            end
        end

        return true
    end)
    
    CreateTimeEvent("arena_equip_endless_e2", "arena_equip_endless_a2", 0.5, function()
        local helm_obj = spawned_helm_id and level.object_by_id(spawned_helm_id)
        if not helm_obj then
            db.actor:iterate_inventory(function(_, itm)
                if is_helmet_item(itm) and temporary_arena_item_ids[itm:id()] then
                    helm_obj = itm
                    return true
                end
            end, db.actor)
        end
        if helm_obj then
            db.actor:move_to_slot(helm_obj, 12)
        end
        return true
    end)

    CreateTimeEvent("arena_equip_endless_draw_e1", "arena_equip_endless_draw_a1", 0.6, function()
        if not db.actor then return true end
        local in_slot = db.actor:item_in_slot(endless_target_slot)
        if not in_slot then
            local other_slot = (endless_target_slot == 2) and 1 or 2
            if db.actor:item_in_slot(other_slot) then
                endless_target_slot = other_slot
            else
                local wpn_obj = spawned_wpn_id and level.object_by_id(spawned_wpn_id)
                if not wpn_obj then
                    db.actor:iterate_inventory(function(_, itm)
                        if temporary_arena_item_ids[itm:id()] and IsWeapon(nil, itm:clsid()) and not (IsKnife and IsKnife(nil, itm:clsid())) then
                            wpn_obj = itm
                            return true
                        end
                    end, db.actor)
                end
                if wpn_obj then
                    db.actor:move_to_slot(wpn_obj, endless_target_slot)
                end
            end
        end
        db.actor:activate_slot(endless_target_slot)
        return true
    end)

    CreateTimeEvent("arena_equip_endless_draw_e2", "arena_equip_endless_draw_a2", 1.0, function()
        if not db.actor then return true end
        if db.actor:active_slot() ~= endless_target_slot then
            local in_slot = db.actor:item_in_slot(endless_target_slot)
            if not in_slot then
                local other_slot = (endless_target_slot == 2) and 1 or 2
                if db.actor:item_in_slot(other_slot) then
                    endless_target_slot = other_slot
                end
            end
            db.actor:activate_slot(endless_target_slot)
        end
        return true
    end)

    if use_3dssg then
        CreateTimeEvent("arena_equip_endless_3dssg", "arena_equip_endless_3dssg", 1.1, function()
            if not db.actor then return true end
            db.actor:iterate_inventory(function(_, itm)
                if temporary_arena_item_ids[itm:id()] and IsWeapon(nil, itm:clsid()) and not (IsKnife and IsKnife(nil, itm:clsid())) then
                    attach_arena_scope(itm, nil)
                end
            end, db.actor)
            return true
        end)
    end

    if xcvb_arena_main.night_mode_active then
        pcall(ensure_actor_torch_active)
        CreateTimeEvent("arena_endless_torch_recheck_e", "arena_endless_torch_recheck_a", 0.5, function()
            pcall(ensure_actor_torch_active)
            return true
        end)
    end
end

--------------------------------------------------------------------------------
-- LOADOUT RENTAL FEE CALCULATION
--------------------------------------------------------------------------------
function get_loadout_rental_fee(round_id, loadout_class, loadout_tier, loadout_ammo, weapon_sec, scope_sec, mag_sec, mag_count, ammo_count)
    if xcvb_arena_main and xcvb_arena_main.practice_mode_active then
        return 0
    end

    local mult = (xcvb_arena_mcm and xcvb_arena_mcm.get_config("rental_fee_mult"))
    if mult == nil then mult = 1.0 end
    if mult <= 0 then
        return 0
    end

    local round_tier = math.max(1, math.min(5, math.ceil((round_id or 1) / 3)))
    local eff_tier = loadout_tier
    if not eff_tier or eff_tier == 0 then
        eff_tier = round_tier
    end
    if eff_tier < 1 then eff_tier = 1 end
    if eff_tier > 5 then eff_tier = 5 end

    local total_fee = 0

    -- 1. Primary weapon fee (free if random)
    if loadout_class and loadout_class ~= "random" then
        local w_fee = 0
        if weapon_sec and ini_sys and ini_sys:section_exist(weapon_sec) then
            local cost = ini_sys:r_u32(weapon_sec, "cost") or 0
            if cost > 0 then
                w_fee = math.max(300, math.floor(cost * 0.08))
            end
        end
        if w_fee == 0 then
            local class_base = {
                pistol = 400,
                shotgun = 700,
                smg = 800,
                rifle = 1200,
                sniper = 1600,
            }
            w_fee = (class_base[loadout_class] or 600) * eff_tier
        end
        total_fee = total_fee + w_fee
    end

    -- 2. Weapon Tier override fee (bringing higher tier weapons into lower tier matches)
    if loadout_tier and loadout_tier > 0 then
        if loadout_tier > round_tier then
            total_fee = total_fee + (loadout_tier - round_tier) * 1200
        else
            total_fee = total_fee + 300
        end
    end

    -- 3. Ammo type and ammo quantity fee
    local a_boxes = tonumber(ammo_count)
    if loadout_ammo and loadout_ammo ~= "auto" then
        local ammo_box_cost = {
            fmj = 150,
            hp = 250,
            ap = 450,
            special = 650,
        }
        local per_box = (ammo_box_cost[loadout_ammo] or 200) * (eff_tier * 0.2 + 0.8)
        local count_to_charge = a_boxes or 3
        total_fee = total_fee + math.floor(per_box * count_to_charge)
    else
        -- Auto ammo: 1 to 3 boxes or "auto" is included FREE with the weapon
        if a_boxes and a_boxes > 3 then
            total_fee = total_fee + (a_boxes - 3) * 120 * eff_tier
        end
    end

    -- 4. Magazine fee (if weapon supports magazines)
    if weapon_sec and magazine_binder and magazine_binder.is_supported_weapon and magazine_binder.is_supported_weapon(weapon_sec) then
        local m_cnt = tonumber(mag_count)
        if m_cnt and m_cnt > 0 then
            local basic_mag = get_weapon_basic_mag(weapon_sec)
            local is_basic = (mag_sec == nil or mag_sec == basic_mag)
            -- If using basic mag and count <= 3, it is FREE (included with rental)
            if not is_basic or m_cnt > 3 then
                local m_unit_cost = 0
                if mag_sec and ini_sys and ini_sys:section_exist(mag_sec) then
                    local raw_cost = ini_sys:r_u32(mag_sec, "cost") or 0
                    if raw_cost > 0 then
                        m_unit_cost = math.max(100, math.floor(raw_cost * 0.08))
                    end
                end
                if m_unit_cost == 0 then
                    local cap = mag_sec and get_mag_capacity(mag_sec) or 30
                    if cap > 50 then
                        m_unit_cost = 400
                    elseif cap > 30 then
                        m_unit_cost = 250
                    else
                        m_unit_cost = 150
                    end
                end
                local charge_mags = is_basic and (m_cnt - 3) or m_cnt
                total_fee = total_fee + (m_unit_cost * charge_mags)
            end
        end
    end

    -- 5. Scope fee
    if scope_sec then
        total_fee = total_fee + 500
    end

    total_fee = total_fee * mult
    if total_fee > 0 then
        total_fee = math.max(100, math.floor((total_fee / 50) + 0.5) * 50)
    else
        total_fee = 0
    end

    return total_fee
end

pcall(init_sr_light_hook)
