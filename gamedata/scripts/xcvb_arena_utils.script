    stalker  = { 0, 1, 2, 3, 4 },
    bandit   = { 0, 1, 2, 3, 4 },
    killer   = { 0, 1, 2, 3, 4 },
    duty     = { 0, 1, 2, 3, 4 },
    dolg     = { 0, 1, 2, 3, 4 },
    freedom  = { 0, 1, 2, 3, 4 },
    army     = { 0, 1, 2, 3, 4 },
    ecolog   = { 0, 1, 2, 3, 4 },
    csky     = { 0, 1, 2, 3, 4 },
    renegade = { 0, 1, 2 },
    zombied  = { 1, 2, 3, 4 },
}

