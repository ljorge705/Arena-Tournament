    cat = {
        sections = { "cat_normal_a", "cat_normal_b", "cat_strong_a" },
        base_count = 4,
        power = 5,
    },
    fracture = {
        sections = { "fracture_normal", "fracture_strong", "fracture_3" },
        base_count = 3,
        power = 5,
    },
    flesh = {
        sections = { "flesh_normal", "flesh_strong" },
        base_count = 3,
        power = 4,
    },
    dog = {
        sections = { "dog_normal_red", "dog_normal_white", "dog_normal_brown", "dog_strong_black" },
        base_count = 5,
        power = 3,
    },
    zombie = {
        sections = { "zombie_normal", "zombie_strong", "zombie_blind" },
        base_count = 4,
        power = 3,
    },
    tushkano = {
        sections = { "tushkano_normal" },
        base_count = 6,
        power = 2,
    },
}

local function pick_valid_mutant_sec(sec_list, fallback_sec)
    if sec_list then
        for _, s in ipairs(sec_list) do
            if ini_sys and ini_sys:section_exist(s) then
                return s
            end
        end
    end
    if fallback_sec and ini_sys and ini_sys:section_exist(fallback_sec) then
        return fallback_sec
    end
    return (sec_list and sec_list[1]) or fallback_sec or "snork_normal"
end

function get_squad_for_mutant(mut_key)
    local key = mut_key or "snork"
    local def = mutant_species_defs[key]
    if not def then
        def = mutant_species_defs["snork"]
        key = "snork"
    end

    local secs = {}
    local pwr = def.power or 6
    local base_cnt = def.base_count or 3

    for i = 1, base_cnt do
        local rand_sec = def.sections[math.random(1, #def.sections)]
        local chosen = pick_valid_mutant_sec({ rand_sec }, def.sections[1])
        secs[#secs + 1] = chosen
    end

    if def.support_sections and def.support_count then
        for i = 1, def.support_count do
            local rand_sec = def.support_sections[math.random(1, #def.support_sections)]
            local chosen = pick_valid_mutant_sec({ rand_sec }, def.support_sections[1])
            secs[#secs + 1] = chosen
        end
    end

    return secs, pwr, key
end

function get_squad_for_faction(fac_key, amount)
    local amt = amount or 3
    if mutant_species_defs[fac_key] then
        return get_squad_for_mutant(fac_key)
    end
    if fac_key == "mutant" then
        local t, p = get_mutant_team(amt)
        if not t or #t == 0 then
            t = { "snork_normal", "snork_normal", "boar_normal" }
            p = 10
        end
        return t, p, "mutant"
    end
    
    local k = fac_key or "stalker"
    if k == "duty" then k = "dolg" end
    if k == "military" then k = "army" end
    
    local ranks = stalkers_t[k] or stalkers_t["stalker"]
    local ret_ar = {}
    local pwr = 0
    for i = 1, amt do
        local rank_val = ranks[math.random(1, #ranks)]
        local sec_fac = k
        if k == "army" then sec_fac = "military" elseif k == "dolg" then sec_fac = "duty" end
        local sec = "sim_default_" .. sec_fac .. "_" .. rank_val
        ret_ar[#ret_ar + 1] = sec
        pwr = pwr + (stalkers_power_t[rank_val] or 3)
    end
    return ret_ar, pwr, k
end

function setup_battle_royale_relations(squad_ids)
    if not squad_ids then return end
    local squads = {}
    for idx, sq_id in ipairs(squad_ids) do
        local sq = sq_id and alife_object(sq_id)
        if sq then
            squads[idx] = sq
        end
    end

    local total = #squad_ids
    for idx, sq in pairs(squads) do
        local next_idx = (idx % total) + 1
        local next_target = squads[next_idx]
        if next_target then
            sq.scripted_target = next_target.id
            sq.assigned_target_id = next_target.id
        end
        sq.rush_to_target = true
    end

    for i = 1, total do
        local sq_i = squads[i]
        if sq_i then
            for j = 1, total do
                if i ~= j then
                    local sq_j = squads[j]
                    if sq_j then
                        pcall(function() sq_i:set_relation(sq_j, "enemy") end)
                    end
                end
            end
        end
    end

    for i = 1, total do
        local sq_i = squads[i]
        if sq_i then
            for m_i in sq_i:squad_members() do
                local npc_i = level.object_by_id(m_i.id)
                if npc_i and npc_i:alive() then
                    pcall(function() npc_i:change_team(i, i, i) end)
                    pcall(function() npc_i:add_restrictions("bar_arena_restrictor", "") end)
                    if db.actor then
                        pcall(function() npc_i:force_set_goodwill(5000, db.actor) end)
                        pcall(function() npc_i:set_relation(game_object.neutral, db.actor) end)
                    end
                    if IsMonster and IsMonster(npc_i) then
                        pcall(function() npc_i:berserk() end)
                        pcall(function() npc_i:set_custom_panic_threshold(0) end)
                    elseif IsStalker and IsStalker(npc_i) then
                        pcall(function() npc_i:set_mental_state(anim.danger) end)
                        pcall(function() npc_i:set_custom_panic_threshold(0.05) end)
                        if npc_i.register_in_combat then
                            pcall(function() npc_i:register_in_combat() end)
                        end
                    end

                    for j = 1, total do
                        if i ~= j then
                            local sq_j = squads[j]
                            if sq_j then
                                for m_j in sq_j:squad_members() do
                                    local npc_j = level.object_by_id(m_j.id)
                                    if npc_j and npc_j:alive() then
                                        pcall(function() npc_i:force_set_goodwill(-9999, npc_j) end)
                                        pcall(function() npc_i:set_relation(game_object.enemy, npc_j) end)
                                        if npc_i.make_enemy_visible then
                                            pcall(function() npc_i:make_enemy_visible(npc_j) end)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

