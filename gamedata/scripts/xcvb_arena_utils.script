local ini_rel = ini_file("creatures\\game_relations.ltx")

function sound_if_exists(path)
    if getFS():exist("$game_sounds$", path .. ".ogg") then
        return sound_object(path)
    end
    return nil
end

-- The Lua binding exists on all game objects, but set_enemy only supports
-- bloodsuckers. Other combatants use relations, squad targets and hit memory.
function set_bloodsucker_enemy(npc, target)
    if not (npc and target and clsid and clsid.bloodsucker_s) then return end
    if npc:clsid() ~= clsid.bloodsucker_s then return end
    if npc.set_enemy then
        pcall(function() npc:set_enemy(target) end)
    end
end

temporary_arena_item_ids = {}
arena_spawned_combatant_ids = {}
