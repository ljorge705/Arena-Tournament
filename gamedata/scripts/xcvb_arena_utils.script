    psy_dog = {"_normal"},
    -- Asegúrate de incluir las variantes fuertes y extremas de quimeras y gigantes:
    chimera = {"_weak", "_normal", "_strong", "_strong2", "_strong3", "_strong4"},
    gigant = {"_normal", "_strong", "_weak"},
    burer = {"_normal", "_strong"}
}

local mutants_power_t = {
    zombie = 1,  boar = 3,  dog = 2,  pseudodog = 4,  cat = 4,  fracture = 5,
    snork = 5,  lurker = 5,  psysucker = 8,  psy_dog = 8,
    chimera = 15, gigant = 18, burer = 10
}

local mutant_relation_order = {
    "actor","human","zoo_monstr","boar","bloodsucker","flesh","dog","pseudodog","cat","chimera","giant","zombie","burer","controller","poltergeist","snork","fracture","bird","rat","tushkano","corpse","trader","arena_monstr","komar","tark","medwed","rotan","fly","mwolf","psysucker","lurker","karlik"
}

local mutant_relations_t = {}

local giant_types = { gigant = true }

function get_mutant_team(amount, team1_mutant_type)
    local ret_ar = {}
    local pwr = 0
    local k
    
    if is_empty(mutant_relations_t) then
        fill_mutant_relations_table()
    end
    
    if team1_mutant_type then
        local team1_enemies_t = mutant_relations_t[team1_mutant_type]
        local t_size = team1_enemies_t and size_table(team1_enemies_t) or 0
        if t_size <= 0 then
            return ret_ar, pwr, k
        end
        k = random_key_table(team1_enemies_t)
    else
        k = random_key_table(mutants_t)
    end
    
    -- Giants (gigant/chimera) are capped at 1 per team to avoid unfair domination
    local effective_amount = (giant_types[k]) and 1 or amount
    
    for i = 1, effective_amount do
        local rnd_idx = math.random(1, #mutants_t[k])
        local sec = k .. mutants_t[k][rnd_idx]
        ret_ar[#ret_ar + 1] = sec
        pwr = pwr + mutants_power_t[k]
    end
    return ret_ar, pwr, k
end

function fill_mutant_relations_table()
    local n = ini_rel:line_count("monster_relations")
    for i = 0, n - 1 do
        local _, mutant, values = ini_rel:r_line_ex("monster_relations", i, "", "")
        if mutant and mutants_t[mutant] then
            mutant_relations_t[mutant] = {}
            local rel_ar = str_explode(values, ",")
            for idx, val in ipairs(rel_ar) do
                local enemy_mutant = mutant_relation_order[idx]
                if tonumber(val) < 0 and enemy_mutant and mutants_t[enemy_mutant] then
                    mutant_relations_t[mutant][enemy_mutant] = true
                end
            end
        end
    end
    for mutant1, t1 in pairs(mutant_relations_t) do
        for mutant2, t2 in pairs(mutant_relations_t) do
            if mutant1 ~= mutant2 and t2[mutant1] and (not t1[mutant2]) then
                mutant_relations_t[mutant2][mutant1] = nil
            end
        end
    end
    mutant_relations_t["psy_dog"] = {}
    mutant_relations_t["psy_dog"] = dup_table(mutant_relations_t["pseudodog"])
end

function get_team_str(ar)
    for _, sec in ipairs(ar) do
        for k, __ in pairs(stalkers_t) do
            if string.find(sec, k) then
                return k == "duty" and "dolg" or k
            elseif string.find(sec, "military") then
                return "army"
            end
        end
        for k, __ in pairs(mutants_t) do
            if string.find(sec, "^" .. k) then
                if k == "dog" then return "encyclopedia_mutants_blind_dog"
                elseif k == "psy_dog" then return "encyclopedia_mutants_psydog"
                end
                return "encyclopedia_mutants_" .. k
            end
        end
    end
end

function get_team_rank_string(ar)
    local stalker_rank = 0
    local stalker_count = 0
    local mutant_rank = 0
    local mutant_count = 0
    
    for _, sec in ipairs(ar) do
        if string.find(sec, "sim_default") then
            local rank = tonumber(string.sub(sec, -1))
            if rank then
                stalker_rank = stalker_rank + rank
                stalker_count = stalker_count + 1
            end
        else
            if string.find(sec, "weak") then mutant_rank = mutant_rank + 0
            elseif string.find(sec, "normal") then mutant_rank = mutant_rank + 1
            elseif string.find(sec, "strong") or string.find(sec, "hard") then mutant_rank = mutant_rank + 2
            else mutant_rank = mutant_rank + 1 end
            mutant_count = mutant_count + 1
        end
    end
    
    local gt = game.translate_string
    if stalker_count > 0 then
        local avg = math.floor((stalker_rank / stalker_count) + 0.5)
        if avg == 0 then return gt("st_arena_group_novice")
        elseif avg == 1 then return gt("st_arena_group_trainee")
        elseif avg == 2 then return gt("st_arena_group_experienced")
        elseif avg == 3 then return gt("st_arena_group_advanced")
        elseif avg >= 4 then return gt("st_arena_group_expert")
        end
    elseif mutant_count > 0 then
        local avg = math.floor((mutant_rank / mutant_count) + 0.5)
        if avg == 0 then return gt("st_arena_group_weak")
        elseif avg == 1 then return gt("st_arena_group_normal")
        elseif avg >= 2 then return gt("st_arena_group_strong")
        end
    end
    return nil
end
