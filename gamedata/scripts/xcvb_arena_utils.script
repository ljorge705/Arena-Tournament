local ini_rel = ini_file("creatures\\game_relations.ltx")
temporary_arena_item_ids = {}
arena_spawned_combatant_ids = {}
xcvb_arena_storage_box_id = nil

function get_new_period()
    local hrs = level.get_time_hours()
    for i, t in ipairs(xcvb_arena_main.arena_main_t) do
        if hrs >= t.min and hrs < t.max then
            return i
        end
    end
end

function spawn_board()
    local pos = vector():set(149.2, 1.40, 70.81)
    local lvid = 40590
    local gvid = 1684
    if level and level.name and level.name() == "l05_bar" and level.vertex_id then
        local v = level.vertex_id(pos)
        if v and v < 2^32 - 1 then
            lvid = v
        end
    end
    local se_obj = alife_create("xcvb_arena_board", pos, lvid, gvid)
    if not se_obj then return end
    
    local data = utils_stpk.get_physic_data(se_obj)
    data.custom_data = [[
[collide]
ignore_static
ignore_small_objects

[logic]
cfg = scripts\arena_board_logic.ltx
]]
    utils_stpk.set_physic_data(data, se_obj)
    se_obj.angle = vector():set(0, -2.06, 0)
    return se_obj
end

function spawn_balcony()
    local pos = vector():set(140.1, -13.51, 102.2)
    local lvid = 40551
    local gvid = 1710
    if level and level.name and level.name() == "l05_bar" and level.vertex_id then
        local v = level.vertex_id(pos)
        if v and v < 2^32 - 1 then
            lvid = v
        end
    end
    local se_obj = alife_create("xcvb_arena_balcony", pos, lvid, gvid)
    if not se_obj then return end
    
    local data = utils_stpk.get_physic_data(se_obj)
    data.custom_data = [[
[collide]
ignore_static
ignore_small_objects
]]
    utils_stpk.set_physic_data(data, se_obj)
    se_obj.angle = vector():set(0, -1.5708, 0)
    return se_obj
end

function check_and_spawn_board()
    local sim = alife()
    if not sim then return end
    
    local board_found = false
    local balcony_found = false
    
    for i = 1, 65534 do
        local se = sim:object(i)
        if se then
            local sec = se:section_name()
            if sec == "xcvb_arena_board" then
                board_found = true
            elseif sec == "xcvb_arena_balcony" then
                balcony_found = true
            end
            if board_found and balcony_found then
                break
            end
        end
    end
    
    if not board_found then
        spawn_board()
    end
    if not balcony_found then
        spawn_balcony()
    end
end

function handle_removed_teams()
    for i, t in ipairs(xcvb_arena_main.arena_main_t) do
        if #t.team1 > 0 then
            local remove_teams = false
            for j, sec in ipairs(t.team1) do
                if string.find(sec, "zombied") then
                    remove_teams = true
                    break
                end
            end
            for j, sec in ipairs(t.team2) do
                if string.find(sec, "zombied") then
                    remove_teams = true
                    break
                end
            end
            if remove_teams then
                iempty_table(xcvb_arena_main.arena_main_t[i].team1)
                iempty_table(xcvb_arena_main.arena_main_t[i].team2)
                iempty_table(xcvb_arena_main.arena_main_t[i].pwrs)
            end
        end
    end
end

local stalkers_t = {
    stalker  = { 0, 1, 2, 3, 4 },
    bandit   = { 0, 1, 2, 3, 4 },
    killer   = { 0, 1, 2, 3, 4 },
    duty     = { 0, 1, 2, 3, 4 },
    dolg     = { 0, 1, 2, 3, 4 },
    freedom  = { 0, 1, 2, 3, 4 },
    army     = { 0, 1, 2, 3, 4 },
    ecolog   = { 0, 1, 2, 3, 4 },
    csky     = { 0, 1, 2, 3, 4 },
    renegade = { 0, 1, 2 },
}

local stalkers_power_t = {
    [0] = 1,
    [1] = 3,
    [2] = 5,
    [3] = 8,
    [4] = 10,
}

local faction_enemies_t = {
    stalker  = { "bandit", "killer", "army", "renegade" },
    dolg     = { "freedom", "bandit", "killer", "renegade" },
    duty     = { "freedom", "bandit", "killer", "renegade" },
    freedom  = { "dolg", "army", "renegade", "bandit" },
    csky     = { "bandit", "army", "renegade" },
    ecolog   = { "bandit", "renegade" },
    killer   = { "stalker", "dolg", "army", "renegade" },
    army     = { "stalker", "freedom", "bandit", "killer", "renegade", "csky" },
    bandit   = { "stalker", "dolg", "freedom", "csky", "ecolog", "army" },
    renegade = { "stalker", "dolg", "freedom", "csky", "ecolog", "killer", "army" },
}

function is_enemy_faction(fac1, fac2)
    local f1 = fac1 == "duty" and "dolg" or fac1
    local f2 = fac2 == "duty" and "dolg" or fac2
    if not (f1 and f2 and faction_enemies_t[f1]) then return false end
    for _, enemy in ipairs(faction_enemies_t[f1]) do
        local e = enemy == "duty" and "dolg" or enemy
        if e == f2 then return true end
    end
    return false
end

function get_stalker_team(amount, opponent_faction)
    local ret_ar = {}
    local pwr = 0
    local k
    local opp = opponent_faction == "duty" and "dolg" or opponent_faction
    
    if opp and faction_enemies_t[opp] then
        local enemies = faction_enemies_t[opp]
        k = enemies[math.random(1, #enemies)]
    else
        k = random_key_table(stalkers_t)
    end
    
    if not (k and stalkers_t[k]) then k = "stalker" end
    local ranks = stalkers_t[k] or stalkers_t["stalker"]
    
    for i = 1, amount do
        local rnd_idx = math.random(1, #ranks)
        local rank_val = ranks[rnd_idx]
        local new_k = k
        if k == "army" then new_k = "military" elseif k == "dolg" then new_k = "duty" end
        local sec = "sim_default_" .. new_k .. "_" .. rank_val
        ret_ar[#ret_ar + 1] = sec
        pwr = pwr + stalkers_power_t[rank_val]
    end
    return ret_ar, pwr, k
end

local mutants_t = {
    zombie = {"_weak", "_normal", "_strong", "_blind"},
    boar = {"_normal", "_strong", "_01a_weak", "_02a_weak", "_02a_strong", "_01a_hard", "_02a_hard"},
    dog = {"_normal_red", "_normal_white", "_normal_brown", "_normal_bulterier", "_weak_red", "_weak_white", "_weak_brown", "_weak_bulterier", "_strong_red", "_strong_white", "_strong_brown", "_strong_bulterier", "_strong_black"},
    pseudodog = {"_grey_weak", "_normal", "_strong", "_grey_strong"},
    cat = {"_weak_a", "_weak_b", "_weak_c", "_weak_d", "_weak_e", "_normal_a", "_normal_b", "_normal_c", "_normal_d", "_normal_e", "_strong_a", "_strong_b", "_strong_c", "_strong_d", "_strong_e"},
    fracture = {"_weak", "_normal", "_strong", "_2", "_3"},
    snork = {"_weak", "_weak2", "_weak3", "_weak4", "_normal", "_normal2", "_normal3", "_normal4", "_strong", "_strong2", "_strong3", "_strong4"},
    lurker = {"_1_weak", "_2_weak", "_3_weak", "_1_normal", "_2_normal", "_3_normal", "_1_strong", "_2_strong", "_3_strong" },
    psysucker = {"_2_weak", "_3_weak", "_2_normal", "_3_normal", "_2_strong", "_3_strong"},
    psy_dog = {"_normal"},
    -- Asegúrate de incluir las variantes fuertes y extremas de quimeras y gigantes:
    chimera = {"_weak", "_normal", "_strong", "_strong2", "_strong3", "_strong4"},
    gigant = {"_normal", "_strong", "_weak"},
    burer = {"_normal", "_strong"}
}

local mutants_power_t = {
    zombie = 1,  boar = 3,  dog = 2,  pseudodog = 4,  cat = 4,  fracture = 5,
    snork = 5,  lurker = 5,  psysucker = 8,  psy_dog = 8,
    chimera = 15, gigant = 18, burer = 10
}

local mutant_relation_order = {
    "actor","human","zoo_monstr","boar","bloodsucker","flesh","dog","pseudodog","cat","chimera","giant","zombie","burer","controller","poltergeist","snork","fracture","bird","rat","tushkano","corpse","trader","arena_monstr","komar","tark","medwed","rotan","fly","mwolf","psysucker","lurker","karlik"
}

local mutant_relations_t = {}

local giant_types = { gigant = true }

function get_mutant_team(amount, team1_mutant_type)
    local ret_ar = {}
    local pwr = 0
    local k
    
    if is_empty(mutant_relations_t) then
        fill_mutant_relations_table()
    end
    
    if team1_mutant_type then
        local team1_enemies_t = mutant_relations_t[team1_mutant_type]
        local t_size = team1_enemies_t and size_table(team1_enemies_t) or 0
        if t_size <= 0 then
            return ret_ar, pwr, k
        end
        k = random_key_table(team1_enemies_t)
    else
        k = random_key_table(mutants_t)
    end
    
    -- Giants (gigant/chimera) are capped at 1 per team to avoid unfair domination
    local effective_amount = (giant_types[k]) and 1 or amount
    
    for i = 1, effective_amount do
        local rnd_idx = math.random(1, #mutants_t[k])
        local sec = k .. mutants_t[k][rnd_idx]
        ret_ar[#ret_ar + 1] = sec
        pwr = pwr + mutants_power_t[k]
    end
    return ret_ar, pwr, k
end

function fill_mutant_relations_table()
    local n = ini_rel:line_count("monster_relations")
    for i = 0, n - 1 do
        local _, mutant, values = ini_rel:r_line_ex("monster_relations", i, "", "")
        if mutant and mutants_t[mutant] then
            mutant_relations_t[mutant] = {}
            local rel_ar = str_explode(values, ",")
            for idx, val in ipairs(rel_ar) do
                local enemy_mutant = mutant_relation_order[idx]
                if tonumber(val) < 0 and enemy_mutant and mutants_t[enemy_mutant] then
                    mutant_relations_t[mutant][enemy_mutant] = true
                end
            end
        end
    end
    for mutant1, t1 in pairs(mutant_relations_t) do
        for mutant2, t2 in pairs(mutant_relations_t) do
            if mutant1 ~= mutant2 and t2[mutant1] and (not t1[mutant2]) then
                mutant_relations_t[mutant2][mutant1] = nil
            end
        end
    end
    mutant_relations_t["psy_dog"] = {}
    mutant_relations_t["psy_dog"] = dup_table(mutant_relations_t["pseudodog"])
end

function get_team_str(ar)
    for _, sec in ipairs(ar) do
        for k, __ in pairs(stalkers_t) do
            if string.find(sec, k) then
                return k == "duty" and "dolg" or k
            elseif string.find(sec, "military") then
                return "army"
            end
        end
        for k, __ in pairs(mutants_t) do
            if string.find(sec, "^" .. k) then
                if k == "dog" then return "encyclopedia_mutants_blind_dog"
                elseif k == "psy_dog" then return "encyclopedia_mutants_psydog"
                end
                return "encyclopedia_mutants_" .. k
            end
        end
    end
end

function get_team_rank_string(ar)
    local stalker_rank = 0
    local stalker_count = 0
    local mutant_rank = 0
    local mutant_count = 0
    
    for _, sec in ipairs(ar) do
        if string.find(sec, "sim_default") then
            local rank = tonumber(string.sub(sec, -1))
            if rank then
                stalker_rank = stalker_rank + rank
                stalker_count = stalker_count + 1
            end
        else
            if string.find(sec, "weak") then mutant_rank = mutant_rank + 0
            elseif string.find(sec, "normal") then mutant_rank = mutant_rank + 1
            elseif string.find(sec, "strong") or string.find(sec, "hard") then mutant_rank = mutant_rank + 2
            else mutant_rank = mutant_rank + 1 end
            mutant_count = mutant_count + 1
        end
    end
    
    if stalker_count > 0 then
        local avg = math.floor((stalker_rank / stalker_count) + 0.5)
        if avg == 0 then return "Grupo de novatos"
        elseif avg == 1 then return "Grupo de entrenados"
        elseif avg == 2 then return "Grupo experimentado"
        elseif avg == 3 then return "Grupo avanzado"
        elseif avg >= 4 then return "Grupo de expertos"
        end
    elseif mutant_count > 0 then
        local avg = math.floor((mutant_rank / mutant_count) + 0.5)
        if avg == 0 then return "Grupo de debiles"
        elseif avg == 1 then return "Grupo normal"
        elseif avg >= 2 then return "Grupo fuerte"
        end
    end
    return nil
end
