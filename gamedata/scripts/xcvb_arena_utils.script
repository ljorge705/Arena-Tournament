function arena_fade_in_out(in_dly)
    local fade_in_delay = in_dly or 0
    local fade_out_delay = fade_in_delay + 2
    CreateTimeEvent("xcvb_arena_fade_in_e", "xcvb_arena_fade_in_a", fade_in_delay, function()
        level.add_pp_effector("fade_in.ppe", 987123)
        return true
    end)
    CreateTimeEvent("xcvb_arena_fade_out_e", "xcvb_arena_fade_out_a", fade_out_delay, function()
        level.add_pp_effector("fade_out.ppe", 987124)
        return true
    end)
end

local default_faction_enemies = {
    ["stalker"]  = { "bandit", "renegade", "killer", "military" },
    ["bandit"]   = { "stalker", "dolg", "csky", "ecolog", "military" },
    ["dolg"]     = { "freedom", "bandit", "killer", "renegade" },
    ["freedom"]  = { "dolg", "military", "renegade" },
    ["csky"]     = { "renegade", "bandit", "military" },
    ["ecolog"]   = { "bandit", "killer", "renegade" },
    ["killer"]   = { "stalker", "dolg", "military", "csky", "ecolog" },
    ["army"]     = { "stalker", "freedom", "bandit", "killer", "renegade", "csky" },
    ["military"] = { "stalker", "bandit", "freedom", "killer", "renegade" },
    ["renegade"] = { "csky", "stalker", "dolg", "military" },
    ["zombied"]  = { "stalker", "dolg", "freedom", "csky", "killer", "military", "bandit", "renegade", "ecolog" }
}

function get_actor_faction()
    local comm = (db.actor and character_community and character_community(db.actor)) or "stalker"
    if string.find(comm, "actor_") then
        comm = string.gsub(comm, "actor_", "")
    end
    return comm
end

function is_enemy_to_actor(fac, actor_fac)
    local a_fac = actor_fac or get_actor_faction()
    if not (fac and a_fac) then return true end
    
    local f1 = (fac == "duty") and "dolg" or ((fac == "military") and "army" or fac)
    local f2 = (a_fac == "duty") and "dolg" or ((a_fac == "military") and "army" or a_fac)
    
    if f1 == f2 then return false end
    
    local friend_bloc = { stalker = true, csky = true, ecolog = true }
    if friend_bloc[f1] and friend_bloc[f2] then return false end
    if (f1 == "dolg" or f1 == "army") and (f2 == "dolg" or f2 == "army") then return false end
    
    local enemies = default_faction_enemies[f2] or default_faction_enemies["stalker"]
    for _, e in ipairs(enemies) do
        local ne = (e == "duty") and "dolg" or ((e == "military") and "army" or e)
        if ne == f1 then return true end
    end
    return false
end

function get_safe_enemy_section(sec, actor_fac)
    if not (sec and string.find(sec, "^sim_default_")) then return sec end
    
    local fac, rank = string.match(sec, "^sim_default_([%a_]+)_(%d+)$")
    if not (fac and rank) then return sec end
    
    local a_fac = actor_fac or get_actor_faction()
    
    if is_enemy_to_actor(fac, a_fac) then return sec end
    
    local norm_actor = (a_fac == "duty") and "dolg" or ((a_fac == "military") and "army" or a_fac)
    local pool = default_faction_enemies[norm_actor] or { "bandit", "renegade", "killer" }
    
    for _, enemy_fac in ipairs(pool) do
        local cand_sec = "sim_default_" .. enemy_fac .. "_" .. rank
        if ini_sys:section_exist(cand_sec) then return cand_sec end
        if enemy_fac == "army" and ini_sys:section_exist("sim_default_military_" .. rank) then
            return "sim_default_military_" .. rank
        end
        if enemy_fac == "dolg" and ini_sys:section_exist("sim_default_duty_" .. rank) then
            return "sim_default_duty_" .. rank
        end
    end
    
    local fb = "sim_default_bandit_" .. rank
    if ini_sys:section_exist(fb) then return fb end
    
    return sec
end

function spawn_tournament_squad(round_data)
    if not round_data then return nil end
    local pos, lvid, gvid = get_tournament_enemy_pos()
    local squad_sec = (round_data.squad_type == "mutant") and "arena_tournament_mutant_squad" or "arena_tournament_enemy_squad"
    local squad = alife_create(squad_sec, pos, lvid, gvid)
    if not squad then return nil end
    
	squad.scripted_target = "actor"
    squad.assigned_target_id = 0
    squad.rush_to_target = true

    local a_fac = get_actor_faction()
    for _, sec in ipairs(round_data.sections) do
        local safe_sec = (round_data.squad_type == "stalker") and get_safe_enemy_section(sec, a_fac) or sec
        local offset_pos = vector():set(pos.x + math.random(-5, 5), pos.y, pos.z + math.random(-5, 5))
        squad:add_squad_member(safe_sec, offset_pos, lvid, gvid)
    end
    squad:set_squad_relation()
    squad:refresh()
    for m in squad:squad_members() do
        arena_spawned_combatant_ids[m.id] = true
    end
    return squad
end

function apply_combat_modifier_inventory(npc, team_idx)
    if not npc or npc:id() == 0 then return end
    local cur_f = xcvb_arena_main.current_spec_filter or "all"
    if cur_f == "all" or cur_f == "mvsm" then return end
    if cur_f == "svsm" and team_idx == 2 then return end

    local mod, tier
    if team_idx == 2 then
        mod = xcvb_arena_main.selected_modifier_team2
        tier = tonumber(xcvb_arena_main.selected_modifier_tier_team2) or 3
    else
        mod = xcvb_arena_main.selected_modifier_team1 or xcvb_arena_main.selected_modifier
        tier = tonumber(xcvb_arena_main.selected_modifier_tier_team1 or xcvb_arena_main.selected_modifier_tier) or 3
    end
    if not mod or mod == "none" then return end
    if not IsStalker(nil, npc:clsid()) then return end

    local items_to_remove = {}
    npc:iterate_inventory(function(owner, item)
        if item and IsWeapon(nil, item:clsid()) then
            table.insert(items_to_remove, item:id())
        end
    end, npc)
    for _, id in ipairs(items_to_remove) do
        alife_release_id(id)
    end

    tier = math.max(1, math.min(5, tier))
    local loadout = {
        pistols = {
            { "wpn_pm", "ammo_9x18_fmj" }, { "wpn_colt1911", "ammo_11.43x23_fmj" },
            { "wpn_usp", "ammo_11.43x23_fmj" }, { "wpn_fnx45", "ammo_11.43x23_fmj" },
            { "wpn_beretta", "ammo_9x19_fmj" },
        },
        shotguns = {
            { "wpn_bm16", "ammo_12x70_buck" }, { "wpn_toz34", "ammo_12x70_buck" },
            { "wpn_wincheaster1300", "ammo_12x70_buck" }, { "wpn_spas12", "ammo_12x70_buck" },
            { "wpn_saiga12s", "ammo_12x70_buck" },
        },
        ar = {
            { "wpn_ak74u", "ammo_5.45x39_fmj" }, { "wpn_ak74", "ammo_5.45x39_fmj" },
            { "wpn_lr300", "ammo_5.56x45_fmj" }, { "wpn_m4", "ammo_5.56x45_fmj" },
            { "wpn_fn2000", "ammo_5.56x45_fmj" },
        },
        smg = {
            { "wpn_mp5", "ammo_9x19_fmj" }, { "wpn_vityaz", "ammo_9x19_fmj" },
            { "wpn_pp2000", "ammo_9x19_fmj" }, { "wpn_p90", "ammo_5.7x28_fmj" },
            { "wpn_mp7", "ammo_5.7x28_fmj" },
        },
        sniper = {
            { "wpn_sks", "ammo_7.62x39_fmj" }, { "wpn_svd", "ammo_7.62x54_7h1" },
            { "wpn_vintorez", "ammo_9x39_pab9" }, { "wpn_sv98", "ammo_7.62x54_7h1" },
            { "wpn_gauss", "ammo_gauss" },
        },
    }

    local choices = loadout[mod]
    if not choices then return end
    local min_index = math.max(1, math.min(#choices, tier))
    local weapon, ammo
    for i = min_index, #choices do
        if ini_sys:section_exist(choices[i][1]) then
            weapon, ammo = choices[i][1], choices[i][2]
            break
        end
    end
    if not weapon then
        for i = 1, min_index - 1 do
            if ini_sys:section_exist(choices[i][1]) then
                weapon, ammo = choices[i][1], choices[i][2]
                break
            end
        end
    end
    if weapon then
        alife_create_item(weapon, npc)
        local dyn_ammo = get_weapon_ammo(weapon) or ammo
        if dyn_ammo and ini_sys:section_exist(dyn_ammo) then
            for i = 1, 5 + tier do
                alife_create_item(dyn_ammo, npc)
            end
        end
    end
end

function toggle_arena_lights(turn_on)
    -- Disabled for now
end

function setup_tournament_squad_aggro(squad_id)
    if type(squad_id) == "table" then
        return setup_endless_squads_aggro(squad_id)
    end
    local squad = squad_id and alife_object(squad_id)
    if not (squad and squad.commander_id) then return end
    
    for m in squad:squad_members() do
        local npc = level.object_by_id(m.id)
        if npc and npc:alive() then
            local n_pos = npc:position()
            if n_pos and (n_pos.y > -19.0 or n_pos.y < -21.5) then
                local fixed_pos = vector():set(n_pos.x, -20.0543, n_pos.z)
                pcall(function() npc:set_npc_position(fixed_pos) end)
            end
            pcall(function() npc:add_restrictions("bar_arena_restrictor", "") end)
            pcall(function() npc:force_set_goodwill(-5000, db.actor) end)
            pcall(function() npc:set_relation(game_object.enemy, db.actor) end)
            
            if npc.set_enemy then
                pcall(function() npc:set_enemy(db.actor) end)
            end
            if npc.set_sight and db.actor then
                pcall(function() npc:set_sight(look.fire_point, db.actor:position()) end)
            end
            if npc.make_enemy_visible and db.actor then
                pcall(function() npc:make_enemy_visible(db.actor) end)
            end
            if npc.register_in_combat then
                pcall(function() npc:register_in_combat() end)
            end
            
            xcvb_arena_utils.scr_hit(db.actor, npc, 0.005)
            
            if IsMonster and IsMonster(npc) then
                pcall(function() npc:berserk() end)
                pcall(function() npc:set_custom_panic_threshold(0) end)
            elseif IsStalker and IsStalker(npc) then
                pcall(function() npc:set_mental_state(anim.danger) end)
                pcall(function() npc:set_custom_panic_threshold(0.05) end)
            end
        end
    end
end

function setup_endless_squads_aggro(squad_ids)
    if not squad_ids then return end
    if type(squad_ids) == "number" then
        squad_ids = { squad_ids }
    end
    local all_npcs = {}
    for _, s_id in ipairs(squad_ids) do
        local squad = s_id and alife_object(s_id)
        if squad then
            for m in squad:squad_members() do
                local npc = level.object_by_id(m.id)
                if npc and npc:alive() then
                    table.insert(all_npcs, npc)
                    
                    local n_pos = npc:position()
                    if n_pos and (n_pos.y > -19.0 or n_pos.y < -21.5) then
                        local fixed_pos = vector():set(n_pos.x, -20.0543, n_pos.z)
                        pcall(function() npc:set_npc_position(fixed_pos) end)
                    end
                    pcall(function() npc:add_restrictions("bar_arena_restrictor", "") end)
                    pcall(function() npc:force_set_goodwill(-5000, db.actor) end)
                    pcall(function() npc:set_relation(game_object.enemy, db.actor) end)
                    
                    if npc.set_enemy then
                        pcall(function() npc:set_enemy(db.actor) end)
                    end
                    if npc.set_sight and db.actor then
                        pcall(function() npc:set_sight(look.fire_point, db.actor:position()) end)
                    end
                    if npc.make_enemy_visible and db.actor then
                        pcall(function() npc:make_enemy_visible(db.actor) end)
                    end
                    if npc.register_in_combat then
                        pcall(function() npc:register_in_combat() end)
                    end
                    
                    xcvb_arena_utils.scr_hit(db.actor, npc, 0.005)
                    
                    if IsMonster and IsMonster(npc) then
                        pcall(function() npc:berserk() end)
                        pcall(function() npc:set_custom_panic_threshold(0) end)
                    elseif IsStalker and IsStalker(npc) then
                        pcall(function() npc:set_mental_state(anim.danger) end)
                        pcall(function() npc:set_custom_panic_threshold(0.05) end)
                    end
                end
            end
        end
    end
    
    if #all_npcs > 1 then
        for i = 1, #all_npcs do
            for j = i + 1, #all_npcs do
                local n1 = all_npcs[i]
                local n2 = all_npcs[j]
                pcall(function()
                    n1:force_set_goodwill(5000, n2)
                    n2:force_set_goodwill(5000, n1)
                    n1:set_relation(game_object.friend, n2)
                    n2:set_relation(game_object.friend, n1)
                end)
            end
        end
    end
end

function give_tournament_rewards(round_data)
    if not round_data then return end
    
    local mult = xcvb_arena_mcm.get_config("reward_mult") or 1.0
    local money = math.ceil(round_data.reward_money * mult)
    db.actor:give_money(money)
    
    local str = string.format(game.translate_string("st_arena_reward_money"), money)
    news_manager.send_tip(db.actor, str, 0, nil, 10000)
    
    local give_items = xcvb_arena_mcm.get_config("give_items")
    if give_items ~= false and round_data.reward_items then
        local items_given = false
        for _, item_sec in ipairs(round_data.reward_items) do
            if ini_sys:section_exist(item_sec) then
                alife_create_item(item_sec, db.actor)
                items_given = true
            end
        end
        if items_given then
            news_manager.send_tip(db.actor, game.translate_string("st_arena_reward_items"), 0, nil, 10000)
        end
    end
end

function clean_arena_corpses()
    local function safe_release_by_id(id)
        pcall(function()
            if safe_release_manager and safe_release_manager.release then
                safe_release_manager.release({id = id})
            else
                alife_release_id(id)
            end
        end)
    end

    if arena_spawned_combatant_ids then
        for id, _ in pairs(arena_spawned_combatant_ids) do
            safe_release_by_id(id)
        end
        arena_spawned_combatant_ids = {}
    end

    local pass_count = 0
    local max_passes = 3
    local function arena_sweep()
        if has_alife_info("xcvb_tournament_started") or has_alife_info("xcvb_arena_started") then
            return true
        end

        pass_count = pass_count + 1
        local sim = alife()
        if not sim then return true end

        local found_anything = false
        for id = 1, 65534 do
            local se = sim:object(id)
            if se then
                local pos = se.position
                if pos and pos.x >= 125 and pos.x <= 175 and pos.y <= -6 and pos.z >= 65 and pos.z <= 145 then
                    local parent = se.parent_id
                    if id == 0 or parent == 0 then
                    else
                        local sec = se:section_name()
                        local is_safe = (sec == "inventory_box" or string.find(sec, "restrictor") or string.find(sec, "physic_object") or string.find(sec, "arena_board") or string.find(sec, "arena_balcony") or string.find(sec, "xcvb_"))
                        if not is_safe then
                            local cls = se:clsid()
                            local is_npc = IsStalker(nil, cls) or IsMonster(nil, cls)
                            local is_item = IsWeapon(nil, cls) or IsAmmo(nil, cls) or IsOutfit(nil, cls) or IsHeadgear(nil, cls)
                            if is_npc or is_item then
                                safe_release_by_id(id)
                                found_anything = true
                            end
                        end
                    end
                end
            end
        end

        if found_anything and pass_count < max_passes then
            return false
        end
        return true
    end

    RemoveTimeEvent("arena_corpse_clean_e", "arena_corpse_clean_a")
    CreateTimeEvent("arena_corpse_clean_e", "arena_corpse_clean_a", 2.0, arena_sweep)
end

function clean_tournament_squad(squad_id)
    local squad = squad_id and alife_object(squad_id)
    if squad and string.find(squad:section_name(), "arena_") then
        pcall(function()
            for member in squad:squad_members() do
                if safe_release_manager and safe_release_manager.release then
                    safe_release_manager.release({id = member.id})
                else
                    alife_release_id(member.id)
                end
            end
        end)
        pcall(function()
            if safe_release_manager and safe_release_manager.release then
                safe_release_manager.release({id = squad_id})
            else
                alife_release_id(squad_id)
            end
        end)
    end
    clean_arena_corpses()
end

