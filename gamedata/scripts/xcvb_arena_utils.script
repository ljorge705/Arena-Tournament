    stalker  = { "bandit", "killer", "army", "renegade" },
    dolg     = { "freedom", "bandit", "killer", "renegade" },
    duty     = { "freedom", "bandit", "killer", "renegade" },
    freedom  = { "dolg", "army", "renegade", "bandit" },
    csky     = { "bandit", "army", "renegade" },
    ecolog   = { "bandit", "renegade" },
    killer   = { "stalker", "dolg", "army", "renegade" },
    army     = { "stalker", "freedom", "bandit", "killer", "renegade", "csky" },
    bandit   = { "stalker", "dolg", "freedom", "csky", "ecolog", "army" },
    renegade = { "stalker", "dolg", "freedom", "csky", "ecolog", "killer", "army" },
    zombied  = { "stalker", "dolg", "freedom", "csky", "killer", "army", "bandit", "renegade", "ecolog" },
}

function is_enemy_faction(fac1, fac2)
    local f1 = fac1 == "duty" and "dolg" or fac1
    local f2 = fac2 == "duty" and "dolg" or fac2
    if not (f1 and f2 and faction_enemies_t[f1]) then return false end
    for _, enemy in ipairs(faction_enemies_t[f1]) do
        local e = enemy == "duty" and "dolg" or enemy
        if e == f2 then return true end
    end
    return false
end

function are_battle_royale_factions_hostile(factions)
    if not factions or #factions < 2 then return false end
    for i = 1, #factions - 1 do
        for j = i + 1, #factions do
            if not is_enemy_faction(factions[i], factions[j])
                and not is_enemy_faction(factions[j], factions[i]) then
                return false
            end
        end
    end
    return true
end

function get_stalker_team(amount, opponent_faction)
    local ret_ar = {}
    local pwr = 0
    local k
    local opp = opponent_faction == "duty" and "dolg" or opponent_faction
    
    if opp and faction_enemies_t[opp] then
        local enemies = faction_enemies_t[opp]
        k = enemies[math.random(1, #enemies)]
    else
        k = random_key_table(stalkers_t)
    end
    
    if not (k and stalkers_t[k]) then k = "stalker" end
    local ranks = stalkers_t[k] or stalkers_t["stalker"]
    
    for i = 1, amount do
        local rnd_idx = math.random(1, #ranks)
        local rank_val = ranks[rnd_idx]
        local new_k = k
        if k == "army" then new_k = "military" elseif k == "dolg" then new_k = "duty" end
        local sec = "sim_default_" .. new_k .. "_" .. rank_val
        ret_ar[#ret_ar + 1] = sec
        pwr = pwr + stalkers_power_t[rank_val]
    end
    return ret_ar, pwr, k
end

local mutants_t = {
    zombie = {"_weak", "_normal", "_strong", "_blind"},
    boar = {"_normal", "_strong", "_01a_weak", "_02a_weak", "_02a_strong", "_01a_hard", "_02a_hard"},
