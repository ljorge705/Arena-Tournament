--------------------------------------------------------------------------------
-- ENDLESS MODE (MODO INFINITO) UTILITIES
--------------------------------------------------------------------------------

local endless_mutant_sections_by_tier = {
    [1] = { "tushkano_normal", "dog_weak_red", "dog_normal_white", "flesh_weak", "cat_weak" },
    [2] = { "dog_strong_black", "pseudodog_normal", "boar_normal", "snork_weak", "flesh_normal" },
    [3] = { "snork_normal", "bloodsucker_normal", "psysucker_weak", "boar_strong", "fracture_normal" },
    [4] = { "bloodsucker_strong", "burer_normal", "psysucker_normal", "snork_strong", "chimera_weak" },
    [5] = { "chimera_normal", "gigant_normal", "burer_strong", "bloodsucker_strong" },
}

local endless_enemy_factions = { "bandit", "renegade", "killer", "army", "dolg", "freedom", "zombied" }

local endless_spawn_zones = {
    -- 6 verified, open floor zones spanning the North and Mid-North arena sectors
    { pos = vector():set(151.2, -20.0543, 128.0), fallback_lvid = 40551, gvid = 1796 }, -- North Center Gate
    { pos = vector():set(145.5, -20.0543, 123.0), fallback_lvid = 40551, gvid = 1796 }, -- North West Flank
    { pos = vector():set(158.5, -20.0543, 123.0), fallback_lvid = 40551, gvid = 1796 }, -- North East Flank
    { pos = vector():set(147.0, -20.0550, 115.0), fallback_lvid = 40551, gvid = 1796 }, -- Mid-North West
    { pos = vector():set(157.0, -20.0550, 115.0), fallback_lvid = 40551, gvid = 1796 }, -- Mid-North East
    { pos = vector():set(151.2, -20.0550, 119.0), fallback_lvid = 40551, gvid = 1796 }, -- North Center Approach
}

local function get_random_endless_spawn_pos(prefer_idx)
    local z_idx = prefer_idx
    if not z_idx or z_idx < 1 or z_idx > #endless_spawn_zones then
        z_idx = math.random(1, #endless_spawn_zones)
    end
    local zone = endless_spawn_zones[z_idx]
    -- Safe micro-jitter of +/- 0.5m so squad members do not overlap, keeping away from obstacles
    local ox = (math.random() * 1.0) - 0.5
    local oz = (math.random() * 1.0) - 0.5
    local p = vector():set(zone.pos.x + ox, zone.pos.y, zone.pos.z + oz)
    local lvid = get_safe_arena_lvid(p, zone.fallback_lvid)
    local gvid = zone.gvid
    return p, lvid, gvid
end

function spawn_endless_squad(wave, enemy_type)
    local cur_wave = wave or 1
    local e_type = enemy_type or "stalkers"
    
    local tier = 1
    if cur_wave >= 9 then
        tier = 5
    elseif cur_wave >= 7 then
        tier = 4
    elseif cur_wave >= 5 then
        tier = 3
    elseif cur_wave >= 3 then
        tier = 2
    end
    
    local num_enemies = cur_wave
    if num_enemies > 6 then
        num_enemies = 6
    end
    
    local a_fac = get_actor_faction()
    local rank = math.max(0, math.min(4, tier - 1))
    
    local zone_order = {}
    for z = 1, #endless_spawn_zones do
        table.insert(zone_order, z)
    end
    for i = #zone_order, 2, -1 do
        local j = math.random(i)
        zone_order[i], zone_order[j] = zone_order[j], zone_order[i]
    end

    local wave_fac = nil
    if e_type == "stalkers" then
        local fac_candidates = {}
        for _, f in ipairs(endless_enemy_factions) do
            if is_enemy_to_actor(f, a_fac) then
                table.insert(fac_candidates, f)
            end
        end
        wave_fac = (#fac_candidates > 0) and fac_candidates[math.random(#fac_candidates)] or "bandit"
    end

    local spawned_squads = {}

    for i = 1, num_enemies do
        local sec = nil
        local choose_mutant = (e_type == "mutants") or (e_type == "chaos" and (math.random(1, 2) == 1))
        
        if choose_mutant then
            local m_list = endless_mutant_sections_by_tier[tier] or endless_mutant_sections_by_tier[1]
            sec = pick_valid_section(m_list)
        else
            local chosen_fac = wave_fac
            if not chosen_fac then
                local fac_candidates = {}
                for _, f in ipairs(endless_enemy_factions) do
                    if is_enemy_to_actor(f, a_fac) then
                        table.insert(fac_candidates, f)
                    end
                end
                chosen_fac = (#fac_candidates > 0) and fac_candidates[math.random(#fac_candidates)] or "bandit"
            end
            local cand_sec = "sim_default_" .. chosen_fac .. "_" .. rank
            if chosen_fac == "army" and ini_sys:section_exist("sim_default_military_" .. rank) then
                cand_sec = "sim_default_military_" .. rank
            elseif chosen_fac == "dolg" and ini_sys:section_exist("sim_default_duty_" .. rank) then
                cand_sec = "sim_default_duty_" .. rank
            end
            if ini_sys:section_exist(cand_sec) then
                sec = cand_sec
            else
                sec = "sim_default_bandit_" .. rank
            end
        end
        
        if sec and ini_sys:section_exist(sec) then
            local z_idx = zone_order[((i - 1) % #zone_order) + 1]
            local m_pos, m_lvid, m_gvid = get_random_endless_spawn_pos(z_idx)
            
            local is_m = choose_mutant or (sec and not string.find(sec, "^sim_default_"))
            local squad_sec = is_m and "arena_tournament_mutant_squad" or "arena_tournament_enemy_squad"
            
            -- Cada combatiente se crea en su propio escuadron independiente para que no corran a reagruparse hacia un lado
            local sq = alife_create(squad_sec, m_pos, m_lvid, m_gvid)
            if sq then
                sq.scripted_target = "actor"
                sq.assigned_target_id = 0
                sq.rush_to_target = true
                sq:add_squad_member(sec, m_pos, m_lvid, m_gvid)
                sq:set_squad_relation()
                sq:refresh()
                for m in sq:squad_members() do
                    arena_spawned_combatant_ids[m.id] = true
                    if db.spawned_vertex_by_id and db.spawned_vertex_by_id[m.id] then
                        local sv = db.spawned_vertex_by_id[m.id]
                        if level.vertex_position then
                            local sv_pos = level.vertex_position(sv)
                            if sv_pos and (sv_pos.y > -19.0 or sv_pos.y < -21.5) then
                                db.spawned_vertex_by_id[m.id] = 40551
                            end
                        end
                    end
                    local se_obj = alife_object(m.id)
                    if se_obj and se_obj.position and (se_obj.position.y > -19.0 or se_obj.position.y < -21.5) then
                        se_obj.position.y = -20.0543
                    end
                end
                table.insert(spawned_squads, sq)
            end
        end
    end
    
    return spawned_squads
end

function equip_endless_random_loadout(wave)
    local cur_wave = wave or 1
    
    for item_id, _ in pairs(temporary_arena_item_ids) do
        local se_item = alife_object(item_id)
        if se_item then
            if safe_release_manager and safe_release_manager.release then
                safe_release_manager.release({ id = item_id })
            else
                alife_release(se_item)
            end
        end
    end
    temporary_arena_item_ids = {}
    
    local tier = 1
    if cur_wave >= 8 then
        tier = 5
    elseif cur_wave >= 6 then
        tier = 4
    elseif cur_wave >= 4 then
        tier = 3
    elseif cur_wave >= 2 then
        tier = 2
    end
    
    local t_data = tournament_loadouts_t[tier] or tournament_loadouts_t[1]
    
    local spawned_outfit_id = nil
    local spawned_helm_id = nil
    local outfit_sec = pick_valid_section(t_data.outfits)
    if outfit_sec then
        local se = alife_create(outfit_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then
            temporary_arena_item_ids[se.id] = true
            spawned_outfit_id = se.id
            power_up_exoskeleton(se.id, outfit_sec)
        end
    end
    
    local helm_sec = pick_valid_section(t_data.helmets)
    if helm_sec then
        local se = alife_create(helm_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then
            temporary_arena_item_ids[se.id] = true
            spawned_helm_id = se.id
        end
    end
    
    local classes = { "shotgun", "rifle", "smg", "sniper" }
    if tier == 1 then table.insert(classes, "pistol") end
    local chosen_cls = classes[math.random(#classes)]
    
    local wpn_list = t_data.weapons
    if chosen_cls == "pistol" and t_data.pistols then
        wpn_list = t_data.pistols
    elseif chosen_cls == "shotgun" and t_data.shotguns then
        wpn_list = t_data.shotguns
    elseif chosen_cls == "rifle" and t_data.rifles then
        wpn_list = t_data.rifles
    elseif chosen_cls == "smg" and t_data.smgs then
        wpn_list = t_data.smgs
    elseif chosen_cls == "sniper" and t_data.snipers then
        wpn_list = t_data.snipers
    end
    
    local spawned_wpn_id = nil
    local wpn_sec = pick_valid_section(wpn_list, last_spawned_weapon_sec) or pick_valid_section(t_data.weapons, last_spawned_weapon_sec)
    if wpn_sec then
        last_spawned_weapon_sec = wpn_sec
        local se = alife_create(wpn_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then
            temporary_arena_item_ids[se.id] = true
            spawned_wpn_id = se.id
            
            local ammo_types = { "fmj", "ap", "hp" }
            local chosen_ammo = ammo_types[math.random(#ammo_types)]
            if is_artigrok_active() and cur_wave >= 3 and math.random(1, 4) == 1 then
                chosen_ammo = "special"
            end
            local ammo_sec = get_weapon_ammo(wpn_sec, chosen_ammo)
            if ammo_sec then
                ammo_sec = spawn_and_fill_mags(wpn_sec, ammo_sec, 4, spawned_wpn_id) or ammo_sec
                local count = (t_data.ammo_count or 5) + 1
                for i = 1, count do
                    local se_ammo = alife_create(ammo_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
                    if se_ammo then temporary_arena_item_ids[se_ammo.id] = true end
                end
            end
        end
    end
    
    local knife_sec = t_data.knife or "wpn_knife"
    if ini_sys:section_exist(knife_sec) then
        local se = alife_create(knife_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        if se then temporary_arena_item_ids[se.id] = true end
    end
    
    if t_data.meds then
        for _, med_sec in ipairs(t_data.meds) do
            if ini_sys:section_exist(med_sec) then
                local se = alife_create(med_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
                if se then temporary_arena_item_ids[se.id] = true end
            end
        end
    end
    
    if xcvb_arena_fight and xcvb_arena_fight.heal_actor_completely then
        xcvb_arena_fight.heal_actor_completely()
    else
        if db.actor then
            db.actor.health = 1.0
            db.actor.bleeding = 1.0
            db.actor.radiation = 0
            db.actor.psy_health = 1.0
            db.actor.power = 1.0
        end
        if zzz_player_injuries and zzz_player_injuries.health and zzz_player_injuries.maxhp then
            pcall(function()
                local bhs_parts = {"head", "torso", "rightarm", "leftarm", "rightleg", "leftleg"}
                local sv = (utils_obj and utils_obj.save_var) or _G.save_var
                for _, part in ipairs(bhs_parts) do
                    local max_v = (zzz_player_injuries.maxhp and zzz_player_injuries.maxhp[part]) or ((part == "head" or part == "torso") and 11 or 5)
                    zzz_player_injuries.health[part] = max_v
                    if zzz_player_injuries.timedhp then zzz_player_injuries.timedhp[part] = 0 end
                    if sv and db.actor then
                        pcall(sv, db.actor, "health." .. part, max_v)
                        pcall(sv, db.actor, "timedhp." .. part, 0)
                    end
                end
                zzz_player_injuries.myhealth = 1.0
            end)
        end
    end
    
    CreateTimeEvent("arena_equip_endless_e1", "arena_equip_endless_a1", 0.3, function()
        local outfit_obj = spawned_outfit_id and level.object_by_id(spawned_outfit_id)
        if not outfit_obj then
            db.actor:iterate_inventory(function(_, itm)
                if is_outfit_item(itm) and temporary_arena_item_ids[itm:id()] then
                    outfit_obj = itm
                    return true
                end
            end, db.actor)
        end
        if outfit_obj then
            db.actor:move_to_slot(outfit_obj, 7)
        end
        
        if spawned_wpn_id then
            local wpn_obj = level.object_by_id(spawned_wpn_id)
            if wpn_obj then
                if chosen_cls == "pistol" then
                    db.actor:move_to_slot(wpn_obj, 1)
                    db.actor:activate_slot(1)
                else
                    db.actor:move_to_slot(wpn_obj, 2)
                    db.actor:activate_slot(2)
                end
            end
        end
        return true
    end)
    
    CreateTimeEvent("arena_equip_endless_e2", "arena_equip_endless_a2", 0.5, function()
        local helm_obj = spawned_helm_id and level.object_by_id(spawned_helm_id)
        if not helm_obj then
            db.actor:iterate_inventory(function(_, itm)
                if is_helmet_item(itm) and temporary_arena_item_ids[itm:id()] then
                    helm_obj = itm
                    return true
                end
            end, db.actor)
        end
        if helm_obj then
            db.actor:move_to_slot(helm_obj, 12)
        end
        return true
    end)
end