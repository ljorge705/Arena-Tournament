    { x = 112.7, y = -21.060, z = 103.6, lvid = 103341, pos = vector():set(112.7, -21.060, 103.6) }, -- Avanzada este
    { x = 101.5, y = -20.888, z = 105.0, lvid = 102458, pos = vector():set(101.5, -20.888, 105.0) }, -- Avanzada oeste
}

