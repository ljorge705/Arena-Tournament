    { x = 113.4, y = -21.017, z = 103.6, lvid = 103406, pos = vector():set(113.4, -21.017, 103.6) }, -- Flanco Este
    { x = 100.8, y = -20.908, z = 105.0, lvid = 102416, pos = vector():set(100.8, -20.908, 105.0) }, -- Flanco Oeste
