    { x = 113.4, y = -21.017, z = 103.6, lvid = 103406, pos = vector():set(113.4, -21.017, 103.6) }, -- Centro-Este
}

BEHAVIOR = {
    -- Con el level.ai de Forest, la IA nativa ya puede llegar al jugador. Mantener
    -- esto en false evita competir con xr_combat enviando destinos cada 500 ms.
    force_initial_advance = false,

    -- Umbral de pánico del NPC (0.0 = nunca se rinde o congela, pelea usando coberturas)
    panic_threshold = 0.0,

    -- Estado de animación al caminar hacia el centro al spawnear ("raid", "patrol")
    -- "raid" = camina en guardia táctica con el arma levantada listo para el combate
    initial_advance_state = "raid",

    -- Distancia al punto central para considerar completado el avance inicial (en metros)
    advance_arrival_dist = 4.5,

    -- Distancia para cambiar al siguiente punto del circuito Endless.
    explore_arrival_dist = 3.5,

    -- En torneo normal continúan corriendo hacia el jugador hasta esta distancia,
    -- incluso si ya existe contacto visual.
    tournament_rush_stop_dist = 12.0,

    -- A esta distancia los stalkers Endless dejan la ruta guiada y xr_combat
    -- toma el control para avanzar, flanquear y utilizar coberturas.
    endless_cover_control_dist = 28.0,
}

-- -----------------------------------------------------------------------------
-- 4. VISIÓN NOCTURNA Y COMBATE NOCTURNO EN EL BOSQUE
-- -----------------------------------------------------------------------------
NIGHT = {
    -- Rango de visión de NPCs con Linterna Frontal encendida (en metros)
    torch_range = 45.0,
    -- Rango de visión de NPCs Élite con Visor Nocturno (NVG) (en metros)
    nvg_range   = 55.0,
    -- Rango de visión de NPCs de pie en oscuridad total sin linterna (en metros)
    dark_stand_range  = 24.0,
    -- Rango de visión de NPCs agachados en oscuridad total (en metros)
    dark_crouch_range = 18.0,
    -- Distancia a la que se escuchan pasos al trotar/caminar en la oscuridad (en metros)
    hearing_footsteps_range = 8.0,
    -- Distancia a quemarropa donde siempre se detecta al enemigo (en metros)
    point_blank_range = 4.0,
    -- Ángulo de campo de visión (FOV en grados)
    fov = 115.0,

    -- Mantener el asalto activo de noche (evita que la IA busque irse a dormir al Bar de Rostok)
    keep_rush_active = true,
}

-- -----------------------------------------------------------------------------
-- 5. ANTI-WALLHACK Y COMPORTAMIENTO LIMPIO
-- -----------------------------------------------------------------------------
ANTI_WALLHACK = {
    -- Si es false, se prohíbe terminantemente `make_enemy_visible` (la IA solo ve con línea de visión real)
    allow_forced_visibility = false,

    -- Si es false, se prohíben los pulsos de daño invisible `scr_hit` que revelaban al jugador en cobertura
    allow_artificial_hits = false,

    -- Alerta por disparo: si el jugador dispara o daña a un enemigo, la escuadra se coordina hacia la zona del disparo
    alert_squad_on_player_fire = true,
}
