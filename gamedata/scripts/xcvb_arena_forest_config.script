-- -----------------------------------------------------------------------------
-- 2. LÍMITES GEOMÉTRICOS DEL BOSQUE (PERÍMETRO Y SEGURIDAD)
-- -----------------------------------------------------------------------------
BOUNDS = {
    min_x = 93.5,     -- Límite oeste (valla/pared rocosa)
    max_x = 121.2,    -- Límite este (IMPORTANTE: El puente a Rostok inicia en 121.8; mantener <= 121.2)
    min_z = 75.0,     -- Límite sur (fondo sector jugador)
    max_z = 132.5,    -- Límite norte (fondo sector enemigos)
    ground_y = -21.060,
    max_y = -19.0,    -- Si Y > -19, el NPC cayó del mapa o está flotando
    corridor_safe_x_max = 120.8, -- Máximo X permitido para generar destinos tácticos
}

-- -----------------------------------------------------------------------------
-- 3. AVANCE HACIA EL CENTRO Y COMPORTAMIENTO NATIVO DE COMBATE
-- -----------------------------------------------------------------------------
-- Puntos de avance inicial hacia el centro del bosque (hacia donde caminan al spawnear)
-- La zona central del bosque contiene las coberturas bajas, árboles y rocas (Z ~ 103..108).
-- Al llegar al centro o al detectar al jugador, se detiene el avance guiado y la IA
-- nativa del motor toma el control total para cubrirse y combatir.
CENTER_ADVANCE_TARGETS = {
    { x = 108.5, y = -21.060, z = 103.6, lvid = 102983, pos = vector():set(108.5, -21.060, 103.6) }, -- Centro principal
