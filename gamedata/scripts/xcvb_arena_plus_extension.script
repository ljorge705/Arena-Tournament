-- Optional engine integrations for the persistent Endless+ controller.
local blur_id = 987141
local blur_visible = false
local blur_owner = nil
local function controller() return xcvb_arena_plus end
local function state() return controller().state end
local function helpers() return controller().extension_helpers() end
local function clone(value) return helpers().clone(value) end
local function name(sec) return game.translate_string(ini_sys:r_string_ex(sec, "inv_name") or sec) end
local function sample(list)
    local pool, out = clone(list), {}
    while #pool > 0 and #out < 3 do out[#out + 1] = table.remove(pool, math.random(#pool)) end
    return out
end
local function candidates(list, kind)
    local out = {}
    for _, sec in ipairs(list or {}) do
        if ini_sys:section_exist(sec) then out[#out + 1] = {sec = sec, kind = kind} end
    end
    return sample(out)
end

function enemy_multiplier()
    local s = state()
    return s.active and s.preparation_version == 2 and (s.wave == 1 and 0.5 or s.wave == 2 and 0.75 or 1) or 1
end

function prepare_initial()
    local s = state(); local gear = xcvb_arena_utils.tournament_loadouts_t[1] or {}
    s.initial_step = "weapon"
    s.initial_protection = {outfits = candidates(gear.outfits, "outfit"), helmets = {}}
    for _, outfit in ipairs(s.initial_protection.outfits) do
        local allowed = ini_sys:r_bool_ex(outfit.sec, "helmet_avaliable", true)
        s.initial_protection.helmets[outfit.sec] = allowed and candidates(gear.helmets, "helmet") or {}
    end
end

local function initial_screen(step)
    local s = state(); s.initial_step = step
    if step == "weapon" then
        controller().select_initial_tier(s.start_tier or 1); s.offers = {"weapon"}
    elseif step == "outfit" then s.offers = {"initial_outfit"}; s.candidates = s.initial_protection.outfits
    elseif step == "helmet" then
        s.offers = {"initial_helmet"}; s.candidates = s.initial_protection.helmets[s.initial_outfit] or {}
    else s.offers = {"initial_ready"}; s.candidates = {s.initial_weapon} end
    controller().open_ui()
end

function initial_back()
    local s = state()
    if not s.initial_choice or not s.initial_step or s.initial_step == "weapon" then return false end
    initial_screen(s.initial_step == "outfit" and "weapon" or s.initial_step == "helmet" and "outfit"
        or s.initial_helmet and "helmet" or "outfit")
    return true
end

function choose_initial(id, index)
    local s = state()
    if not s.initial_choice or not s.initial_step or id == "retire" then return nil end
    if id == "initial_ready" then
        if s.initial_step ~= "review" or not s.initial_weapon or not s.initial_outfit then return false end
        return nil -- the controller commits the complete loadout exactly once
    end
    local expected = s.initial_step == "weapon" and "weapon" or "initial_" .. s.initial_step
    local candidate = s.candidates[index or 0]
    if id ~= expected or not candidate then return false end
    if id == "weapon" then
        s.initial_weapon = clone(candidate)
        if #s.initial_protection.outfits == 0 then return false end
        initial_screen("outfit")
    elseif id == "initial_outfit" then
        s.initial_outfit, s.initial_helmet = candidate.sec, nil
        initial_screen(#(s.initial_protection.helmets[candidate.sec] or {}) > 0 and "helmet" or "review")
    elseif id == "initial_helmet" then s.initial_helmet = candidate.sec; initial_screen("review")
    else return false end
    return true
end

function initial_summary()
    local s = state()
    if not s.initial_weapon then return "" end
    return name(s.initial_weapon.sec) .. "\\n" .. (s.initial_outfit and name(s.initial_outfit) or "")
        .. "\\n" .. (s.initial_helmet and name(s.initial_helmet) or controller().text("no_separate_helmet"))
end

function grant_initial_gear(p)
    local s, h = state(), helpers()
    p.initial_outfit = h.grant(s.initial_outfit)
    if s.initial_helmet then p.initial_helmet = h.grant(s.initial_helmet) end
    for _, slot in ipairs({7, 12}) do
        local old = db.actor:item_in_slot(slot)
        if old and not (xcvb_arena_utils.saved_actor_item_ids or {})[old:id()] then h.release(old:id()) end
    end
end

function initial_gear_ready(p)
    for _, pair in ipairs({{p.initial_outfit, 7}, {p.initial_helmet, 12}}) do
        if pair[1] then
            local obj = db.actor:object_id(pair[1]); local equipped = db.actor:item_in_slot(pair[2])
            if not obj then return false end
            if not equipped or equipped:id() ~= pair[1] then
                if p.tries % 5 == 1 then obj:set_condition(1); xcvb_arena_utils.arena_move_to_slot(obj, pair[2]) end
                return false
            end
        end
    end
    return true
end

local function battery_for(sec)
    if not xcvb_arena_utils.is_powered_scope_or_weapon(sec) then return false end
    if not se_save_var then return nil end
    local battery_sec = ini_sys:r_string_ex("3dss_thermal_battery", "battery_section") or "batteries_dead"
    local found
    db.actor:iterate_inventory(function(_, obj)
        if not found and obj:section() == battery_sec and obj:condition() > 0
            and not (xcvb_arena_utils.saved_actor_item_ids or {})[obj:id()] then found = obj end
    end, db.actor)
    return found
end

local function same_ammo(a, b)
    local function tokens(sec)
        local out = {}; for v in string.gmatch(ini_sys:r_string_ex(sec, "ammo_class") or "", "[^,%s]+") do out[#out + 1] = v end
        return table.concat(out, ",")
    end
    return tokens(a) == tokens(b)
end

function jam_supported()
    return arti_jamming and type(arti_jamming.get_jammed) == "function"
        and type(arti_jamming.set_jam_status) == "function"
end

local function eligible_scopes()
    local p, s = controller(), state(); local w = p.weapon()
    if not w or not xcvb_arena_main.endless_3dssg or not alife or not z_3d_scopes then return {} end
    local parent = ini_sys:r_string_ex(w:section(), "parent_section") or w:section()
    -- Keep existing/integrated optics intact; this offer installs the first optic.
    if parent ~= w:section() then return {} end
    local limit = ({10000, 20000, 35000, 60000, math.huge})[p.tier()]
    local out = {}
    for _, sec in ipairs(xcvb_arena_utils.get_weapon_scopes(parent) or {}) do
        local child = parent .. "_" .. sec
        -- r_s32_ex is not exported by Anomaly's ini binding. Read optional
        -- numbers through the supported string accessor instead.
        local required = tonumber(ini_sys:r_string_ex(sec, "arena_scope_tier"))
        local cost = tonumber(ini_sys:r_string_ex(sec, "cost")) or 0
        -- get_weapon_scopes already validates the addon section and child.
        -- Some 3DSS addons lack the generic inventory "scope" classification.
        if not ini_sys:r_bool_ex(sec, "weapon_kit", false)
            and ini_sys:section_exist(child) and same_ammo(parent, child)
            and (required and required <= p.tier() or not required and
                (guided_free() and s.cleared == 2 or cost <= limit))
            and battery_for(child) ~= nil then
            out[#out + 1] = {sec = sec, child = child, kind = "scope"}
        end
    end
    return out
end

function add_scope_offer(pool)
    local s = state()
    if not s.scope_candidates then
        s.scope_candidates = sample(eligible_scopes())
        s.scope_offer = #s.scope_candidates > 0 and (jam_supported() and math.random(2) == 2 and "scope_jam" or "scope_blur") or nil
    end
    if s.scope_offer then pool[#pool + 1] = s.scope_offer end
end

function scope_choice_valid(id, index)
    local s = state(); local pick = s.scope_candidates and s.scope_candidates[index or 0]
    if not pick or s.scope_offer ~= id or id == "scope_jam" and not jam_supported() then return false end
    for _, candidate in ipairs(eligible_scopes()) do if candidate.sec == pick.sec then return true end end
    return false
end

function guided_offers()
    local s, p = state(), controller()
    if s.preparation_version ~= 2 then return end
    s.guided_choices_version = 2
    if s.cleared == 1 then
        local pool = {}
        if p.available_supply("supply_ammo") then pool[#pool + 1] = "supply_ammo" end
        if p.available_supply("supply_mag") then pool[#pool + 1] = "supply_mag" end
        for _, fallback in ipairs({"cache", "medical", "workshop"}) do
            if #pool >= 3 then break end
            -- cache/medical always provide consumables; workshop still requires springs.
            if fallback ~= "workshop" then pool[#pool + 1] = fallback end
        end
        s.offers = pool
    elseif s.cleared == 2 then
        local wanted = {heal=true, heal_wear=true, heal_partial=true, heal_field=true,
            medical=true, gun_service=true, armour_service=true, springs=true, workshop=true}
        local pool = {}
        for _, id in ipairs(p.valid_offers()) do if wanted[id] then pool[#pool + 1] = id end end
        local selected = {}
        -- Optics are a guaranteed card before wave 3, not a random medical roll.
        selected[1] = s.scope_offer or "scope_unavailable"
        local medical = sample(pool)
        for _, id in ipairs(medical) do if #selected < 3 then selected[#selected + 1] = id end end
        if #selected < 3 then selected[#selected + 1] = "supply_ammo" end
        if #selected < 3 and p.available_supply("supply_mag") then selected[#selected + 1] = "supply_mag" end
        s.offers = selected
    end
end

function guided_free()
    local s = state()
    return s.preparation_version == 2 and not s.initial_choice and (s.cleared == 1 or s.cleared == 2)
        and (s.phase == "choice" or s.phase == "applying")
end

function free_supplies()
    if not guided_free() then return end
    for _, roll in pairs(state().supplies or {}) do
        roll.penalty, roll.amount, roll.condition = "none", 0, 100
    end
end

function description(id)
    local s, p = state(), controller()
    if id == "scope_unavailable" then return p.text("scope_unavailable_desc") end
    if guided_free() and (id == "scope_blur" or id == "scope_jam") then return p.colour_description(p.text("scope_free_desc")) end
    if id == "scope_blur" or id == "scope_jam" or id == "initial_outfit" or id == "initial_helmet" then
        return p.colour_description(p.text(id .. "_desc"))
    elseif id == "initial_ready" then return initial_summary() .. "\\n" .. p.starting_description() end
end

-- A native server clone preserves addon flags, upgrades and ammo type. Keep the
-- original alive until the clone has materialized and its exact slot is verified.
function begin_scope(id, index)
    local s, h = state(), helpers(); local w = assert(controller().weapon())
    local pick = assert(s.scope_candidates[index]); local battery = battery_for(pick.child)
    assert(battery ~= nil, "Scope requires a usable battery")
    local slot
    for i = 1, xcvb_arena_utils.arena_last_inventory_slot() do
        local obj = db.actor:item_in_slot(i); if obj and obj:id() == w:id() then slot = i; break end
    end
    local parts = item_parts and item_parts.get_parts_con and item_parts.get_parts_con(w, nil, true)
    local storage = alife_storage_manager and alife_storage_manager.get_state().se_object
    local p = {scope = true, tries = 0, old = w:id(), old_sec = w:section(), child = pick.child,
        scope_sec = pick.sec, cost = id, slot = assert(slot), active = db.actor:active_slot(),
        condition = w:condition(), ammo_type = w:get_ammo_type(), rounds = w:get_ammo_in_magazine(),
        parts = parts and clone(parts), data = magazine_binder and clone(magazine_binder.get_data(w:id())),
        jam = jam_supported() and arti_jamming.get_jammed(w:id()),
        entity_data = storage and clone(storage[w:id()]), battery = battery and battery:id(),
        charge = battery and battery:condition(), free = guided_free()}
    s.pending = p
    local sim = alife(); local original = assert(alife_object(w:id()))
    local cloned, se = pcall(sim.clone_weapon, sim, original, pick.child, original.position, original.m_level_vertex_id,
        original.m_game_vertex_id, db.actor:id(), false)
    if not cloned then se = nil end
    if not se then
        s.pending, s.phase, s.selected = nil, "choice", nil
        controller().open_ui(); return
    end
    p.id = se.id
    xcvb_arena_utils.temporary_arena_item_ids[se.id] = true
    if storage and p.entity_data then storage[se.id] = clone(p.entity_data) end
    if p.parts and item_parts.set_parts_con then item_parts.set_parts_con(se.id, clone(p.parts)) end
    if p.data then magazine_binder.set_data(se.id, clone(p.data)) end
    if alife_record then alife_record(se, true) end
    sim:register(se)
end

function abort_scope(p, err)
    printe("! Endless+ scope operation: %s", tostring(err))
    if p.committed then return "done" end
    if p.id then helpers().release(p.id) end
    local old = db.actor:object_id(p.old)
    if old then xcvb_arena_utils.arena_move_to_slot(old, p.slot); db.actor:activate_slot(p.active) end
    local s = state(); s.pending, s.phase, s.selected = nil, "choice", nil
    controller().open_ui()
    return "failed"
end

local function restore_scope_data(p, obj)
    obj:set_condition(p.condition)
    obj:set_ammo_type(p.ammo_type); obj:set_ammo_elapsed(p.rounds)
    if p.parts and item_parts and item_parts.set_parts_con then
        item_parts.set_parts_con(obj:id(), clone(p.parts))
        if arti_jamming and arti_jamming.update_part_con then
            for key, value in pairs(p.parts) do
                if type(value) == "number" then arti_jamming.update_part_con(obj:id(), key, value) end
            end
        end
    end
    if p.data and magazine_binder then magazine_binder.set_data(obj:id(), clone(p.data)) end
    if p.jam and jam_supported() then arti_jamming.set_jam_status(obj:id(), p.jam) end
end

function tick_scope(p)
    local s, h = state(), helpers()
    local obj = p.id and db.actor:object_id(p.id)
    if not p.committed and p.tries >= 100 then
        if p.id then h.release(p.id) end
        local old = db.actor:object_id(p.old)
        if old then xcvb_arena_utils.arena_move_to_slot(old, p.slot); db.actor:activate_slot(p.active) end
        s.pending, s.phase, s.selected = nil, "choice", nil
        controller().open_ui(); return "failed"
    end
    if not obj then return end
    if not p.prepared then
        restore_scope_data(p, obj)
        p.prepared = true
    end
    local current = db.actor:item_in_slot(p.slot)
    if not current or current:id() ~= p.id then
        if p.tries % 5 == 1 then xcvb_arena_utils.arena_move_to_slot(obj, p.slot) end
        return
    end
    if not p.committed then
        if p.battery then
            local battery = db.actor:object_id(p.battery)
            if not battery then p.tries = 100; return end
            se_save_var(p.id, nil, "3dss_thermal_battery", {version = 2, main = {section = p.scope_sec, charge = p.charge}})
            if not p.free then h.release(p.battery) end
        end
        restore_scope_data(p, obj)
        p.committed = true
        h.release(p.old)
        if not p.free then
            s.scope_penalty = {kind = p.cost, weapon_id = p.id, wave = s.wave,
                remaining = p.cost == "scope_blur" and 10000 or nil}
        end
    end
    if db.actor:active_slot() ~= p.active then db.actor:activate_slot(p.active); return end
    if z_3d_scopes and z_3d_scopes.update_shader then z_3d_scopes.update_shader(obj) end
    if z_mark_switch and z_mark_switch.refresh_weapon then z_mark_switch.refresh_weapon(obj) end
    if z_3dss_thermal_battery and z_3dss_thermal_battery.refresh_weapon_textures then
        z_3dss_thermal_battery.refresh_weapon_textures(obj, true)
    end
    return "done"
end

function reset_effect()
    -- Loading and actor destruction run without a valid native Actor camera.
    -- The old camera owns/destroys its effectors; only forget Lua ownership here.
    blur_visible, blur_owner = false, nil
end

function clear_effect()
    if blur_visible and db and db.actor and db.actor == blur_owner
        and level and level.remove_pp_effector then
        level.remove_pp_effector(blur_id)
    end
    reset_effect()
end

function expire_penalty()
    clear_effect(); state().scope_penalty = nil
    state().scope_candidates, state().scope_offer = nil, nil
end

function tick_penalty(dt)
    local s = state(); local p = s.scope_penalty
    if not p or p.wave ~= s.wave or p.kind ~= "scope_blur" then return end
    if p.remaining > 0 then
        if not blur_visible then
            level.add_pp_effector("arena_scope_blur.ppe", blur_id, true)
            blur_visible = true
            blur_owner = db.actor
        end
        p.remaining = math.max(0, p.remaining - dt)
    end
    if p.remaining <= 0 then clear_effect() end
end

function weapon_fired(actor, wpn)
    local p = state().scope_penalty
    if not p or not controller().in_combat() or p.wave ~= state().wave or p.kind ~= "scope_jam"
        or not wpn or wpn:id() ~= p.weapon_id or not jam_supported()
        or (wpn.weapon_in_grenade_mode and wpn:weapon_in_grenade_mode()) or arti_jamming.get_jammed(wpn:id()) then return end
    if math.random(100) <= 30 then
        arti_jamming.set_jam_status(wpn:id(), 2)
        if SendScriptCallback then SendScriptCallback("actor_on_weapon_jammed_wpo", wpn, 2) end
    end
end

function register_callbacks()
    if xcvb_arena_runtime then xcvb_arena_runtime.protect(xcvb_arena_plus_extension) end
    RegisterScriptCallback("actor_on_weapon_fired", weapon_fired)
    RegisterScriptCallback("actor_on_net_destroy", reset_effect)
end

function icon_section(id)
    local p, s = controller(), state(); local w = p.weapon()
    if id == "scope_blur" or id == "scope_jam" then return s.scope_candidates and s.scope_candidates[1] and s.scope_candidates[1].sec end
    if id == "supply_mag" then return s.supplies and s.supplies.mag and s.supplies.mag.sec end
    if id == "supply_ammo" or id == "ammo" or id == "cache" then return w and xcvb_arena_utils.get_weapon_ammo(w:section(), "fmj") end
    if id == "helmet" then return s.rolls and s.rolls.helmet and s.rolls.helmet.sec end
    if id == "armour" or id == "armour_service" then local obj = db.actor:item_in_slot(7); return obj and obj:section() end
    if id == "medical" or string.find(id or "", "heal", 1, true) then return "medkit" end
    if id == "scavenged" then return s.rolls and s.rolls.scavenged and s.rolls.scavenged.mags[1] and s.rolls.scavenged.mags[1].sec end
    return w and w:section()
end
