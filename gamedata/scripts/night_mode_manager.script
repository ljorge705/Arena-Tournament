-- ============================================================
-- night_mode_manager.script
-- "Modo Noche" oscuro y realista para STALKER Anomaly 1.5.2
-- Motor: X-Ray Monolith (LuaJIT) + Screen Space Shaders (SSFX)
--
-- Uso desde consola / otros scripts:
--   night_mode_manager.enable()   -- activa modo noche
--   night_mode_manager.disable()  -- restaura todo
--   night_mode_manager.toggle()   -- conmuta
--
-- Tambien expone globales legacy:
--   enable_night_mode() / disable_night_mode() / toggle_night_mode()
-- ============================================================

local TARGET_HOUR = 2
local TARGET_MIN  = 30
local TARGET_TOTAL_MIN = TARGET_HOUR * 60 + TARGET_MIN -- 150 (02:30 AM)

local NIGHT_RANGE = 12.0
local NIGHT_FOV   = 65.0

-- Cvars gestionados + valor nocturno deseado (string tal cual se envia a consola)
local NIGHT_CVARS = {
  { name = "r2_sun_lumscale",     night = "0.0"     },
  { name = "r2_sun_lumscale_amb", night = "0.0"     },
  { name = "r2_tonemap_lowlum",   night = "0.8"     },
  { name = "ssfx_is_underground", night = "1"       },
  { name = "ssfx_fog_scattering", night = "0"       },
  { name = "ssfx_volumetric",     night = "0,0,0,0" },
  { name = "r2_volumetric_lights",night = "off"     },
}

-- Estado interno (no persistente entre saves salvo flag)
local saved_cvars = {}   -- tabla temporal: name -> string valor original
local is_enabled  = false
local saved_npc_vision = {} -- id -> {range, fov} (best-effort, si el engine expone getters)
local pending_time_jump = false -- true si se activo desde menu principal (sin level): el salto a 02:30 se aplica al cargar partida

-- ============================================================
-- 0. Utilidades de consola (robustas entre forks de Monolith)
-- ============================================================
local function get_con()
  if get_console == nil then
    return nil
  end
  local ok, con = pcall(get_console)
  if ok then
    return con
  end
  return nil
end

local function con_get(name)
  local con = get_con()
  if con == nil or name == nil then
    return nil
  end
  -- Intentar varios accessors segun build: get_string > get > :get_string
  if con.get_string ~= nil then
    local ok, v = pcall(function() return con:get_string(name) end)
    if ok and v ~= nil then return tostring(v) end
  end
  if con.get ~= nil then
    local ok, v = pcall(function() return con:get(name) end)
    if ok and v ~= nil then return tostring(v) end
  end
  -- ultimo recurso: execute con retorno? no soportado, devolver nil
  return nil
end

local function con_exec(cmd)
  local con = get_con()
  if con == nil or cmd == nil then
    return false
  end
  local ok = pcall(function() con:execute(cmd) end)
  return ok == true
end

local function con_set(name, value)
  if name == nil or value == nil then
    return false
  end
  return con_exec(name .. " " .. tostring(value))
end

-- ============================================================
-- 1. Gestion de Cvars y SSFX
-- ============================================================
local function save_current_cvars()
  saved_cvars = {}
  for _, entry in ipairs(NIGHT_CVARS) do
    local v = con_get(entry.name)
    -- Guardar aunque sea nil (marcamos con false para saber restaurar solo si habia valor)
    if v ~= nil then
      saved_cvars[entry.name] = v
    else
      saved_cvars[entry.name] = false
    end
  end
end

local function apply_night_cvars()
  for _, entry in ipairs(NIGHT_CVARS) do
    con_set(entry.name, entry.night)
  end
end

local function restore_saved_cvars()
  for _, entry in ipairs(NIGHT_CVARS) do
    local saved = saved_cvars[entry.name]
    if saved ~= nil and saved ~= false then
      con_set(entry.name, saved)
    end
    -- si saved == false significa que el cvar no existia / no se pudo leer:
    -- no tocamos nada para no romper builds sin SSFX.
  end
  saved_cvars = {}
end

-- ============================================================
-- 2. Salto de tiempo y clima
-- ============================================================
local function get_current_time_min()
  -- level.get_time_hours()/get_time_minutes() existen en todos los X-Ray.
  local ok_h, h = pcall(function() return level.get_time_hours() end)
  local ok_m, m = pcall(function() return level.get_time_minutes() end)
  if ok_h and ok_m and h ~= nil and m ~= nil then
    return (tonumber(h) or 0) * 60 + (tonumber(m) or 0)
  end
  -- Fallback via game.get_game_time(): formato H:M
  local ok_t, ct = pcall(function() return game.get_game_time() end)
  if ok_t and ct ~= nil then
    local ok2_h, hh = pcall(function() return ct:getH() end)
    local ok2_m, mm = pcall(function() return ct:getM() end)
    if ok2_h and ok2_m then
      return (tonumber(hh) or 0) * 60 + (tonumber(mm) or 0)
    end
  end
  return nil
end

-- Minutos restantes hasta las 02:30 AM (siguiente ocurrencia, wrap 24h)
local function minutes_until_0230()
  local now_min = get_current_time_min()
  if now_min == nil then
    return 0
  end
  local diff = TARGET_TOTAL_MIN - now_min
  if diff <= 0 then
    diff = diff + 24 * 60
  end
  return diff
end

local function force_weather_update()
  -- level_weathers es global de Anomaly (weather_manager.ltx wrapper).
  -- pcall para no tumbar el script si el mod de clima no esta cargado.
  pcall(function()
    if level_weathers ~= nil and level_weathers.get_weather_manager ~= nil then
      local wm = level_weathers.get_weather_manager()
      if wm ~= nil and wm.forced_weather_change ~= nil then
        wm:forced_weather_change()
      end
    end
  end)
end

local function jump_to_0230()
  local mins = minutes_until_0230()
  if mins ~= nil and mins > 0 then
    -- Firma X-Ray: level.change_game_time(days, hours, mins, secs, ms)
    pcall(function() level.change_game_time(0, 0, math.floor(mins), 0, 0) end)
  end
  -- Inmediatamente despues, forzar actualizacion del clima
  force_weather_update()
  return mins or 0
end

-- ============================================================
-- 3. Proteccion de estadisticas (hambre / sed / sueno / salud)
-- ============================================================
-- El salto de tiempo drena needs del actor. Capturamos antes y
-- reinyectamos 0.3s despues via CreateTimeEvent.
local function capture_actor_stats()
  local a = (db ~= nil) and db.actor or nil
  if a == nil then
    return nil
  end
  local st = {}
  -- pcall individual: cada fork expone un subset distinto.
  pcall(function() st.health     = a.health end)
  pcall(function() st.power      = a.power end)      -- fatiga / stamina
  pcall(function() st.satiety    = a.satiety end)    -- hambre
  pcall(function() st.thirst     = a.thirst end)     -- sed (Anomaly 1.5.x)
  pcall(function() st.sleepiness = a.sleepiness end)-- sueno (Anomaly 1.5.x)
  pcall(function() st.bleeding   = a.bleeding end)
  pcall(function() st.psy_health = a.psy_health end)
  pcall(function() st.radiation  = a.radiation end)
  return st
end

local function restore_actor_stats(st)
  if st == nil then
    return
  end
  local a = (db ~= nil) and db.actor or nil
  if a == nil then
    return
  end
  -- Inyeccion directa, protegida campo a campo.
  if st.health     ~= nil then pcall(function() a.health     = st.health end) end
  if st.power      ~= nil then pcall(function() a.power      = st.power end) end
  if st.satiety    ~= nil then pcall(function() a.satiety    = st.satiety end) end
  if st.thirst     ~= nil then pcall(function() a.thirst     = st.thirst end) end
  if st.sleepiness ~= nil then pcall(function() a.sleepiness = st.sleepiness end) end
  if st.bleeding   ~= nil then pcall(function() a.bleeding   = st.bleeding end) end
  if st.psy_health ~= nil then pcall(function() a.psy_health = st.psy_health end) end
  if st.radiation  ~= nil then pcall(function() a.radiation  = st.radiation end) end
end

local function schedule_stats_restore(st)
  if st == nil then
    return
  end
  -- Evitar duplicados si se spamea el toggle
  pcall(function() RemoveTimeEvent("night_mode_restore_stats_e", "night_mode_restore_stats_a") end)
  CreateTimeEvent("night_mode_restore_stats_e", "night_mode_restore_stats_a", 0.3, function()
    restore_actor_stats(st)
    return true -- one-shot: elimina el evento
  end)
end

-- ============================================================
-- 4. Manipulacion de lamparas (hanging_lamp / projector)
-- ============================================================
local function is_lamp_se_object(se_obj)
  if se_obj == nil then
    return false
  end
  local ok_cls, cls = pcall(function() return se_obj:clsid() end)
  if not ok_cls or cls == nil then
    return false
  end
  -- clsid es tabla global en scripts de X-Ray; comparar por referencia si existe.
  local ok_cmp, res = pcall(function()
    if clsid ~= nil then
      return cls == clsid.hanging_lamp or cls == clsid.projector
    end
    return false
  end)
  return ok_cmp and res == true
end

local function turn_off_lamps()
  local sim = nil
  pcall(function() sim = alife() end)
  if sim == nil then
    return 0
  end
  local count = 0
  -- Patron estandar Monolith: barrido 1..65534 con sim:object(id)
  for id = 1, 65534 do
    local se = nil
    pcall(function() se = sim:object(id) end)
    if se ~= nil and is_lamp_se_object(se) then
      -- El metodo :turn_off() vive en el objeto cliente (level.object_by_id),
      -- no en el server object. Intentar ambos por compatibilidad.
      pcall(function()
        local online = nil
        if level ~= nil and level.object_by_id ~= nil then
          online = level.object_by_id(id)
        end
        if online ~= nil and online.turn_off ~= nil then
          online:turn_off()
          count = count + 1
        elseif se.turn_off ~= nil then
          se:turn_off()
          count = count + 1
        end
      end)
    end
  end
  return count
end

-- ============================================================
-- 5. Nerf a la vision de NPCs (ceguera nocturna simulada)
-- ============================================================
local function nerf_single_npc(npc)
  if npc == nil then
    return false
  end
  local ok_alive = pcall(function() return npc:alive() end)
  -- si alive() falla (no es NPC), salir
  if ok_alive then
    local alive = npc:alive()
    if alive == false then
      return false
    end
  end
  -- Guardar vision original (best-effort; muchos builds no exponen getters)
  pcall(function()
    local nid = npc:id()
    if saved_npc_vision[nid] == nil then
      local r, f = nil, nil
      -- Algunos forks exponen npc:range() / npc:fov(); si no, queda nil.
      pcall(function() if npc.range ~= nil then r = npc:range() end end)
      pcall(function() if npc.fov ~= nil then f = npc:fov() end end)
      saved_npc_vision[nid] = { range = r, fov = f }
    end
  end)
  pcall(function() npc:set_range(NIGHT_RANGE) end)
  pcall(function() npc:set_fov(NIGHT_FOV) end)
  return true
end

local function restore_single_npc(npc)
  if npc == nil then
    return
  end
  local nid = nil
  pcall(function() nid = npc:id() end)
  local saved = (nid ~= nil) and saved_npc_vision[nid] or nil
  if saved ~= nil and (saved.range ~= nil or saved.fov ~= nil) then
    if saved.range ~= nil then pcall(function() npc:set_range(saved.range) end) end
    if saved.fov   ~= nil then pcall(function() npc:set_fov(saved.fov) end) end
  else
    -- Sin valores originales conocidos, devolver a defaults razonables
    -- de Anomaly (no pisar si el build no soporta el setter).
    pcall(function() npc:set_range(60.0) end)
    pcall(function() npc:set_fov(100.0) end)
  end
end

local function for_each_online_squad_member(fn)
  local sim = nil
  pcall(function() sim = alife() end)
  if sim == nil or fn == nil then
    return 0
  end
  local touched = 0
  -- Via 1 (preferida si existe): sim:iterate_squads()
  local used_iterator = false
  pcall(function()
    if sim.iterate_squads ~= nil then
      -- firma tentativa: iterate_squads(squad_se) con metodo squad_members()
      sim:iterate_squads(function(squad_se)
        if squad_se ~= nil and squad_se.squad_members ~= nil then
          for member in squad_se:squad_members() do
            local npc = nil
            pcall(function()
              if level ~= nil and level.object_by_id ~= nil then
                npc = level.object_by_id(member.id)
              end
            end)
            if npc == nil then
              -- fallback: el propio member puede ser ya game_object en algunos forks
              npc = member
            end
            local ok = fn(npc)
            if ok then touched = touched + 1 end
          end
        end
      end)
      used_iterator = true
    end
  end)
  if used_iterator then
    return touched
  end
  -- Via 2 (universal Monolith): barrido de alife objects, filtrar squads
  -- por presencia del metodo :squad_members().
  for id = 1, 65534 do
    local se = nil
    pcall(function() se = sim:object(id) end)
    if se ~= nil then
      local is_squad = false
      pcall(function()
        if se.squad_members ~= nil then
          -- squad_members es metodo; si existe, es squad (u objeto compatible)
          is_squad = true
        end
      end)
      if is_squad then
        pcall(function()
          for member in se:squad_members() do
            local npc = nil
            pcall(function()
              if level ~= nil and level.object_by_id ~= nil then
                npc = level.object_by_id(member.id)
              end
            end)
            if npc == nil then
              npc = member
            end
            local ok = fn(npc)
            if ok then touched = touched + 1 end
          end
        end)
      end
    end
  end
  return touched
end

local function nerf_npc_vision()
  return for_each_online_squad_member(nerf_single_npc)
end

local function restore_npc_vision()
  local n = for_each_online_squad_member(restore_single_npc)
  saved_npc_vision = {}
  return n
end

-- ============================================================
-- API publica
-- ============================================================
night_mode_manager = night_mode_manager or {}

function night_mode_manager.is_active()
  return is_enabled == true
end

function night_mode_manager.enable(opts)
  opts = opts or {}
  local skip_time   = opts.skip_time
  local skip_lamps  = opts.skip_lamps
  local skip_vision = opts.skip_vision
  if skip_time   == nil then skip_time   = false end
  if skip_lamps  == nil then skip_lamps  = false end
  if skip_vision == nil then skip_vision = false end

  if is_enabled == true then
    return false -- ya activo
  end

  -- 1) Cvars: leer + guardar, luego oscurecer
  save_current_cvars()
  apply_night_cvars()

  -- 2+3) Stats + salto de tiempo + clima
  if skip_time == false then
    local stats = capture_actor_stats()
    local has_level = false
    pcall(function()
      if level ~= nil and level.present ~= nil then has_level = level.present() end
    end)
    if has_level then
      jump_to_0230()
      pending_time_jump = false
    else
      -- Activado desde menu principal (sin nivel): pre-armar cvars oscuros
      -- y diferir salto de tiempo + clima a actor_on_first_update.
      force_weather_update() -- no-op en menu, pero inofensivo
      pending_time_jump = true
    end
    schedule_stats_restore(stats)
  else
    force_weather_update()
  end

  -- 4) Lamparas
  if skip_lamps == false then
    -- Diferir 0.5s para que el weather/time ya haya aplicado y los
    -- objetos online esten estables tras el salto.
    pcall(function() RemoveTimeEvent("night_mode_lamps_e", "night_mode_lamps_a") end)
    CreateTimeEvent("night_mode_lamps_e", "night_mode_lamps_a", 0.5, function()
      turn_off_lamps()
      return true
    end)
  end

  -- 5) Vision NPC
  if skip_vision == false then
    pcall(function() RemoveTimeEvent("night_mode_vision_e", "night_mode_vision_a") end)
    CreateTimeEvent("night_mode_vision_e", "night_mode_vision_a", 0.5, function()
      nerf_npc_vision()
      return true
    end)
  end

  is_enabled = true
  pcall(function()
    if _G.night_mode_ui_refresh ~= nil then night_mode_ui_refresh() end
  end)
  return true
end

function night_mode_manager.disable()
  if is_enabled == false then
    return false -- ya inactivo
  end
  -- 1) Restaurar valores exactos guardados
  restore_saved_cvars()

  -- 5) Restaurar vision NPC (best-effort)
  pcall(function() restore_npc_vision() end)

  -- NOTA: no re-encendemos lamparas ni revertimos el reloj:
  -- el salto temporal es irreversible por diseno (como dormir).
  -- Solo se restauran cvars y vision.

  pcall(function() RemoveTimeEvent("night_mode_lamps_e", "night_mode_lamps_a") end)
  pcall(function() RemoveTimeEvent("night_mode_vision_e", "night_mode_vision_a") end)
  pcall(function() RemoveTimeEvent("night_mode_restore_stats_e", "night_mode_restore_stats_a") end)

  is_enabled = false
  pending_time_jump = false
  pcall(function()
    if _G.night_mode_ui_refresh ~= nil then night_mode_ui_refresh() end
  end)
  return true
end

function night_mode_manager.toggle(opts)
  if night_mode_manager.is_active() then
    return night_mode_manager.disable()
  else
    return night_mode_manager.enable(opts)
  end
end

-- Exposicion granular (util para debug / MCM / bindings)
night_mode_manager.save_current_cvars   = save_current_cvars
night_mode_manager.apply_night_cvars    = apply_night_cvars
night_mode_manager.restore_saved_cvars  = restore_saved_cvars
night_mode_manager.minutes_until_0230   = minutes_until_0230
night_mode_manager.jump_to_0230         = jump_to_0230
night_mode_manager.force_weather_update = force_weather_update
night_mode_manager.turn_off_lamps       = turn_off_lamps
night_mode_manager.nerf_npc_vision      = nerf_npc_vision
night_mode_manager.restore_npc_vision   = restore_npc_vision

-- Aliases globales legacy (los que usan los bindings de teclado / xr_effects)
function enable_night_mode(opts)  return night_mode_manager.enable(opts) end
function disable_night_mode()     return night_mode_manager.disable() end
function toggle_night_mode(opts)  return night_mode_manager.toggle(opts) end
function is_night_mode_active()   return night_mode_manager.is_active() end

-- ============================================================
-- Persistencia + lifecycle del engine
-- ============================================================
local function nm_save_state(m_data)
  if m_data ~= nil then
    m_data.night_mode_enabled = (is_enabled == true)
    -- Guardamos tambien los cvars por si se guarda/carga con el modo activo:
    -- asi disable() tras load sigue restaurando los valores originales.
    m_data.night_mode_saved_cvars = saved_cvars
  end
end

local function nm_load_state(m_data)
  if m_data ~= nil then
    if m_data.night_mode_enabled == true then
      is_enabled = true
    else
      is_enabled = false
    end
    if type(m_data.night_mode_saved_cvars) == "table" then
      saved_cvars = m_data.night_mode_saved_cvars
    end
  end
end

function on_game_start()
  pcall(function()
    RegisterScriptCallback("save_state", nm_save_state)
    RegisterScriptCallback("load_state", nm_load_state)
  end)
  -- Re-aplicar ceguera nocturna al entrar a un nivel con el modo activo
  -- (los squads se recrean online en cada level change).
  -- Si se activo desde el menu principal, aplicar aqui el salto a 02:30
  -- pendiente (ahi ya hay level + actor para proteger stats).
  pcall(function()
    RegisterScriptCallback("actor_on_first_update", function()
      if is_enabled == true then
        if pending_time_jump == true then
          pending_time_jump = false
          local stats = capture_actor_stats()
          jump_to_0230()
          schedule_stats_restore(stats)
        end
        CreateTimeEvent("night_mode_vision_e", "night_mode_vision_a", 1.0, function()
          nerf_npc_vision()
          turn_off_lamps()
          return true
        end)
      end
      pcall(function()
        if _G.night_mode_ui_refresh ~= nil then night_mode_ui_refresh() end
      end)
      return true
    end)
  end)
end
