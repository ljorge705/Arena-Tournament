-- =============================================================================
-- xcvb_arena_companions.script
-- Arena Companion Hiring System & Arena Economy (Endless Mode)
-- Companions are hired NPC allies that fight alongside the player and persist
-- between Endless waves. They are hired using Arena Credits (CLP) earned by
-- killing enemies during Endless mode.
-- =============================================================================

local MAX_COMPANIONS = 4

-- Arena Credits (Dinero de la Arena: CLP)
local arena_credits = 0

-- Companion definitions: rank 0â€“4, cost (in CLP), NPC section, keys
local companion_defs = {
    [1] = {
        rank        = 0,
        cost        = 5000, -- RU
        section     = "sim_default_stalker_0",
        name_key    = "st_arena_companion_rank0_name",
        desc_key    = "st_arena_companion_rank0_desc",
    },
    [2] = {
        rank        = 1,
        cost        = 12000,
        section     = "sim_default_stalker_1",
        name_key    = "st_arena_companion_rank1_name",
        desc_key    = "st_arena_companion_rank1_desc",
    },
    [3] = {
        rank        = 2,
        cost        = 25000,
        section     = "sim_default_killer_2",
        name_key    = "st_arena_companion_rank2_name",
        desc_key    = "st_arena_companion_rank2_desc",
    },
    [4] = {
        rank        = 3,
        cost        = 45000,
        section     = "sim_default_killer_3",
        name_key    = "st_arena_companion_rank3_name",
        desc_key    = "st_arena_companion_rank3_desc",
    },
    [5] = {
        rank        = 4,
        cost        = 75000,
        section     = "sim_default_military_4",
        name_key    = "st_arena_companion_rank4_name",
        desc_key    = "st_arena_companion_rank4_desc",
    },
}

-- Companion squad section (online_offline_group) â€” defined in mod_system_xcvbarena.ltx
local COMPANION_SQUAD_SEC = "arena_companion_squad"

-- Active companions: list of { squad_id, npc_id, def_idx, rank }
local active_companions = {}
local companion_npc_ids_cache = {}

function refresh_companion_id_cache()
    companion_npc_ids_cache = {}
    for _, entry in ipairs(active_companions) do
        if entry.npc_id then
            companion_npc_ids_cache[entry.npc_id] = true
        end
    end
end

function is_companion(npc_id)
    if not npc_id then return false end
    if companion_npc_ids_cache and companion_npc_ids_cache[npc_id] then return true end
    if active_companions then
        for _, entry in ipairs(active_companions) do
            if entry.npc_id == npc_id then
                if companion_npc_ids_cache then
                    companion_npc_ids_cache[npc_id] = true
                end
                return true
            end
        end
    end
    return false
end

-- Compatibility helper: returns arena tokens or actor money depending on economy mode
function get_arena_credits()
    if xcvb_arena_main and xcvb_arena_main.get_arena_tokens then
        return xcvb_arena_main.get_arena_tokens()
    end
    return (db.actor and db.actor:money()) or 0
end

function add_arena_credits(amount)
    if xcvb_arena_main and xcvb_arena_main.add_arena_tokens then
        return xcvb_arena_main.add_arena_tokens(amount)
    end
    return get_arena_credits()
end

function spend_arena_credits(amount)
    local econ_mode = (xcvb_arena_mcm and xcvb_arena_mcm.get_config("economy_mode")) or "tokens"
    if econ_mode == "tokens" then
        if xcvb_arena_main and xcvb_arena_main.spend_arena_tokens then
            return xcvb_arena_main.spend_arena_tokens(amount)
        end
    else
        if db.actor and db.actor:money() >= (amount or 0) then
            db.actor:give_money(-(amount or 0))
            return true
        end
    end
    return false
end

function set_arena_credits(amount) end
function reset_arena_credits() end

function on_endless_enemy_killed(se_obj, difficulty)
    return 0
end

-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
-- ACCESSORS
-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

function get_companion_defs()
    return companion_defs
end

function get_active_companions()
    return active_companions
end

function get_active_companion_count()
    cleanup_dead_companions()
    return #active_companions
end

function get_max_companions()
    return MAX_COMPANIONS
end

-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
-- HIRE / FIRE
-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

local function hire_companion_internal(def_idx, team_spawn, team_slot)
    local gt = game.translate_string
    local def = companion_defs[def_idx]
    if not def then
        return false, gt("st_arena_companion_err_invalid")
    end

    if not (xcvb_arena_fight and xcvb_arena_fight.is_endless_active and xcvb_arena_fight.is_endless_active()) then
        return false, gt("st_arena_companion_err_not_endless")
    end

    if get_active_companion_count() >= MAX_COMPANIONS then
        return false, string.format(gt("st_arena_companion_err_max"), MAX_COMPANIONS)
    end

    local econ_mode = (xcvb_arena_mcm and xcvb_arena_mcm.get_config("economy_mode")) or "tokens"
    if not team_spawn and econ_mode == "tokens" then
        local token_cost = math.max(10, math.floor(def.cost / 100))
        local tokens = (xcvb_arena_main and xcvb_arena_main.get_arena_tokens and xcvb_arena_main.get_arena_tokens()) or 0
        if tokens < token_cost then
            return false, string.format(gt("st_arena_companion_err_tokens"), token_cost)
        end
    elseif not team_spawn then
        local actor_money = (db.actor and db.actor:money()) or 0
        if actor_money < def.cost then
            return false, string.format(gt("st_arena_companion_err_money"), def.cost)
        end
    end

    local sec = xcvb_arena_factions.section(xcvb_arena_factions.actor_faction(), def.rank + 1)
    if team_spawn and xcvb_arena_factions.active() then
        local t = xcvb_arena_factions.options().teams[1]
        sec = xcvb_arena_factions.section(t.faction, t.rank)
    end
    if not (sec and ini_sys and ini_sys:section_exist(sec)) then
        return false, gt("st_arena_companion_err_spawn")
    end

    local spawn_pos, spawn_lvid, spawn_gvid = xcvb_arena_utils.get_actor_tournament_pos()
    if team_spawn and xcvb_arena_factions.active() then
        spawn_pos, spawn_lvid, spawn_gvid = xcvb_arena_factions.spawn_point(1, (team_slot or 1) + 1)
        if not spawn_pos then return false, gt("st_arena_companion_err_spawn") end
    elseif xcvb_arena_factory and xcvb_arena_factory.active() then
        spawn_pos, spawn_lvid, spawn_gvid = xcvb_arena_factory.get_companion_spawn(team_slot or (#active_companions + 1))
        if not spawn_pos then return false, gt("st_arena_companion_err_spawn") end
    elseif db.actor then
        local ap = db.actor:position()
        if ap then
            -- Determine arena half: South (< 105) moves +Z toward center; North (>= 105) moves -Z toward center
            local dir_z = (ap.z < 105.0) and 1 or -1
            local offset_x = (math.random() - 0.5) * 1.5
            local offset_z = dir_z * (2.5 + math.random() * 0.5)
            local min_x, max_x, min_z, max_z
                min_x = 146.0
                max_x = 157.0
                min_z = 84.0
                max_z = 126.0
            local target_x = math.max(min_x, math.min(max_x, ap.x + offset_x))
            local target_z = math.max(min_z, math.min(max_z, ap.z + offset_z))
            spawn_pos = vector():set(target_x, ap.y, target_z)
            if xcvb_arena_utils and xcvb_arena_utils.get_safe_arena_lvid then
                spawn_lvid = xcvb_arena_utils.get_safe_arena_lvid(spawn_pos, spawn_lvid)
            elseif level and level.vertex_id then
                local vid = level.vertex_id(spawn_pos)
                if vid and vid < 2^32 - 1 and vid > 0 then
                    spawn_lvid = vid
                end
            end
        end
    end

    local squad = alife_create(COMPANION_SQUAD_SEC, spawn_pos, spawn_lvid, spawn_gvid)
    if not squad then
        return false, gt("st_arena_companion_err_spawn")
    end

    squad.player_id = xcvb_arena_factions.actor_faction()
    local ok, err = pcall(function()
        squad:add_squad_member(sec, spawn_pos, spawn_lvid, spawn_gvid)
        squad:set_squad_relation()
        squad:refresh()
    end)

    if not ok or squad:npc_count() == 0 then
        pcall(alife_release_id, squad.id)
        return false, gt("st_arena_companion_err_spawn")
    end

    local npc_id = nil
    for m in squad:squad_members() do
        npc_id = m.id
        break
    end

    squad.scripted_target = "actor"
    squad.assigned_target_id = 0
    if axr_companions then
        axr_companions.companion_squads[squad.id] = squad
        if npc_id then
            axr_companions.non_task_companions[npc_id] = true
        end
    end
    if npc_id then
        local se_npc = alife_object(npc_id)
        if se_npc then
            se_save_var(se_npc.id, se_npc:name(), "companion", true)
            se_save_var(se_npc.id, se_npc:name(), "companion_cannot_dismiss", true)
            se_save_var(se_npc.id, se_npc:name(), "companion_cannot_teleport", nil)
        end
    end

    local econ_mode = (xcvb_arena_mcm and xcvb_arena_mcm.get_config("economy_mode")) or "tokens"
    if not team_spawn and econ_mode == "tokens" then
        local token_cost = math.max(10, math.floor(def.cost / 100))
        if xcvb_arena_main and xcvb_arena_main.spend_arena_tokens then
            xcvb_arena_main.spend_arena_tokens(token_cost)
        end
    elseif not team_spawn then
        if db.actor and db.actor.give_money then
            db.actor:give_money(-def.cost)
        end
    end

    local entry = {
        squad_id = squad.id,
        npc_id   = npc_id,
        def_idx  = def_idx,
        rank     = def.rank,
        team_slot = team_slot,
    }
    table.insert(active_companions, entry)
    refresh_companion_id_cache()

    if xcvb_arena_utils and xcvb_arena_utils.arena_spawned_combatant_ids then
        xcvb_arena_utils.arena_spawned_combatant_ids[squad.id] = true
        if npc_id then
            xcvb_arena_utils.arena_spawned_combatant_ids[npc_id] = true
        end
    end

    local attempts = 0
    CreateTimeEvent("xcvb_comp_aggro_e", "xcvb_comp_aggro_a_" .. squad.id, 0.2, function()
        attempts = attempts + 1
        local done = _setup_single_companion_ai(entry)
        if done or attempts >= 15 then
            return true
        end
        ResetTimeEvent("xcvb_comp_aggro_e", "xcvb_comp_aggro_a_" .. squad.id, 0.2)
        return false
    end)

    local msg = string.format(gt("st_arena_companion_hired"), gt(def.name_key))
    news_manager.send_tip(db.actor, msg, 0, nil, 5000)
    return true, nil
end

function hire_companion(def_idx)
    return hire_companion_internal(def_idx, false)
end

function ensure_team_companions(initial)
    local main = xcvb_arena_main
    if not main or main.endless_selected_variant ~= "team" and main.endless_selected_variant ~= "factions" then return end
    local o = xcvb_arena_team.options()
    local target_count = xcvb_arena_team.effective_count(o)
    if xcvb_arena_factions.active() then
        if not initial then return end
    end
    cleanup_dead_companions()
    local occupied = {}
    for _, entry in ipairs(active_companions) do
        if entry.team_slot then occupied[entry.team_slot] = true end
    end
    -- Earlier Team Deathmatch saves did not record per-ally slot numbers.
    if not initial then
        for _, entry in ipairs(active_companions) do
            if not entry.team_slot then
                for slot = 1, target_count do
                    if not occupied[slot] then
                        entry.team_slot, entry.team_equipped = slot, true
                        occupied[slot] = true
                        break
                    end
                end
            end
        end
    end
    for _, entry in ipairs(active_companions) do
        if not initial then entry.native_refresh_pending = true end
        if entry.team_slot and not initial then entry.team_service_pending = true end
    end
    if not initial and not o.replenish then return end
    for slot = 1, target_count do
        if not occupied[slot] then
            local ok, err = hire_companion_internal(o.allies[slot].rank, true, slot)
            if not ok then
                if db.actor then news_manager.send_tip(db.actor, err, 0, nil, 5000) end
                break
            end
        end
    end
end

function fire_companion(list_idx)
    local gt = game.translate_string
    local entry = active_companions[list_idx]
    if not entry then return false end

    _release_companion_entry(entry)
    table.remove(active_companions, list_idx)
    refresh_companion_id_cache()

    news_manager.send_tip(db.actor, gt("st_arena_companion_fired"), 0, nil, 4000)
    return true
end

-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
-- CLEANUP
-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

function cleanup_dead_companions()
    local alive = {}
    for _, entry in ipairs(active_companions) do
        if _is_companion_alive(entry) then
            table.insert(alive, entry)
        else
            _release_companion_entry(entry)
        end
    end
    active_companions = alive
    refresh_companion_id_cache()
end

function cleanup_all_companions()
    for _, entry in ipairs(active_companions) do
        _release_companion_entry(entry)
    end
    active_companions = {}
    refresh_companion_id_cache()
end

-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
-- AGGRO & COMBAT ENGAGEMENT
-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

function reassign_companion_aggro(enemy_squad_ids)
    cleanup_dead_companions()
    for _, entry in ipairs(active_companions) do
        _setup_single_companion_ai(entry, enemy_squad_ids)
    end
end

function _setup_single_companion_ai(entry, enemy_squad_ids)
    if not (entry and entry.npc_id) then return false end
    -- Late online/aggro retries must not re-enlist released companions or
    -- reapply combat orders after the player has returned to Rostok.
    if not (xcvb_arena_fight and xcvb_arena_fight.is_endless_active()) or not is_companion(entry.npc_id) then return true end
    if xcvb_arena_runtime and not xcvb_arena_runtime.combat_active() then return true end
    local npc = level.object_by_id(entry.npc_id)
    if not (npc and npc:alive()) then xcvb_arena_companion_orders.release(entry.npc_id);return false end

    -- 1. Ensure squad and NPC are registered in axr_companions
    local squad = entry.squad_id and alife_object(entry.squad_id)
    if squad then
        squad.player_id = xcvb_arena_factions.actor_faction()
        -- Native companion logic owns follow/wait and combat destinations.
        squad.scripted_target = "actor"
        squad.assigned_target_id = 0
        squad.rush_to_target = false
        if axr_companions then
            axr_companions.companion_squads[squad.id] = squad
        end
    end

    if axr_companions then
        axr_companions.non_task_companions[entry.npc_id] = true
        local se_npc = alife_object(entry.npc_id)
        if se_npc then
            se_save_var(se_npc.id, se_npc:name(), "companion", true)
            se_save_var(se_npc.id, se_npc:name(), "companion_cannot_dismiss", true)
            se_save_var(se_npc.id, se_npc:name(), "companion_cannot_teleport", nil)
        end
        if not xcvb_arena_companion_orders.initialize(npc, entry.native_refresh_pending) then return false end
        entry.native_refresh_pending = nil
        xcvb_arena_companion_orders.update_follow(npc)
    end

    -- 2. Prevent companion from leaving the arena
    if xcvb_arena_factory and xcvb_arena_factory.active() then
        xcvb_arena_factory.prepare_npc(npc)
    else
        pcall(function() npc:add_restrictions("bar_arena_restrictor", "") end)
    end

    -- 3. Permanent friend/goodwill with actor
    if db.actor then
        pcall(function()
            npc:set_relation(game_object.friend, db.actor)
            npc:force_set_goodwill(5000, db.actor)
        end)
    end

    if entry.team_slot then
        xcvb_arena_team.equip(npc, entry)
        if not entry.team_equipped then return false end
        if entry.team_service_pending then
            xcvb_arena_team.service(npc, entry)
            entry.team_service_pending = nil
        end
    end

    -- 4. Combat alertness & readiness (tactical AI friendly)
    if IsStalker and IsStalker(npc) then
        pcall(function()
            -- Ensure companion has sufficient ammunition for their firearm
            local bw = npc:best_weapon()
            if bw then
                local a_cls = ini_sys:r_string_ex(bw:section(), "ammo_class") or ""
                local first_ammo = str_explode(a_cls, ",")[1]
                if first_ammo and ini_sys:section_exist(trim(first_ammo)) then
                    local ammo_sec = trim(first_ammo)
                    if not entry.ammo_given then
                        for _ = 1, 4 do
                            alife_create(ammo_sec, npc:position(), npc:level_vertex_id(), npc:game_vertex_id(), npc:id())
                        end
                        entry.ammo_given = true
                    end
                end
            end
        end)
    end

    -- 5. Engage against enemies
    _engage_companion_with_enemies(npc, enemy_squad_ids)
    return true
end

function get_active_arena_enemies()
    local enemies = {}
    if xcvb_arena_utils and xcvb_arena_utils.arena_spawned_combatant_ids then
        for id, _ in pairs(xcvb_arena_utils.arena_spawned_combatant_ids) do
            if not is_companion(id) and id ~= 0 then
                local obj = level.object_by_id(id)
                if obj and obj:alive() and (IsStalker(obj) or IsMonster(obj)) then
                    table.insert(enemies, obj)
                end
            end
        end
    end
    return enemies
end

function _engage_companion_with_enemies(npc, enemy_squad_ids)
    if not (npc and npc:alive()) then return end

    local enemies = get_active_arena_enemies()
    if #enemies == 0 and enemy_squad_ids then
        for _, s_id in ipairs(enemy_squad_ids) do
            local sq = alife_object(s_id)
            if sq then
                for m in sq:squad_members() do
                    local e_obj = level.object_by_id(m.id)
                    if e_obj and e_obj:alive() then
                        table.insert(enemies, e_obj)
                    end
                end
            end
        end
    end
    if #enemies == 0 and xcvb_arena_fight and xcvb_arena_fight.get_endless_enemy_squad_ids then
        local sq_ids = xcvb_arena_fight.get_endless_enemy_squad_ids()
        if sq_ids then
            for _, s_id in ipairs(sq_ids) do
                local sq = alife_object(s_id)
                if sq then
                    for m in sq:squad_members() do
                        local e_obj = level.object_by_id(m.id)
                        if e_obj and e_obj:alive() then
                            table.insert(enemies, e_obj)
                        end
                    end
                end
            end
        end
    end

    if #enemies == 0 then return end

    -- Arena teams must be hostile, but perception and engagement stay native.
    for _, e_obj in ipairs(enemies) do
        pcall(function()
            npc:set_relation(game_object.enemy, e_obj)
            npc:force_set_goodwill(-5000, e_obj)
            e_obj:set_relation(game_object.enemy, npc)
            e_obj:force_set_goodwill(-5000, npc)
        end)
    end
end

-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
-- INTERNAL HELPERS
-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

function _is_companion_alive(entry)
    if not entry then return false end
    local squad = entry.squad_id and alife_object(entry.squad_id)
    if not squad then return false end
    if squad:npc_count() <= 0 then return false end
    if entry.npc_id then
        local npc = level.object_by_id(entry.npc_id)
        if npc and not npc:alive() then return false end
    end
    return true
end

function _release_companion_entry(entry)
    if entry and entry.npc_id then xcvb_arena_companion_orders.release(entry.npc_id) end
    if not entry then return end
    if entry.squad_id and RemoveTimeEvent then
        pcall(RemoveTimeEvent, "xcvb_comp_aggro_e", "xcvb_comp_aggro_a_" .. entry.squad_id)
    end
    if xcvb_arena_utils and xcvb_arena_utils.arena_spawned_combatant_ids then
        if entry.npc_id then xcvb_arena_utils.arena_spawned_combatant_ids[entry.npc_id] = nil end
        if entry.squad_id then xcvb_arena_utils.arena_spawned_combatant_ids[entry.squad_id] = nil end
    end
    if entry.npc_id then
        local npc = level.object_by_id(entry.npc_id)
        if npc and axr_companions and axr_companions.remove_from_actor_squad then
            pcall(axr_companions.remove_from_actor_squad, npc)
        end
        if axr_companions and axr_companions.non_task_companions then
            axr_companions.non_task_companions[entry.npc_id] = nil
        end
    end
    if entry.squad_id and axr_companions and axr_companions.companion_squads then
        axr_companions.companion_squads[entry.squad_id] = nil
    end
    local function safe_rel(id)
        if not id then return end
        if xcvb_arena_utils and xcvb_arena_utils.cancel_arena_npc_restock then
            xcvb_arena_utils.cancel_arena_npc_restock(id)
        end
        local se = alife_object(id)
        if se then
            pcall(alife_release, se)
        end
    end
    if entry.squad_id then
        local squad = alife_object(entry.squad_id)
        if squad then
            local ids = {}
            for m in squad:squad_members() do
                table.insert(ids, m.id)
            end
            for _, mid in ipairs(ids) do safe_rel(mid) end
            safe_rel(entry.squad_id)
        end
    end
end

function _get_safe_companion_section(preferred_sec)
    if preferred_sec and ini_sys and ini_sys:section_exist(preferred_sec) then
        return preferred_sec
    end
    return "sim_default_stalker_0"
end

-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
-- on_enemy_eval: manage friend / enemy relationships in combat
-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

function on_enemy_eval(npc, enemy, flags)
    if not (npc and enemy and flags) then return end
    -- Avoid doing ID/table work for the global AI callback unless companion
    -- combat is actually active.
    if #active_companions == 0 then return end
    if not (xcvb_arena_fight and xcvb_arena_fight.is_endless_active
        and xcvb_arena_fight.is_endless_active()) then
        return
    end
    local npc_id = npc:id()
    local enemy_id = enemy:id()

    local npc_is_comp = is_companion(npc_id)
    local enemy_is_comp = is_companion(enemy_id)
    local actor_id = db.actor and db.actor:id() or 0

    -- 1. Si el companion evalua al jugador -> Amistoso
    if npc_is_comp and enemy_id == actor_id then
        flags.override = true
        flags.result = false
        return
    end

    -- 2. Si el jugador evalua al companion -> Amistoso
    if npc_id == actor_id and enemy_is_comp then
        flags.override = true
        flags.result = false
        return
    end

    -- 3. Si un companion evalua a otro companion -> Amistoso
    if npc_is_comp and enemy_is_comp then
        flags.override = true
        flags.result = false
        return
    end

    -- 4. Si un companion evalua a un enemigo del arena -> SIEMPRE hostil
    if npc_is_comp then
        if xcvb_arena_utils and xcvb_arena_utils.arena_spawned_combatant_ids and xcvb_arena_utils.arena_spawned_combatant_ids[enemy_id] then
            flags.override = true
            flags.result = true
            return
        end
    end

    -- 5. Si un enemigo del arena evalua a nuestro companion -> SIEMPRE hostil
    if enemy_is_comp then
        if xcvb_arena_utils and xcvb_arena_utils.arena_spawned_combatant_ids and xcvb_arena_utils.arena_spawned_combatant_ids[npc_id] then
            flags.override = true
            flags.result = true
            return
        end
    end
end

-- Mantener el aggro activo periodicamente durante el combate sin interrumpir la IA tactica
local next_aggro_pulse = 0
function actor_on_update()
    local tg = time_global()
    if tg > next_aggro_pulse then
        next_aggro_pulse = tg + 2500
        if xcvb_arena_fight and xcvb_arena_fight.is_endless_active and xcvb_arena_fight.is_endless_active() then
            if #active_companions > 0 then
                reassign_companion_aggro()
            end
        end
    end
end

-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
-- SAVE / LOAD
-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€


function relocate_companions_to_actor(manual)
    if not db.actor then return end
    if manual and not (xcvb_arena_runtime and xcvb_arena_runtime.combat_active()) then return end
    local ap = db.actor:position()
    if not ap then return end
    local gvid = db.actor:game_vertex_id()

    local idx = 0
    for _, comp_data in ipairs(active_companions) do
        local npc_id = comp_data.npc_id
        local npc = npc_id and level.object_by_id(npc_id)
        local se_npc = npc_id and alife_object(npc_id)
        if se_npc and (not npc or npc:alive()) then
            idx = idx + 1
            local target_pos = nil
            local target_lvid = nil

            if xcvb_arena_factory and xcvb_arena_factory.active() then
                target_pos, target_lvid, gvid = xcvb_arena_factory.get_companion_spawn(idx)
            else
                local angle = (idx - 1) * (math.pi / 2) + 0.4
                local dist = 1.8 + (idx * 0.4)
                local cand_pos = vector():set(ap.x + math.cos(angle) * dist, ap.y, ap.z + math.sin(angle) * dist)
                local vid = level.vertex_id(cand_pos)
                if vid and vid > 0 and vid < 2^32 - 1 and level.valid_vertex_id(vid) then
                    target_pos = cand_pos
                    target_lvid = vid
                else
                    target_pos = ap
                    target_lvid = db.actor:level_vertex_id()
                end
            end

            if target_pos and not target_lvid then
                target_lvid = db.actor:level_vertex_id()
            end

            if target_pos and target_lvid then
                se_npc.position = vector():set(target_pos.x, target_pos.y, target_pos.z)
                se_npc.m_level_vertex_id = target_lvid
                se_npc.m_game_vertex_id = gvid
                if manual then
                    if db.offline_objects and db.offline_objects[npc_id] then db.offline_objects[npc_id].level_vertex_id = nil end
                    if db.spawned_vertex_by_id then db.spawned_vertex_by_id[npc_id] = nil end
                    pcall(function() alife():teleport_object(npc_id,gvid,target_lvid,target_pos) end)
                    comp_data.native_refresh_pending = true
                end
                if npc then
                    if manual then
                        if axr_companions and axr_companions.set_companion_to_follow_state then
                            pcall(axr_companions.set_companion_to_follow_state,npc)
                        end
                        pcall(function() npc:disable_info_portion("npcx_beh_substate_relax") end)
                    end
                    pcall(npc.set_npc_position, npc, target_pos)
                    pcall(function() npc:set_dest_level_vertex_id(target_lvid) end)
                    -- A manual teleport must never heal or generate ammunition.
                    if not manual then pcall(function()
                        npc.health = 1.0
                        local bw = npc:best_weapon()
                        if bw then
                            local a_cls = ini_sys:r_string_ex(bw:section(), "ammo_class") or ""
                            local first_ammo = str_explode(a_cls, ",")[1]
                            if first_ammo and ini_sys:section_exist(trim(first_ammo)) then
                                for _ = 1, 2 do
                                    alife_create(trim(first_ammo), target_pos, target_lvid, gvid, npc:id())
                                end
                            end
                        end
                    end) end
                    if manual then
                        if xcvb_arena_companion_orders.initialize(npc,true) then comp_data.native_refresh_pending = nil end
                        xcvb_arena_companion_orders.update_follow(npc)
                    end
                end
            end
        end
    end
end

local next_manual_teleport = 0
function on_companion_teleport_key(key)
    if not (xcvb_arena_runtime and xcvb_arena_runtime.combat_active()) or #active_companions == 0 then return end
    -- GAMMA's Controls action resolves whichever physical key the user assigned.
    local matches = dik_to_bind and key_bindings and key_bindings.kCUSTOM23
        and dik_to_bind(key) == key_bindings.kCUSTOM23
    -- Also cooperate with the optional QCT addon, only if it is already loaded.
    local qct = rawget(_G,"qcteleport_mcm")
    matches = matches or (type(qct) == "table" and qct.KEY_QCTELEPORT and key == qct.KEY_QCTELEPORT)
    if not matches then return end
    local now = time_global()
    if now < next_manual_teleport then return end
    next_manual_teleport = now + 250
    relocate_companions_to_actor(true)
end

function save_state(m_data)
    local saved = {}
    for _, entry in ipairs(active_companions) do
        if (xcvb_arena_runtime and not xcvb_arena_runtime.allowed()) or _is_companion_alive(entry) then
            table.insert(saved, {
                squad_id = entry.squad_id,
                npc_id   = entry.npc_id,
                def_idx  = entry.def_idx,
                rank     = entry.rank,
                team_slot = entry.team_slot,
                team_equipped = entry.team_equipped,
                ammo_given = entry.ammo_given,
                team_service_pending = entry.team_service_pending,
            })
        end
    end
    m_data.xcvb_companions = saved
end

function load_state(m_data)
    xcvb_arena_companion_orders.clear()
    active_companions = {}
    local saved = m_data.xcvb_companions or {}
    for _, entry in ipairs(saved) do
        if entry.squad_id then
            local squad = alife_object(entry.squad_id)
            if (xcvb_arena_runtime and not xcvb_arena_runtime.allowed()) or (squad and squad:npc_count() > 0) then
                table.insert(active_companions, {
                    squad_id = entry.squad_id,
                    npc_id   = entry.npc_id,
                    def_idx  = entry.def_idx,
                    rank     = entry.rank,
                    team_slot = entry.team_slot,
                    team_equipped = entry.team_equipped,
                    ammo_given = entry.ammo_given,
                    team_service_pending = entry.team_service_pending,
                })
            end
        end
    end
    refresh_companion_id_cache()
end

-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
-- ENGINE HOOKS
-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

function on_game_start()
    if xcvb_arena_runtime then xcvb_arena_runtime.protect(xcvb_arena_companions) end
    RegisterScriptCallback("on_key_release", on_companion_teleport_key)
    RegisterScriptCallback("on_enemy_eval", on_enemy_eval)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
end

