 {x=239.4000086,y=-19.9456463,z=82.6000082,lvid=68674,gvid=1706},
 {x=237.3000087,y=-19.9456463,z=82.6000082,lvid=67928,gvid=1706},
 {x=241.5000086,y=-19.9456463,z=78.4000083,lvid=69396,gvid=1706},
 {x=212.1000091,y=-19.9456463,z=78.4000083,lvid=56470,gvid=1706},
 {x=212.1000091,y=-19.9456463,z=80.5000082,lvid=56476,gvid=1706},
 {x=212.1000091,y=-19.9456463,z=82.6000082,lvid=56479,gvid=1697},
}
factory_sites = {}
for index=1,4 do
 local actor=points[index]
 local enemy=nil;local farthest=-1
 for _,point in ipairs(factory_pool) do
  local d=(point.x-actor.x)^2+(point.z-actor.z)^2
  if d>=24*24 and d<=38*38 and (not enemy or math.abs(d-30*30)<farthest) then enemy=point;farthest=math.abs(d-30*30) end
 end
 assert(enemy, "Backrooms: no connected enemy spawn within online distance")
 local slots={}
 for _,point in ipairs(factory_pool) do
  if (point.x-enemy.x)^2+(point.z-enemy.z)^2<=36 then slots[#slots+1]=point end
 end
 factory_sites[index]={actor=actor,enemy=enemy,slots=slots,direction=0}
end
function contains(pos)
 local b=factory_bounds
 return pos and pos.x>=b.min_x and pos.x<=b.max_x and pos.z>=b.min_z and pos.z<=b.max_z and pos.y>=b.min_y and pos.y<=b.max_y
end
function ready()
 if not (level and level.name()=="l05_bar") then return false end
 for _,point in ipairs(points) do
  local ok,pos=pcall(level.vertex_position,point.lvid)
  if not ok or not pos or math.abs(pos.x-point.x)>.1 or math.abs(pos.y-point.y)>.1 or math.abs(pos.z-point.z)>.1 then return false end
 end
 return true
end
