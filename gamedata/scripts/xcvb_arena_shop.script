-- =============================================================================
-- xcvb_arena_shop.script
-- Arena Store & Token Exchange System
-- Provides a lore-friendly, balanced shop to trade Arena Tokens for
-- controlled cashouts, medical supplies, and ammunition.
-- Features dynamic ammunition detection, rank gating per tier,
-- increased prices for elite rounds, and clean visual layout.
-- =============================================================================

local gt = game.translate_string
GUI_SHOP = nil

function open_shop()
    if GUI_SHOP then
        if GUI_SHOP:IsShown() then
            GUI_SHOP:HideDialog()
        end
        Unregister_UI("UIXcvbShop")
        GUI_SHOP = nil
    end

    GUI_SHOP = UIXcvbShop()
    GUI_SHOP:ShowDialog(true)
    GUI_SHOP:Enable(true)
    Register_UI("UIXcvbShop", "xcvb_arena_shop")
    GUI_SHOP:refresh()
end

if rawget(_G, "xr_effects") then
    _G.xr_effects.open_arena_shop = function(actor, npc)
        open_shop()
    end
end

function on_game_start()
    if xr_effects then
        xr_effects.open_arena_shop = function(actor, npc)
            open_shop()
        end
    end
end

