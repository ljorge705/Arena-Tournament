local RANK_TIER_NAMES = {
    [1] = "st_rank_novice",
    [2] = "st_rank_experienced",
    [3] = "st_rank_veteran",
    [4] = "st_rank_master",
    [5] = "st_rank_legend",
}

local function get_current_rank_tier()
    if xcvb_arena_main and xcvb_arena_main.practice_mode_active then
        return 5
    end
    if xcvb_arena_mcm and xcvb_arena_mcm.get_config("rank_gating") == false then
        return 5
    end
    local r = 1
    if xcvb_arena_main and xcvb_arena_main.get_actor_rank_num then
        r = xcvb_arena_main.get_actor_rank_num()
    end
    return r or 1
end

