--------------------------------------------------------------------------------
-- HELPER FUNCTIONS
--------------------------------------------------------------------------------

function get_category_tiers(category)
	if category == "mutant" then
		return tournament_mutant_tiers_t
	else
		return tournament_stalker_tiers_t
	end
end

function get_unlocked_round(category)
	if category == "mutant" then
		return tournament_mutant_unlocked_round
	else
		return tournament_stalker_unlocked_round
	end
end

function get_round_data(category, round_id)
	local tiers = get_category_tiers(category)
	local tier_idx = math.ceil(round_id / 3)
	if tiers[tier_idx] and tiers[tier_idx].rounds[round_id] then
		return tiers[tier_idx].rounds[round_id]
	end
	return nil
end

function is_round_unlocked(category, round_id)
	local unl = get_unlocked_round(category)
	return round_id <= unl
end

function is_round_completed(category, round_id)
	if category == "mutant" then
		return tournament_mutant_completed[round_id] == true
	else
		return tournament_stalker_completed[round_id] == true
	end
end

function get_player_tier(category)
	local unl = get_unlocked_round(category)
	return math.min(5, math.ceil(unl / 3))
end

--------------------------------------------------------------------------------
-- PERSISTENCE
--------------------------------------------------------------------------------

function save_state(m_data)
	m_data.xcvb_arena_main_t = arena_main_t
	m_data.xcvb_arena_current_period = current_period
	m_data.xcvb_arena_spec_filter = current_spec_filter
	m_data.xcvb_arena_selected_bout = selected_spec_bout
	m_data.xcvb_arena_team_bet = team_bet
	m_data.xcvb_arena_bet_amount = bet_amount
	m_data.xcvb_arena_cur_reward = cur_reward

	m_data.xcvb_tournament_stalker_unlocked = tournament_stalker_unlocked_round
	m_data.xcvb_tournament_stalker_completed = tournament_stalker_completed

	m_data.xcvb_tournament_mutant_unlocked = tournament_mutant_unlocked_round
	m_data.xcvb_tournament_mutant_completed = tournament_mutant_completed

	m_data.xcvb_tournament_wins = tournament_wins
	m_data.xcvb_tournament_losses = tournament_losses
end

function load_state(m_data)
	arena_main_t = m_data.xcvb_arena_main_t or arena_main_t
	current_period = m_data.xcvb_arena_current_period or 0
	current_spec_filter = m_data.xcvb_arena_spec_filter or "all"
	selected_spec_bout = m_data.xcvb_arena_selected_bout or 1
	team_bet = m_data.xcvb_arena_team_bet or 0
	bet_amount = m_data.xcvb_arena_bet_amount or 1000
	cur_reward = m_data.xcvb_arena_cur_reward or 0

	tournament_stalker_unlocked_round = m_data.xcvb_tournament_stalker_unlocked or 1
	tournament_stalker_completed = m_data.xcvb_tournament_stalker_completed or {}

	tournament_mutant_unlocked_round = m_data.xcvb_tournament_mutant_unlocked or 1
	tournament_mutant_completed = m_data.xcvb_tournament_mutant_completed or {}

	tournament_wins = m_data.xcvb_tournament_wins or 0
	tournament_losses = m_data.xcvb_tournament_losses or 0
end

--------------------------------------------------------------------------------
-- SPECTATOR BOUT GENERATION
--------------------------------------------------------------------------------

function generate_spectator_fights(filter_type)
	filter_type = filter_type or current_spec_filter or "all"
	current_spec_filter = filter_type

	for i = 1, 6 do
		local m_type = "svsm"
		if filter_type == "svsm" then
			m_type = "svsm"
		elseif filter_type == "svss" then
			m_type = "svss"
		elseif filter_type == "mvsm" then
			m_type = "mvsm"
		else -- "all"
			if i == 1 or i == 2 then
				m_type = "svsm"
			elseif i == 3 or i == 4 then
				m_type = "svss"
			else
				m_type = "mvsm"
			end
		end

		arena_main_t[i] = arena_main_t[i] or {}
		arena_main_t[i].match_type = m_type
		arena_main_t[i].team1 = {}
		arena_main_t[i].team2 = {}
		arena_main_t[i].pwrs = {}

		local amt1 = math.random(2, 4)
		local amt2 = math.random(2, 4)

		if m_type == "svsm" then
			local t2, p2, m_k = xcvb_arena_utils.get_mutant_team(amt2)
			local single_pwr = p2 / amt2
			
			local t1, p1
			if single_pwr >= 8 then
				t2 = { t2[1] }
				p2 = single_pwr
				
				amt1 = math.random(4, 5)
				t1 = {}
				p1 = 0
				local facs = {"stalker", "bandit", "killer", "duty", "freedom", "army", "monolith", "greh"}
				local s_fac = facs[math.random(#facs)]
				for _ = 1, amt1 do
					local fac_sec = s_fac
					if fac_sec == "army" then fac_sec = "military" elseif fac_sec == "dolg" then fac_sec = "duty" end
					t1[#t1 + 1] = "sim_default_" .. fac_sec .. "_4"
					p1 = p1 + 10
				end
			else
				t1, p1 = xcvb_arena_utils.get_stalker_team(amt1)
			end
			
			arena_main_t[i].team1 = t1
			arena_main_t[i].team2 = t2
			arena_main_t[i].pwrs = { p1, p2 }
		elseif m_type == "svss" then
			local t1, p1, fac1 = xcvb_arena_utils.get_stalker_team(amt1)
			local t2, p2 = xcvb_arena_utils.get_stalker_team(amt2, fac1)
			arena_main_t[i].team1 = t1
			arena_main_t[i].team2 = t2
			arena_main_t[i].pwrs = { p1, p2 }
		elseif m_type == "mvsm" then
			local t1, p1, mut1 = xcvb_arena_utils.get_mutant_team(amt1)
			local t2, p2 = xcvb_arena_utils.get_mutant_team(amt2, mut1)
			if (not t2) or #t2 == 0 then
				t2, p2 = xcvb_arena_utils.get_mutant_team(amt2)
			end
			arena_main_t[i].team1 = t1
			arena_main_t[i].team2 = t2
			arena_main_t[i].pwrs = { p1, p2 }
		end
	end
end

local function has_invalid_matchups()
	if not arena_main_t or #arena_main_t < 6 then return true end
	for i = 1, 6 do
		local bout = arena_main_t[i]
		if not (bout and bout.team1 and bout.team2 and #bout.team1 > 0 and #bout.team2 > 0) then
			return true
		end
		if bout.match_type == "svss" then
			local fac1 = xcvb_arena_utils.get_team_str(bout.team1)
			local fac2 = xcvb_arena_utils.get_team_str(bout.team2)
			if fac1 and fac2 and not xcvb_arena_utils.is_enemy_faction(fac1, fac2) then
				return true
			end
		end
	end
	return false
end

local function init_arena_main_t()
	if has_invalid_matchups() then
		generate_spectator_fights("all")
	end
end

local next_board_check = 0
function actor_on_update()
	local tg = time_global()
	if tg > next_board_check then
		next_board_check = tg + 4000
		if level and level.name and level.name() == "l05_bar" then
			xcvb_arena_utils.check_and_spawn_board()
		end
	end
end

function actor_on_first_update()
	xcvb_arena_utils.check_and_spawn_board()
	xcvb_arena_utils.handle_removed_teams()
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	init_arena_main_t()

	if xr_effects and not xr_effects.open_arena_gui then
		xr_effects.open_arena_gui = function(actor, npc)
			xcvb_arena_gui.open_gui()
		end
	end
end