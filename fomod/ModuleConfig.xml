<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Arena Tournament 1.3.2</moduleName>
  <requiredInstallFiles><folder source="gamedata" destination="gamedata" priority="0"/></requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Bar map variant">
      <optionalFileGroups order="Explicit"><group name="Choose your Bar map" type="SelectExactlyOne"><plugins order="Explicit">
        <plugin name="GAMMA / Anomaly"><description>Choose this map variant for GAMMA / Anomaly without Wormhole</description><conditionFlags><flag name="arena_map">gamma</flag></conditionFlags><typeDescriptor><type name="Recommended"/></typeDescriptor></plugin>
        <plugin name="[Vasgen's Cozy Spots] Bar (Rostok) Expansion | Wormhole"><description>Needs a custom level New Factory map ( https://www.moddb.com/mods/stalker-anomaly/addons/ens-cozvasgy-spots-barrostok-expansion-s2-anomaly-v05 )</description><conditionFlags><flag name="arena_map">wormhole</flag></conditionFlags><typeDescriptor><type name="Optional"/></typeDescriptor></plugin>
      </plugins></group></optionalFileGroups>
    </installStep>
    <installStep name="Arena content">
      <optionalFileGroups order="Explicit"><group name="Choose arena content" type="SelectExactlyOne"><plugins order="Explicit">
        <plugin name="Arena + Factory"><description>Both maps. New game required.</description><conditionFlags><flag name="arena_factory">yes</flag></conditionFlags><typeDescriptor><type name="Recommended"/></typeDescriptor></plugin>
        <plugin name="Arena Only"><description>Original arena. Existing saves supported.</description><files><folder source="Profiles\Arena" destination="gamedata" priority="3"/></files><conditionFlags><flag name="arena_factory">no</flag></conditionFlags><typeDescriptor><type name="Optional"/></typeDescriptor></plugin>
      </plugins></group></optionalFileGroups>
    </installStep>
    <installStep name="Factory spawn base">
      <visible><flagDependency flag="arena_factory" value="yes"/></visible>
      <optionalFileGroups order="Explicit"><group name="Choose your spawn base" type="SelectExactlyOne"><plugins order="Explicit">
        <plugin name="GAMMA"><description>Factory navigation for GAMMA.</description><files><folder source="SpawnOptions\GAMMA" destination="gamedata" priority="2"/></files><typeDescriptor><type name="Recommended"/></typeDescriptor></plugin>
        <plugin name="Anomaly 1.5.3"><description>Factory navigation for vanilla Anomaly.</description><files><folder source="SpawnOptions\Anomaly" destination="gamedata" priority="2"/></files><typeDescriptor><type name="Optional"/></typeDescriptor></plugin>
      </plugins></group></optionalFileGroups>
    </installStep>
  </installSteps>
  <conditionalFileInstalls><patterns>
    <pattern><dependencies operator="And"><flagDependency flag="arena_map" value="gamma"/><flagDependency flag="arena_factory" value="yes"/></dependencies><files><folder source="Maps\GAMMA\Factory" destination="gamedata" priority="1"/></files></pattern>
    <pattern><dependencies operator="And"><flagDependency flag="arena_map" value="wormhole"/><flagDependency flag="arena_factory" value="yes"/></dependencies><files><folder source="Maps\Wormhole\Factory" destination="gamedata" priority="1"/></files></pattern>
  </patterns></conditionalFileInstalls>
</config>

