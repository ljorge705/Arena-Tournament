<?xml version='1.0' encoding='utf-8'?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Arena Tournament 1.3.3</moduleName>
  <requiredInstallFiles>
    <folder source="gamedata" destination="gamedata" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Bar map variant">
      <optionalFileGroups order="Explicit">
        <group name="Choose your Bar map" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="GAMMA / Anomaly">
              <description>Standard Rostok for GAMMA or Anomaly. Includes Arena, Factory and the reduced Backrooms.</description>
              <conditionFlags>
                <flag name="arena_map">gamma</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="[Vasgen's Cozy Spots] Bar (Rostok) Expansion | Wormhole">
              <description>Rostok Expansion / Wormhole with Arena, Factory and the reduced Backrooms. Requires the corresponding Rostok Expansion mod and its resources.</description>
              <conditionFlags>
                <flag name="arena_map">wormhole</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
    <installStep name="Arena content">
      <optionalFileGroups order="Explicit">
        <group name="Included maps" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Arena + Factory + Backrooms">
              <description>All three areas. Factory is relocated near Rostok and Backrooms has revised fluorescent lighting. A NEW GAME is required for this revised navigation and all.spawn.</description>
              <conditionFlags>
                <flag name="arena_content">all</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="Arena Only">
              <description>Original Arena only. Compatible with existing saves; no new game required. Does not install map files, navigation or all.spawn. Factory and Backrooms are unavailable.</description>
              <files>
                <folder source="Profiles\Arena" destination="gamedata" priority="3" />
              </files>
              <conditionFlags>
                <flag name="arena_content">arena</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
    <installStep name="Game spawn base">
      <visible>
        <flagDependency flag="arena_content" value="all" />
      </visible>
      <optionalFileGroups order="Explicit">
        <group name="Choose the game you use" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="GAMMA">
              <description>GAMMA all.spawn with Arena, Factory and Backrooms navigation.</description>
              <files>
                <folder source="SpawnOptions\GAMMA" destination="gamedata" priority="2" />
              </files>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="Anomaly 1.5.3">
              <description>Vanilla Anomaly all.spawn with Arena, Factory and Backrooms navigation.</description>
              <files>
                <folder source="SpawnOptions\Anomaly" destination="gamedata" priority="2" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
    <installStep name="AI compatibility">
      <optionalFileGroups order="Explicit">
        <group name="REDone Combat AI" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="No REDone compatibility patch">
              <description>Default for Anomaly, standard GAMMA and other AI mods. Keeps your installed AI script.</description>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="REDone Combat AI v3.0 compatibility">
              <description>Only for an enabled REDone Combat AI v3.0 installation and its dependencies. Install Arena after REDone. ( https://www.moddb.com/members/eakman/addons )</description>
              <files>
                <folder source="Optional\REDone\gamedata" destination="gamedata" priority="10" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
    <installStep name="Optional shadow compatibility">
      <optionalFileGroups order="Explicit">
        <group name="SSS 23.5 / Atmospherics" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Keep installed shaders (default) / NOT SSS">
              <description>NOT RECOMMENDED UNLESS YOU DO NOT HAVE SSS INSTALLED</description>
              <image path="fomod\lineas.png" />
              <typeDescriptor><type name="Optional" /></typeDescriptor>
            </plugin>
            <plugin name="Shadow fix - SSS 23.5 (GAMMA default)">
              <description>better shadow on Backrooms level. (I took from Atmospherics [ https://www.moddb.com/mods/stalker-anomaly/addons/hippos-shaders-and-atmospherics ])</description>
              <files><folder source="Optional\Shadows_SSS_Atmospherics\gamedata" destination="gamedata" priority="20" /></files>
              <typeDescriptor><type name="Recommended" /></typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
  <conditionalFileInstalls>
    <patterns>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="arena_map" value="gamma" />
          <flagDependency flag="arena_content" value="all" />
        </dependencies>
        <files>
          <folder source="Maps\GAMMA\All" destination="gamedata" priority="1" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="arena_map" value="wormhole" />
          <flagDependency flag="arena_content" value="all" />
        </dependencies>
        <files>
          <folder source="Maps\Wormhole\All" destination="gamedata" priority="1" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="arena_content" value="all" />
        </dependencies>
        <files>
          <folder source="Maps\Common\All" destination="gamedata" priority="1" />
        </files>
      </pattern>
    </patterns>
  </conditionalFileInstalls>
</config>