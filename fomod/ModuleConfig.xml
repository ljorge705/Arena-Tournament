<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Arena-Tournament 1.2.3(BETA)</moduleName>
  <installSteps order="Explicit">
    <installStep name="Version">
      <optionalFileGroups order="Explicit">
        <group name="Choose your version" type="SelectExactlyOne">
          <plugins order="Explicit">
            
            <plugin name="G.A.M.MA">
              <description>Does not need a custom map (installs without the level folder).</description>
              <files>
                <folder source="GAMMA" destination="gamedata" priority="1"/>
              </files>
              <typeDescriptor><type name="Recommended"/></typeDescriptor>
            </plugin>
            
            
            <plugin name="Anomaly Vanilla / Expanded/Fixed Maps: All In One | C.B.R. Overhaul">
              <description>Needs a custom level to use night mode ( https://www.moddb.com/mods/stalker-anomaly/addons/expandedfixed-maps-all-in-one ).</description>
              <files>
                <folder source="Expanded" destination="gamedata" priority="1"/>
              </files>
              <typeDescriptor><type name="Optional"/></typeDescriptor>
            </plugin>
            
            <plugin name="[Vasgen's Cozy Spots] Bar (Rostok) Expansion | Wormhole">
              <description>Needs a custom level to use night mode ( https://www.moddb.com/mods/stalker-anomaly/addons/ens-cozvasgy-spots-barrostok-expansion-s2-anomaly-v05 ).</description>
              <files>
                <folder source="Wormhole" destination="gamedata" priority="1"/>
              </files>
              <typeDescriptor><type name="Optional"/></typeDescriptor>
            </plugin>

          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
  <requiredInstallFiles>
    <folder source="gamedata" destination="gamedata" priority="0"/>
  </requiredInstallFiles>
</config>